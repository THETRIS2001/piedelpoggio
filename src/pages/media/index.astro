---
import DefaultLayout from "../../layouts/DefaultLayout.astro";
---

<DefaultLayout
  title="GALLERIA FOTO"
  description="Galleria e caricamenti di immagini per eventi a Piedelpoggio"
>
  <main class="bg-white">
    <section class="relative overflow-hidden pt-12 md:pt-16">
      <div
        class="absolute inset-0 bg-gradient-to-b from-red-100/70 via-red-50/50 to-transparent"
      >
      </div>
      <div
        class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-96 h-96 rounded-full blur-3xl opacity-40"
        style="background: radial-gradient(circle, rgba(255, 36, 0, 0.12) 0%, rgba(255, 36, 0, 0.04) 60%, transparent 100%);"
      >
      </div>
      <div class="relative z-10 container mx-auto px-4 text-center">
        <div class="animate-fade-in">
          <div class="flex items-center justify-center mb-8">
            <div
              class="hidden md:flex w-20 h-20 rounded-xl sm:rounded-2xl items-center justify-center shadow-xl mr-6"
              style="background: linear-gradient(135deg, #FF2400, #E01E00);"
            >
              <svg
                class="w-12 h-12 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                stroke-width="1.75"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                ></path>
              </svg>
            </div>
            <h1
              class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight"
            >
              <span
                class="bg-gradient-to-r from-red-700 via-red-600 to-red-500 bg-clip-text text-transparent"
                >GALLERIA FOTO</span
              >
            </h1>
          </div>
          <div
            class="w-32 h-1.5 rounded-full mx-auto mb-8"
            style="background: linear-gradient(to right, #FF2400, #E01E00, #CC1A00);"
          >
          </div>
          <p
            class="text-lg md:text-xl lg:text-2xl text-gray-600 max-w-6xl mx-auto leading-relaxed font-medium mb-6 md:mb-16"
          >
            Immagini organizzate per evento, con ricerca e filtri
          </p>
        </div>
      </div>
    </section>
    <section class="pt-4 pb-16">
      <!-- Anchor invisibile per scroll paginazione -->
      <div
        id="eventsTop"
        tabindex="-1"
        style="scroll-margin-top: 100px; outline: none;"
      >
      </div>
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <div
            id="eventsListSection"
            class="order-2 lg:order-1 lg:col-span-2 bg-white/90 backdrop-blur-sm rounded-2xl shadow-xl border border-gray-200 p-4 md:p-6"
            style="scroll-margin-top: 100px;"
          >
            <div
              class="bg-[#E01E00] rounded-xl border border-gray-200 p-3 md:p-4 mb-6"
            >
              <!-- Filtri -->
              <div
                class="grid grid-cols-1 sm:grid-cols-5 gap-3 items-end max-w-full"
              >
                <div class="min-w-0 overflow-hidden">
                  <div class="text-xs font-semibold text-white mb-1">
                    Cerca Evento
                  </div>
                  <input
                    id="searchEvents"
                    type="text"
                    placeholder="Es. Crocetta"
                    class="w-full px-3 py-2 border border-gray-200 !rounded-xl focus:outline-none focus:ring-0 focus:border-red-500 transition-colors duration-300 appearance-none bg-white"
                  />
                </div>
                <div class="min-w-0 overflow-hidden">
                  <div class="text-xs font-semibold text-white mb-1">
                    Data Inizio
                  </div>
                  <input
                    id="dateFrom"
                    type="date"
                    class="w-full max-w-full px-3 py-2 border border-gray-200 !rounded-xl focus:outline-none focus:ring-0 focus:border-red-500 transition-colors duration-300 appearance-none bg-white"
                  />
                </div>
                <div class="min-w-0 overflow-hidden">
                  <div class="text-xs font-semibold text-white mb-1">
                    Data Fine
                  </div>
                  <input
                    id="dateTo"
                    type="date"
                    class="w-full max-w-full px-3 py-2 border border-gray-200 !rounded-xl focus:outline-none focus:ring-0 focus:border-red-500 transition-colors duration-300 appearance-none bg-white"
                  />
                </div>
                <div
                  class="flex items-end justify-start min-w-0 overflow-hidden self-end"
                >
                  <input id="sortField" type="hidden" value="date" />
                  <input id="sortOrder" type="hidden" value="desc" />
                  <div
                    id="sortSwitch"
                    class="relative w-24 h-8 rounded-full border border-white shadow-sm overflow-hidden"
                    style="background: linear-gradient(180deg, #fafafa 0%, #e9e9e9 100%); box-shadow: inset 0 2px 6px rgba(0,0,0,0.08), 0 1px 0 rgba(255,255,255,0.6);"
                  >
                    <div
                      id="sortKnob"
                      class="absolute top-0 left-0 w-12 h-8 text-white flex items-center justify-center rounded-full transition-all duration-200"
                      style="background: linear-gradient(180deg, #ff5533 0%, #c31a00 100%); box-shadow: 0 2px 6px rgba(0,0,0,0.25), inset 0 1px 0 rgba(255,255,255,0.6);"
                    >
                    </div>
                    <button
                      id="sortNameBtn"
                      type="button"
                      class="absolute inset-y-0 left-0 w-12 text-xs font-semibold leading-none text-[#E01E00] focus:outline-none"
                      >A–Z</button
                    >
                    <button
                      id="sortDateBtn"
                      type="button"
                      class="absolute inset-y-0 right-0 w-12 leading-none text-[#E01E00] focus:outline-none"
                    >
                      <svg
                        class="w-4 h-4 mx-auto"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                        ></path></svg
                      >
                    </button>
                  </div>
                  <button
                    id="sortDirBtn"
                    type="button"
                    class="ml-2 px-2 py-1 rounded-full text-xs font-semibold bg-white text-[#E01E00] border border-white focus:outline-none"
                    title="Direzione"
                  >
                    <svg
                      id="sortDirIcon"
                      class="w-4 h-4"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 9l-7 7-7-7"></path></svg
                    >
                  </button>
                </div>
                <div class="flex items-end justify-end min-w-0 overflow-hidden">
                  <button
                    id="clearFilter"
                    type="button"
                    class="px-4 py-2 !rounded-xl bg-white text-[#E01E00] border border-white hover:bg-white/90 focus:outline-none focus:ring-0"
                    >Reset</button
                  >
                </div>
              </div>
            </div>

            <!-- Barra Paginazione Superiore -->
            <div
              class="flex items-center justify-between mt-2 mb-4 bg-red-50/50 p-2 rounded-xl border border-red-100 shadow-sm transition-all duration-300"
              id="eventsPaginationBarTop"
            >
              <button
                id="pagePrevTop"
                type="button"
                class="pagination-prev inline-flex items-center justify-center px-4 py-2 rounded-lg border border-red-400 text-red-700 bg-white hover:bg-red-600 hover:text-white transition-all duration-300 disabled:opacity-30 disabled:cursor-not-allowed group shadow-sm"
                aria-label="Pagina precedente"
              >
                <svg
                  class="w-5 h-5 mr-1"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2.5"
                    d="M15 19l-7-7 7-7"></path>
                </svg>
                <span class="text-sm font-bold hidden sm:inline"
                  >Precedente</span
                >
              </button>

              <div class="pagination-info flex flex-col items-center">
                <div
                  class="page-numbers-info text-sm font-black text-red-700 bg-white px-4 py-1 rounded-full border border-red-200 shadow-inner"
                >
                  Pagina 1 di 1
                </div>
              </div>

              <button
                id="pageNextTop"
                type="button"
                class="pagination-next inline-flex items-center justify-center px-4 py-2 rounded-lg border border-red-400 text-red-700 bg-white hover:bg-red-600 hover:text-white transition-all duration-300 disabled:opacity-30 disabled:cursor-not-allowed group shadow-sm"
                aria-label="Pagina successiva"
              >
                <span class="text-sm font-bold hidden sm:inline text-right"
                  >Successiva</span
                >
                <svg
                  class="w-5 h-5 ml-1"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2.5"
                    d="M9 5l7 7-7 7"></path>
                </svg>
              </button>
            </div>

            <div
              id="eventsGrid"
              class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4 mt-2"
            >
              <!-- Skeleton Loading State -->
              <div
                class="animate-pulse rounded-xl border border-gray-200 bg-white/70 overflow-hidden h-full flex flex-col skeleton-item"
              >
                <div class="grid grid-cols-3 gap-1 p-2 bg-gray-50">
                  <div class="aspect-square rounded-lg bg-gray-200"></div>
                  <div class="aspect-square rounded-lg bg-gray-200"></div>
                  <div class="aspect-square rounded-lg bg-gray-200"></div>
                </div>
                <div class="p-3 flex flex-col flex-1 space-y-3">
                  <div class="h-5 bg-gray-200 rounded w-3/4"></div>
                  <div class="h-4 bg-gray-200 rounded w-1/3"></div>
                  <div class="h-3 bg-gray-200 rounded w-full"></div>
                  <div class="h-3 bg-gray-200 rounded w-5/6"></div>
                </div>
              </div>
              <div
                class="animate-pulse rounded-xl border border-gray-200 bg-white/70 overflow-hidden h-full flex flex-col skeleton-item hidden sm:flex"
              >
                <div class="grid grid-cols-3 gap-1 p-2 bg-gray-50">
                  <div class="aspect-square rounded-lg bg-gray-200"></div>
                  <div class="aspect-square rounded-lg bg-gray-200"></div>
                  <div class="aspect-square rounded-lg bg-gray-200"></div>
                </div>
                <div class="p-3 flex flex-col flex-1 space-y-3">
                  <div class="h-5 bg-gray-200 rounded w-3/4"></div>
                  <div class="h-4 bg-gray-200 rounded w-1/3"></div>
                  <div class="h-3 bg-gray-200 rounded w-full"></div>
                  <div class="h-3 bg-gray-200 rounded w-5/6"></div>
                </div>
              </div>
              <div
                class="animate-pulse rounded-xl border border-gray-200 bg-white/70 overflow-hidden h-full flex flex-col skeleton-item hidden xl:flex"
              >
                <div class="grid grid-cols-3 gap-1 p-2 bg-gray-50">
                  <div class="aspect-square rounded-lg bg-gray-200"></div>
                  <div class="aspect-square rounded-lg bg-gray-200"></div>
                  <div class="aspect-square rounded-lg bg-gray-200"></div>
                </div>
                <div class="p-3 flex flex-col flex-1 space-y-3">
                  <div class="h-5 bg-gray-200 rounded w-3/4"></div>
                  <div class="h-4 bg-gray-200 rounded w-1/3"></div>
                  <div class="h-3 bg-gray-200 rounded w-full"></div>
                  <div class="h-3 bg-gray-200 rounded w-5/6"></div>
                </div>
              </div>
            </div>

            <!-- Barra Paginazione Inferiore -->
            <div
              class="flex items-center justify-between mt-8 bg-red-50/50 p-2 rounded-xl border border-red-100 shadow-sm transition-all duration-300"
              id="eventsPaginationBarBottom"
            >
              <button
                id="pagePrevBottom"
                type="button"
                class="pagination-prev inline-flex items-center justify-center px-4 py-2 rounded-lg border border-red-400 text-red-700 bg-white hover:bg-red-600 hover:text-white transition-all duration-300 disabled:opacity-30 disabled:cursor-not-allowed group shadow-sm"
                aria-label="Pagina precedente"
              >
                <svg
                  class="w-5 h-5 mr-1"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2.5"
                    d="M15 19l-7-7 7-7"></path>
                </svg>
                <span class="text-sm font-bold hidden sm:inline"
                  >Precedente</span
                >
              </button>

              <div class="pagination-info flex flex-col items-center">
                <div
                  class="page-numbers-info text-sm font-black text-red-700 bg-white px-4 py-1 rounded-full border border-red-200 shadow-inner"
                >
                  Pagina 1 di 1
                </div>
              </div>

              <button
                id="pageNextBottom"
                type="button"
                class="pagination-next inline-flex items-center justify-center px-4 py-2 rounded-lg border border-red-400 text-red-700 bg-white hover:bg-red-600 hover:text-white transition-all duration-300 disabled:opacity-30 disabled:cursor-not-allowed group shadow-sm"
                aria-label="Pagina successiva"
              >
                <span class="text-sm font-bold hidden sm:inline text-right"
                  >Successiva</span
                >
                <svg
                  class="w-5 h-5 ml-1"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2.5"
                    d="M9 5l7 7-7 7"></path>
                </svg>
              </button>
            </div>
          </div>

          <div
            class="order-1 lg:order-2 bg-white/90 backdrop-blur-sm rounded-2xl shadow-xl border border-gray-200 p-4 md:p-6"
          >
            <h2 class="text-xl font-semibold text-gray-900 mb-4">
              Carica contenuti
            </h2>
            <form
              id="uploadForm"
              class="flex flex-col gap-6"
              autocomplete="off"
            >
              <!-- Sezione 1: Selezione Modalità -->
              <div class="flex items-center gap-2">
                <button
                  id="modeExisting"
                  type="button"
                  class="px-3 py-1.5 rounded-full text-sm font-medium text-white"
                  style="background: linear-gradient(135deg, #FF2400, #E01E00);"
                  >Aggiungi a evento esistente</button
                >
                <button
                  id="modeNew"
                  type="button"
                  class="px-3 py-1.5 rounded-full text-sm font-medium text-gray-700 bg-white border border-gray-300"
                  >Crea nuovo evento</button
                >
                <button
                  type="button"
                  aria-label="Info"
                  class="ml-auto flex-shrink-0 w-8 aspect-square !rounded-full border border-red-300 text-red-700 hover:bg-red-50 flex items-center justify-center focus:outline-none focus:ring-0"
                  data-info="event"
                >
                  <span class="text-sm font-bold">i</span>
                </button>
              </div>

              <hr class="border-gray-200" />

              <!-- Sezione 2: Campi Evento -->
              <div class="block">
                <div id="existingBox" class="space-y-3">
                  <label
                    for="comboInput"
                    class="block text-sm font-medium text-gray-700 mb-1"
                    >Evento esistente <span class="text-red-600">*</span></label
                  >
                  <div class="flex items-center gap-2">
                    <div class="relative flex-1">
                      <input
                        id="comboInput"
                        type="text"
                        placeholder="Seleziona evento esistente"
                        autocomplete="off"
                        autocapitalize="off"
                        spellcheck="false"
                        class="w-full px-3 py-2 border border-gray-200 !rounded-xl focus:outline-none focus:ring-0 focus:border-red-500 appearance-none"
                      />
                      <input
                        id="existingFolderHidden"
                        name="existingFolder"
                        type="hidden"
                        value=""
                      />
                      <div
                        id="comboSuggestions"
                        class="absolute left-0 right-0 mt-1 bg-white border border-gray-200 rounded-xl shadow-lg max-h-48 overflow-auto hidden z-50"
                      >
                      </div>
                    </div>
                    <button
                      id="changeExisting"
                      type="button"
                      class="hidden px-3 py-1.5 rounded-xl text-sm font-semibold text-white shadow-md hover:shadow-lg transition-all duration-300"
                      style="background: linear-gradient(135deg, #FF2400, #E01E00);"
                      >Cambia</button
                    >
                  </div>
                </div>

                <div id="newEventFields" class="hidden">
                  <div>
                    <label
                      for="eventName"
                      class="block text-sm font-medium text-gray-700 mb-1"
                      >Evento <span class="text-red-600">*</span></label
                    >
                    <input
                      name="eventName"
                      id="eventName"
                      type="text"
                      placeholder="Nome evento"
                      maxlength="60"
                      autocomplete="off"
                      autocapitalize="off"
                      spellcheck="false"
                      class="w-full px-3 py-2 border border-gray-200 rounded-xl focus:outline-none focus:ring-0 focus:border-red-500"
                      required
                    />
                    <div id="nameLimitMsg" class="text-xs text-red-600 mt-1">
                    </div>
                  </div>
                  <div
                    class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-4 max-w-full"
                  >
                    <div class="min-w-0 overflow-hidden">
                      <label
                        for="date"
                        class="block text-sm font-medium text-gray-700 mb-1"
                        >Data evento <span class="text-red-600">*</span></label
                      >
                      <input
                        name="date"
                        id="date"
                        type="date"
                        autocomplete="off"
                        class="w-full max-w-full px-3 py-2 border border-gray-200 rounded-xl focus:outline-none focus:ring-0 focus:border-red-500"
                        required
                      />
                    </div>
                  </div>
                  <div class="mt-4">
                    <label
                      for="description"
                      class="block text-sm font-medium text-gray-700 mb-1"
                      >Descrizione</label
                    >
                    <textarea
                      name="description"
                      id="description"
                      rows="3"
                      maxlength="200"
                      autocomplete="off"
                      autocapitalize="off"
                      spellcheck="false"
                      class="w-full px-3 py-2 border border-gray-200 rounded-xl focus:outline-none focus:ring-0 focus:border-red-500"
                      placeholder="Descrizione dell'evento"></textarea>
                    <div id="descLimitMsg" class="text-xs text-red-600 mt-1">
                    </div>
                  </div>
                </div>
              </div>

              <hr class="border-gray-200" />

              <!-- Sezione 3: Upload File -->
              <div class="space-y-3">
                <input
                  name="files"
                  id="files"
                  type="file"
                  multiple
                  accept="image/*,.bmp"
                  autocomplete="off"
                  class="sr-only"
                />
                <label
                  for="files"
                  class="block text-sm font-medium text-gray-700 !mt-0"
                  >File <span class="text-red-600">*</span></label
                >
                <div
                  id="dropzone"
                  class="rounded-2xl border-2 border-dashed border-gray-300 bg-white p-8 text-center hover:bg-red-50"
                >
                  <div class="flex flex-col items-center justify-center gap-3">
                    <p class="text-sm text-gray-700">
                      Trascina qui le immagini oppure <button
                        type="button"
                        id="pickFiles"
                        class="text-red-600 hover:text-red-700 underline"
                        >carica file</button
                      >
                    </p>
                    <div id="filesSummary" class="text-sm text-gray-600"></div>
                  </div>
                </div>
                <div
                  id="sizeLimitMsg"
                  class="text-xs text-gray-500 mt-2 text-center"
                >
                  Selezionati 0 B su 1GB (max)
                </div>
                <div
                  id="uploadStatus"
                  class="hidden text-sm font-medium rounded-xl border px-3 py-2"
                >
                </div>
                <div id="uploadProgress" class="hidden">
                  <div class="text-xs text-gray-700 mb-1" id="uploadNote">
                    Caricamento in corso — non chiudere la pagina
                  </div>
                  <div
                    class="w-full bg-gray-200 rounded-full h-2 overflow-hidden"
                  >
                    <div
                      id="uploadBar"
                      class="bg-red-600 h-2 rounded-full"
                      style="width:0%"
                    >
                    </div>
                  </div>
                  <div id="uploadPercent" class="text-xs text-gray-700 mt-1">
                    0%
                  </div>
                </div>
              </div>

              <button
                id="submitBtn"
                type="submit"
                class="w-full inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl text-white shadow-md disabled:opacity-50 disabled:cursor-not-allowed"
                style="background: linear-gradient(135deg, #FF2400, #E01E00);"
                disabled>Invia</button
              >
            </form>
          </div>
        </div>
      </div>
    </section>
    <div
      id="infoModal"
      class="fixed inset-0 bg-black/40 hidden items-center justify-center z-50"
    >
      <div
        class="bg-white rounded-2xl shadow-xl w-[92%] max-w-md p-5 border border-red-200"
      >
        <div class="flex items-center justify-between mb-3">
          <div id="infoTitle" class="text-base font-semibold text-gray-900">
          </div>
          <button
            id="infoClose"
            class="inline-flex items-center justify-center w-8 aspect-square rounded-full border border-red-300 text-red-700 hover:bg-red-50"
            >✕</button
          >
        </div>
        <div id="infoBody" class="text-sm text-gray-700 leading-relaxed"></div>
      </div>
    </div>
  </main>

  <script>
    interface MediaFile {
      name: string;
      url: string;
      size?: number;
    }

    interface EventMeta {
      eventName: string;
      date: string;
      description?: string;
    }

    interface EventData {
      folder: string;
      files: MediaFile[];
      meta?: EventMeta;
    }

    const PAGE_SIZE = 12;
    let currentPage = 1;
    let events: EventData[] = [];
    let externalFiles: File[] = [];
    function clientCreateSlug(text: string) {
      return (text || "")
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .replace(/[^a-z0-9\s-]/g, "")
        .trim()
        .replace(/\s+/g, "-")
        .replace(/-+/g, "-");
    }
    async function loadFilesForEvents(list: EventData[]) {
      const toLoad = list.filter((e) => !e.files || e.files.length === 0);
      const CONCURRENCY = 3;
      const queue = [...toLoad];

      const process: () => Promise<void> = async () => {
        if (queue.length === 0) return;
        const ev = queue.shift();
        if (!ev) return;

        try {
          const res = await fetch(`/api/media?folder=${ev.folder}`);
          if (res.ok) {
            const data = await res.json();
            if (data && Array.isArray(data.files)) {
              ev.files = data.files;
              updateCardImages(ev.folder, ev.files, ev.meta?.eventName || "");
            }
          }
        } catch (e) {
          console.error("Failed to load files for", ev.folder);
        }

        await process();
      };

      const workers = [];
      for (let i = 0; i < CONCURRENCY; i++) {
        workers.push(process());
      }
      await Promise.all(workers);
    }

    async function loadEvents() {
      try {
        const res = await fetch("/api/media?list=events&mode=meta");
        if (!res.ok) {
          console.error("loadEvents: response not ok", res.status);
          const grid = document.getElementById("eventsGrid");
          if (grid) {
            grid.innerHTML =
              '<div class="text-sm text-red-700 bg-red-50 border border-red-200 rounded-xl px-3 py-2">Errore nel caricamento degli eventi</div>';
          }
          events = [];
          return;
        }
        let data;
        try {
          data = await res.json();
        } catch (e) {
          console.error("loadEvents: json parse error");
          const grid = document.getElementById("eventsGrid");
          if (grid) {
            grid.innerHTML =
              '<div class="text-sm text-red-700 bg-red-50 border border-red-200 rounded-xl px-3 py-2">Dati non validi ricevuti</div>';
          }
          events = [];
          return;
        }
        events = Array.isArray(data.events) ? data.events : [];
        currentPage = 1;
        renderEvents(events);
        renderComboSuggestions("");

        loadFilesForEvents(events);
      } catch (err) {
        console.error("loadEvents: fetch failed");
        const grid = document.getElementById("eventsGrid");
        if (grid) {
          grid.innerHTML =
            '<div class="text-sm text-red-700 bg-red-50 border border-red-200 rounded-xl px-3 py-2">Impossibile contattare il server</div>';
        }
        events = [];
      }
    }
    function clamp(text: string, max: number = 60) {
      const t = String(text || "");
      return t.length > max ? t.slice(0, max) + "…" : t;
    }
    function capitalize(text: string) {
      if (!text) return text;
      return text.charAt(0).toUpperCase() + text.slice(1);
    }
    function formatDate(d: string) {
      const months = [
        "Gennaio",
        "Febbraio",
        "Marzo",
        "Aprile",
        "Maggio",
        "Giugno",
        "Luglio",
        "Agosto",
        "Settembre",
        "Ottobre",
        "Novembre",
        "Dicembre",
      ];
      const dt = new Date(d);
      return `${dt.getDate()} ${months[dt.getMonth()]} ${dt.getFullYear()}`;
    }
    function matchesFilters(ev: EventData) {
      if (!ev.meta || !ev.meta.eventName || !ev.meta.date) return false;
      const q =
        (
          document.getElementById("searchEvents") as HTMLInputElement | null
        )?.value
          ?.toLowerCase()
          .trim() || "";
      const df =
        (document.getElementById("dateFrom") as HTMLInputElement | null)
          ?.value || "";
      const dt =
        (document.getElementById("dateTo") as HTMLInputElement | null)?.value ||
        "";
      const name = String(ev.meta.eventName || "").toLowerCase();
      if (q && !name.includes(q)) return false;
      const evDate = ev.meta?.date || "";
      if (df && evDate < df) return false;
      if (dt && evDate > dt) return false;
      return true;
    }
    function buildImagesGrid(files: MediaFile[], eventName: string) {
      const container = document.createElement("div");
      container.className = "grid grid-cols-3 gap-1 p-2 bg-gray-50";

      if (!files || files.length === 0) {
        // Render 3 gray placeholder boxes
        for (let i = 0; i < 3; i++) {
          const slot = document.createElement("div");
          slot.className = "aspect-square rounded-lg bg-gray-200 animate-pulse";
          container.appendChild(slot);
        }
        return container;
      }

      const photos = files.filter((f) => !/\.(mp4|webm|ogg)$/i.test(f.name));
      const firstTen = photos.slice(0, 10);
      // Include files with size 0 or unknown in 'small' (original url) to ensure they are displayed
      const small = firstTen.filter(
        (f) => Number((f.size as number | undefined) || 0) <= 1024 * 1024,
      );
      const large = firstTen.filter(
        (f) => Number((f.size as number | undefined) || 0) > 1024 * 1024,
      );

      const selected: Array<{ file: MediaFile; transformed: boolean }> = [];

      for (const f of small) {
        if (selected.length >= 3) break;
        selected.push({ file: f, transformed: false });
      }

      if (selected.length < 3 && small.length < 3) {
        for (const f of large) {
          if (selected.length >= 3) break;
          selected.push({ file: f, transformed: true });
        }
      }

      if (selected.length === 0) {
        // If we have files but no suitable photos found (or all videos), show placeholders or icon
        // But user asked for gray space while loading.
        // If we are here, it means we have the file list but maybe no photos?
        // If photos array is empty, we should probably show a placeholder saying "No photos"
        // But let's stick to the gray box if that's what happens.
        // Actually if photos is empty, we might want to show at least one gray box or an icon.
        // For now, if no photos selected, show empty gray boxes as well.
        for (let i = 0; i < 3; i++) {
          const slot = document.createElement("div");
          slot.className = "aspect-square rounded-lg bg-gray-200";
          container.appendChild(slot);
        }
      } else {
        selected.forEach((item) => {
          const slot = document.createElement("div");
          slot.className =
            "aspect-square rounded-lg overflow-hidden bg-gray-200";

          const f = item.file;
          const img = document.createElement("img");
          img.alt = eventName || f.name;
          img.loading = "lazy";
          img.className =
            "w-full h-full object-cover transition-opacity duration-300 opacity-0"; // Start invisible for fade-in
          img.onload = () => {
            img.classList.remove("opacity-0");
          };

          const src = item.transformed ? cfLowRes(f.url) : f.url;
          img.src = src;

          img.addEventListener("error", () => {
            try {
              slot.innerHTML = "";
              slot.className = "aspect-square rounded-lg bg-gray-200";
            } catch {}
          });

          slot.appendChild(img);
          container.appendChild(slot);
        });
        // Removed filling of remaining slots with gray boxes as per user request
      }

      return container;
    }

