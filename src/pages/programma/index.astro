---
export const prerender = false;

import DefaultLayout from "../../layouts/DefaultLayout.astro";
import Lightbox from "../../components/Lightbox";
import {
  parseProgrammaPrecedente,
  sortProgrammiByYear,
  type ProgrammaPrecedente,
} from "../../utils/eventiParser";

// Legge i file dal bucket R2 a runtime
function getBucket(locals: any): any | null {
  try {
    const runtimeEnv = (locals as any)?.runtime?.env as any;
    if (runtimeEnv?.MEDIA_BUCKET) return runtimeEnv.MEDIA_BUCKET;
    const directEnv = ((locals as any)?.env ||
      (locals as any)?.cloudflare?.env) as any;
    if (directEnv?.MEDIA_BUCKET) return directEnv.MEDIA_BUCKET;
    return null;
  } catch {
    return null;
  }
}

async function listAll(bucket: any, options: any) {
  let cursor: string | undefined;
  const objects: any[] = [];
  do {
    const res = await bucket.list({ ...options, cursor });
    if (res.objects) objects.push(...res.objects);
    cursor = res.truncated ? res.cursor : undefined;
  } while (cursor);
  return { objects };
}

const bucket = getBucket(Astro.locals);
const programmiArray: ProgrammaPrecedente[] = [];

if (bucket) {
  // Load Programmi estivi
  const progPrefix = "documents/Programmi estivi/";
  const progResult = await listAll(bucket, { prefix: progPrefix });
  for (const obj of progResult.objects) {
    const filename = (obj.key as string).slice(progPrefix.length);
    if (filename && !filename.includes("/")) {
      const programma = parseProgrammaPrecedente(
        filename,
        "/documents/Programmi estivi",
      );
      if (programma) programmiArray.push(programma);
    }
  }
}

const programmiSorted = sortProgrammiByYear(programmiArray);
const currentProgram = programmiSorted.length > 0 ? programmiSorted[0] : null;
const previousPrograms = programmiSorted.length > 1 ? programmiSorted.slice(1) : [];

const currentProgramYear = currentProgram ? currentProgram.anno : 2026;
const currentProgramPath = currentProgram
  ? currentProgram.path
  : "/documents/Programmi%20estivi/Programma%20estivo%20corrente.png";
---

<DefaultLayout
  title="Programma - Piedelpoggio"
  description="Tutti gli eventi e le manifestazioni di Piedelpoggio, borgo montano nel cuore del Lazio."
>
  <main class="bg-white">
    <!-- Hero Section -->
    <section class="hero-section">
      <!-- Background with gradient -->
      <div
        class="absolute inset-0 bg-gradient-to-b from-red-100/70 via-red-50/50 to-transparent"
      >
      </div>

      <!-- Decorative elements -->

      <div
        class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-96 h-96 rounded-full blur-3xl opacity-40"
        style="background: radial-gradient(circle, rgba(255, 36, 0, 0.12) 0%, rgba(255, 36, 0, 0.04) 60%, transparent 100%);"
      >
      </div>

      <div class="relative z-10 container mx-auto px-4 text-center">
        <div class="animate-fade-in">
          <div class="flex items-center justify-center mb-8">
            <div
              class="hidden md:flex w-20 h-20 rounded-xl sm:rounded-2xl items-center justify-center shadow-xl mr-6"
              style="background: linear-gradient(135deg, #FF2400, #E01E00);"
            >
              <svg
                class="w-10 h-10 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                ></path>
              </svg>
            </div>
            <h1
              class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight"
            >
              <span
                class="bg-gradient-to-r from-red-700 via-red-600 to-red-500 bg-clip-text text-transparent"
              >
                PROGRAMMA ESTIVO
              </span>
            </h1>
          </div>
          <div
            class="w-32 h-1.5 rounded-full mx-auto mb-8"
            style="background: linear-gradient(to right, #FF2400, #E01E00, #CC1A00);"
          >
          </div>
          <p
            class="text-lg md:text-xl lg:text-2xl text-gray-600 max-w-6xl mx-auto leading-relaxed font-medium mb-6 md:mb-16"
          >
            Scopri il programma estivo
          </p>
        </div>
      </div>
    </section>

    <!-- Contenuto principale -->
    <section class="pt-4 pb-16">
      <div class="container mx-auto px-4">
        <!-- Sezione Programma Estivo -->
        <div class="max-w-6xl mx-auto mb-12">
          <div
            class="bg-white/90 backdrop-blur-sm rounded-xl sm:rounded-2xl shadow-xl border border-gray-200 p-6 md:p-12"
          >
            <!-- Layout a 2 colonne su desktop, verticale su mobile -->
            <div class="grid grid-cols-1 lg:grid-cols-[1fr_420px] gap-8">
              <!-- Colonna sinistra: Programma Corrente -->
              <div class="">
                <div class="flex items-center gap-4 mb-6">
                  <div
                    class="w-12 h-12 sm:w-16 sm:h-16 rounded-xl sm:rounded-2xl flex items-center justify-center shadow-lg"
                    style="background: linear-gradient(135deg, #FF2400, #E01E00);"
                  >
                    <svg
                      class="w-6 h-6 sm:w-8 sm:h-8 text-white"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                      ></path>
                    </svg>
                  </div>
                  <div>
                    <h2 class="text-2xl sm:text-3xl font-bold text-gray-900">
                      Programma {currentProgramYear}
                    </h2>
                  </div>
                </div>

                <div
                  class="inline-block rounded-lg overflow-hidden border border-gray-200 bg-white cursor-pointer shadow-lg hover:shadow-xl transition-shadow"
                  id="programma-container"
                >
                  <img
                    src={currentProgramPath}
                    alt={`Programma Estivo ${currentProgramYear}`}
                    class="max-h-[70vh] h-auto w-auto max-w-full rounded-lg"
                    id="programma-img"
                  />
                </div>
              </div>

              <!-- Colonna destra: Programmi Precedenti -->
              <div class="">
                <div class="flex items-center gap-4 mb-6">
                  <div
                    class="w-12 h-12 sm:w-16 sm:h-16 rounded-xl sm:rounded-2xl flex items-center justify-center shadow-lg bg-gray-100"
                  >
                    <svg
                      class="w-6 h-6 sm:w-8 sm:h-8 text-gray-600"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                      ></path>
                    </svg>
                  </div>
                  <h3 class="text-2xl sm:text-3xl font-bold text-gray-900">
                    Programmi Precedenti
                  </h3>
                </div>

                <div class="overflow-y-auto max-h-[60vh] lg:max-h-[calc(70vh-100px)] px-4 py-4 -mx-4 -my-4 space-y-4 scrollbar-hidden">
                  {
                    previousPrograms.map((programma, index) => (
                      <div class="bg-white/90 backdrop-blur-sm rounded-xl sm:rounded-2xl shadow-xl border border-gray-200 p-6 hover:shadow-2xl transition-all duration-300">
                        <div class="flex items-center space-x-4 mb-6">
                          <div class="w-12 h-12 sm:w-16 sm:h-16 bg-gradient-to-r from-red-300 to-red-400 rounded-lg flex items-center justify-center">
                            <span class="text-white font-bold text-sm md:text-lg">
                              {programma.anno}
                            </span>
                          </div>
                          <h4 class="text-xl font-bold text-gray-900">
                            Programma {programma.anno}
                          </h4>
                        </div>
                        <p class="text-gray-600 text-sm mb-6">
                          Programma completo delle attività estive dell'anno{" "}
                          {programma.anno}
                        </p>
                        <a
                          href={programma.path}
                          class="w-full bg-red-50 hover:bg-red-100 text-red-600 border border-red-100/50 py-2.5 px-4 rounded-lg transition-colors duration-300 block text-center font-medium inline-flex items-center justify-center gap-2"
                          id={`btn-programma-${programma.anno}`}
                        >
                          <svg
                            class="w-4 h-4"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
                            />
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                            />
                          </svg>
                          Visualizza
                        </a>
                      </div>
                    ))
                  }
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </section>
  </main>

  <!-- Lightbox per immagine programma -->
  <div id="programma-lightbox" class="lightbox-overlay" style="display: none;">
    <div class="lightbox-container">
      <img
        id="lightbox-img"
        src=""
        alt="Programma Estivo"
        class="lightbox-image"
      />
    </div>
  </div>
</DefaultLayout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const programmaImg = document.getElementById(
      "programma-img",
    ) as HTMLImageElement;
    const programmaContainer = document.getElementById("programma-container");
    const lightbox = document.getElementById("programma-lightbox");
    const lightboxImg = document.getElementById(
      "lightbox-img",
    ) as HTMLImageElement;

    if (programmaContainer && lightbox && lightboxImg && programmaImg) {
      const openLightbox = (imgSrc: string) => {
        lightboxImg.src = imgSrc;

        const img = new Image();
        img.onload = () => {
          const maxWidth = window.innerWidth * 0.9;
          const maxHeight = window.innerHeight * 0.9;
          const scaleWidth = maxWidth / img.naturalWidth;
          const scaleHeight = maxHeight / img.naturalHeight;
          const scale = Math.min(scaleWidth, scaleHeight);

          lightboxImg.style.width = `${img.naturalWidth * scale}px`;
          lightboxImg.style.height = `${img.naturalHeight * scale}px`;
        };
        img.src = imgSrc;

        lightbox.style.display = "flex";
        document.body.style.overflow = "hidden";
      };

      // Apri lightbox per programma principale
      programmaContainer.addEventListener("click", () =>
        openLightbox(programmaImg.src),
      );

      // Apri lightbox per tutti i programmi precedenti
      const programmaBtns = document.querySelectorAll('[id^="btn-programma-"]');
      programmaBtns.forEach((btn) => {
        btn.addEventListener("click", (e) => {
          e.preventDefault();
          const href = (btn as HTMLAnchorElement).href;
          openLightbox(href);
        });
      });

      // Chiudi lightbox al click ovunque
      lightbox.addEventListener("click", () => {
        lightbox.style.display = "none";
        document.body.style.overflow = "unset";
      });

      // Chiudi con ESC
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && lightbox.style.display === "flex") {
          lightbox.style.display = "none";
          document.body.style.overflow = "unset";
        }
      });
    }
  });
</script>

<style>
  .lightbox-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.9);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    cursor: pointer;
  }

  .lightbox-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .lightbox-image {
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
    border-radius: 8px;
  }

  /* Hide scrollbar utility for previous programs container */
  .scrollbar-hidden::-webkit-scrollbar {
    display: none; /* Safari and Chrome */
  }
  .scrollbar-hidden {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
  }
</style>
