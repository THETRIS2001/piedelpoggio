---
export const prerender = true;

import DefaultLayout from "../../layouts/DefaultLayout.astro";
import Lightbox from "../../components/Lightbox";
import {
  parseEventoFrazione,
  parseProgrammaPrecedente,
  sortEventiByDate,
  sortProgrammiByYear,
  formatDateBadge,
  type EventoFrazione,
  type ProgrammaPrecedente,
} from "../../utils/eventiParser";

// Load all files from Eventi Frazioni folder
const eventiFiles = import.meta.glob(
  "/public/documents/Eventi Frazioni/*.(jpg|jpeg|png)",
  { eager: true },
);
const eventiArray: EventoFrazione[] = [];

for (const path in eventiFiles) {
  const filename = path.split("/").pop();
  if (filename) {
    const evento = parseEventoFrazione(filename, "/documents/Eventi Frazioni");
    if (evento) {
      eventiArray.push(evento);
    }
  }
}

const eventiSorted = sortEventiByDate(eventiArray);

// Load all files from Programmi estivi folder
const programmiFiles = import.meta.glob(
  "/public/documents/Programmi estivi/*.(jpg|jpeg|png)",
  { eager: true },
);
const programmiArray: ProgrammaPrecedente[] = [];

for (const path in programmiFiles) {
  const filename = path.split("/").pop();
  if (filename) {
    const programma = parseProgrammaPrecedente(
      filename,
      "/documents/Programmi estivi",
    );
    if (programma) {
      programmiArray.push(programma);
    }
  }
}

const programmiSorted = sortProgrammiByYear(programmiArray);

// Current program file path
const PROGRAMMA_FILE =
  "/documents/Programmi%20estivi/Programma estivo corrente.png";
---

<DefaultLayout
  title="Programma - Piedelpoggio"
  description="Tutti gli eventi e le manifestazioni di Piedelpoggio, borgo montano nel cuore del Lazio."
>
  <main class="bg-white">
    <!-- Hero Section -->
    <section class="hero-section">
      <!-- Background with gradient -->
      <div
        class="absolute inset-0 bg-gradient-to-b from-red-100/70 via-red-50/50 to-transparent"
      >
      </div>

      <!-- Decorative elements -->

      <div
        class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-96 h-96 rounded-full blur-3xl opacity-40"
        style="background: radial-gradient(circle, rgba(255, 36, 0, 0.12) 0%, rgba(255, 36, 0, 0.04) 60%, transparent 100%);"
      >
      </div>

      <div class="relative z-10 container mx-auto px-4 text-center">
        <div class="animate-fade-in">
          <div class="flex items-center justify-center mb-8">
            <div
              class="hidden md:flex w-20 h-20 rounded-xl sm:rounded-2xl items-center justify-center shadow-xl mr-6"
              style="background: linear-gradient(135deg, #FF2400, #E01E00);"
            >
              <svg
                class="w-10 h-10 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                ></path>
              </svg>
            </div>
            <h1
              class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight"
            >
              <span
                class="bg-gradient-to-r from-red-700 via-red-600 to-red-500 bg-clip-text text-transparent"
              >
                PROGRAMMA ESTIVO
              </span>
            </h1>
          </div>
          <div
            class="w-32 h-1.5 rounded-full mx-auto mb-8"
            style="background: linear-gradient(to right, #FF2400, #E01E00, #CC1A00);"
          >
          </div>
          <p
            class="text-lg md:text-xl lg:text-2xl text-gray-600 max-w-6xl mx-auto leading-relaxed font-medium mb-6 md:mb-16"
          >
            Scopri il programma estivo
          </p>
        </div>
      </div>
    </section>

    <!-- Contenuto principale -->
    <section class="pt-4 pb-16">
      <div class="container mx-auto px-4">
        <!-- Sezione Programma Estivo -->
        <div class="max-w-6xl mx-auto mb-12">
          <div
            class="bg-white/90 backdrop-blur-sm rounded-xl sm:rounded-2xl shadow-xl border border-gray-200 p-6 md:p-12"
          >
            <!-- Layout a 2 colonne su desktop, verticale su mobile -->
            <div class="grid grid-cols-1 lg:grid-cols-[1fr_420px] gap-8">
              <!-- Colonna sinistra: Programma Corrente -->
              <div class="">
                <div class="flex items-center gap-4 mb-6">
                  <div
                    class="w-14 h-14 sm:w-16 sm:h-16 rounded-xl flex items-center justify-center"
                    style="background: linear-gradient(135deg, #FF2400, #E01E00);"
                  >
                    <svg
                      class="w-6 h-6 sm:w-8 sm:h-8 text-white"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                      ></path>
                    </svg>
                  </div>
                  <div>
                    <h2 class="text-2xl sm:text-3xl font-bold text-gray-900">
                      Programma 2026
                    </h2>
                  </div>
                </div>

                <div
                  class="inline-block rounded-lg overflow-hidden border border-gray-200 bg-white cursor-pointer shadow-lg hover:shadow-xl transition-shadow"
                  id="programma-container"
                >
                  <img
                    src={PROGRAMMA_FILE}
                    alt="Programma Estivo 2026"
                    class="max-h-[70vh] h-auto w-auto max-w-full rounded-lg"
                    id="programma-img"
                  />
                </div>
              </div>

              <!-- Colonna destra: Programmi Precedenti -->
              <div class="">
                <div class="flex items-center gap-4 mb-6">
                  <div
                    class="w-14 h-14 sm:w-16 sm:h-16 rounded-xl flex items-center justify-center bg-gray-100"
                  >
                    <svg
                      class="w-6 h-6 sm:w-8 sm:h-8 text-gray-600"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                  </div>
                  <h3 class="text-2xl sm:text-3xl font-bold text-gray-900">
                    Programmi Precedenti
                  </h3>
                </div>

                <div class="space-y-4">
                  {
                    programmiSorted.map((programma, index) => (
                      <div class="bg-white/90 backdrop-blur-sm rounded-xl sm:rounded-2xl shadow-xl border border-gray-200 p-6 hover:shadow-2xl transition-all duration-300">
                        <div class="flex items-center space-x-4 mb-6">
                          <div class="w-12 h-12 sm:w-16 sm:h-16 bg-gradient-to-r from-red-500 to-red-600 rounded-lg flex items-center justify-center">
                            <span class="text-white font-bold text-sm md:text-lg">
                              {programma.anno}
                            </span>
                          </div>
                          <h4 class="text-xl font-bold text-gray-900">
                            Programma {programma.anno}
                          </h4>
                        </div>
                        <p class="text-gray-600 text-sm mb-6">
                          Programma completo delle attività estive dell'anno{" "}
                          {programma.anno}
                        </p>
                        <a
                          href={programma.path}
                          class="w-full bg-red-100 hover:bg-red-200 text-red-700 py-2.5 px-4 rounded-lg transition-colors duration-300 block text-center font-medium inline-flex items-center justify-center gap-2"
                          id={`btn-programma-${programma.anno}`}
                        >
                          <svg
                            class="w-4 h-4"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
                            />
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                            />
                          </svg>
                          Visualizza
                        </a>
                      </div>
                    ))
                  }
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Eventi Frazioni Limitrofe -->
        <div class="max-w-6xl mx-auto">
          <div
            class="bg-white/90 backdrop-blur-sm rounded-xl sm:rounded-2xl shadow-xl border border-gray-200 p-6 md:p-12"
          >
            <div class="flex items-center gap-4 mb-8">
              <div
                class="w-14 h-14 sm:w-16 sm:h-16 rounded-xl flex items-center justify-center bg-gradient-to-br from-green-500 to-emerald-600"
              >
                <svg
                  class="w-6 h-6 sm:w-8 sm:h-8 text-white"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                  ></path>
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
              </div>
              <h2 class="text-2xl sm:text-3xl font-bold text-gray-900">
                Eventi Frazioni Limitrofe
              </h2>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {
                eventiSorted.map((evento) => (
                  <div
                    class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 overflow-hidden cursor-pointer eventi-frazioni-card"
                    data-img={evento.path}
                  >
                    <div class="relative h-48 overflow-hidden">
                      <img
                        src={evento.path}
                        alt={evento.nomeEvento}
                        class="w-full h-full object-cover"
                      />
                      <div class="absolute top-3 right-3 bg-red-600 text-white px-3 py-1.5 rounded-lg text-sm font-semibold shadow-lg">
                        {formatDateBadge(evento.dataString)}
                      </div>
                    </div>
                    <div class="p-4">
                      <div class="flex items-start gap-2 mb-2">
                        <svg
                          class="w-5 h-5 text-green-600 mt-0.5 flex-shrink-0"
                          fill="currentColor"
                          viewBox="0 0 20 20"
                        >
                          <path
                            fill-rule="evenodd"
                            d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"
                            clip-rule="evenodd"
                          />
                        </svg>
                        <span class="text-sm font-semibold text-gray-700">
                          {evento.luogo}
                        </span>
                      </div>
                      <h3 class="text-lg font-bold text-gray-900 mb-1">
                        {evento.nomeEvento}
                      </h3>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- Lightbox per immagine programma -->
  <div id="programma-lightbox" class="lightbox-overlay" style="display: none;">
    <div class="lightbox-container">
      <img
        id="lightbox-img"
        src=""
        alt="Programma Estivo"
        class="lightbox-image"
      />
    </div>
  </div>
</DefaultLayout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const programmaImg = document.getElementById(
      "programma-img",
    ) as HTMLImageElement;
    const programmaContainer = document.getElementById("programma-container");
    const lightbox = document.getElementById("programma-lightbox");
    const lightboxImg = document.getElementById(
      "lightbox-img",
    ) as HTMLImageElement;

    if (programmaContainer && lightbox && lightboxImg && programmaImg) {
      const openLightbox = (imgSrc: string) => {
        lightboxImg.src = imgSrc;

        const img = new Image();
        img.onload = () => {
          const maxWidth = window.innerWidth * 0.9;
          const maxHeight = window.innerHeight * 0.9;
          const scaleWidth = maxWidth / img.naturalWidth;
          const scaleHeight = maxHeight / img.naturalHeight;
          const scale = Math.min(scaleWidth, scaleHeight);

          lightboxImg.style.width = `${img.naturalWidth * scale}px`;
          lightboxImg.style.height = `${img.naturalHeight * scale}px`;
        };
        img.src = imgSrc;

        lightbox.style.display = "flex";
        document.body.style.overflow = "hidden";
      };

      // Apri lightbox per programma principale
      programmaContainer.addEventListener("click", () =>
        openLightbox(programmaImg.src),
      );

      // Apri lightbox per tutti i programmi precedenti
      const programmaBtns = document.querySelectorAll('[id^="btn-programma-"]');
      programmaBtns.forEach((btn) => {
        btn.addEventListener("click", (e) => {
          e.preventDefault();
          const href = (btn as HTMLAnchorElement).href;
          openLightbox(href);
        });
      });

      // Apri lightbox per card Eventi Frazioni
      const eventCards = document.querySelectorAll(".eventi-frazioni-card");
      eventCards.forEach((card) => {
        card.addEventListener("click", () => {
          const imgSrc = card.getAttribute("data-img");
          if (imgSrc) {
            openLightbox(imgSrc);
          }
        });
      });

      // Chiudi lightbox al click ovunque
      lightbox.addEventListener("click", () => {
        lightbox.style.display = "none";
        document.body.style.overflow = "unset";
      });

      // Chiudi con ESC
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && lightbox.style.display === "flex") {
          lightbox.style.display = "none";
          document.body.style.overflow = "unset";
        }
      });
    }
  });
</script>

<style>
  .lightbox-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.9);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    cursor: pointer;
  }

  .lightbox-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .lightbox-image {
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
    border-radius: 8px;
  }
</style>
