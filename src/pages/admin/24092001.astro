---
export const prerender = false;
import DefaultLayout from "../../layouts/DefaultLayout.astro";
---

<DefaultLayout
  title="Gestione Upload Documenti - Piedelpoggio"
  description="Pannello per il caricamento dei documenti e delle locandine su Cloudflare R2"
  noindex={true}
>
  <main class="bg-slate-100 min-h-screen py-5 px-3 sm:px-6 lg:px-8">
    <div class="w-full space-y-5">
      
      <!-- Header Banner (Full Width) -->
      <div class="bg-white rounded-xl p-4 sm:p-5 shadow-sm border border-gray-200 flex flex-wrap items-center justify-between gap-3">
        <div>
          <h1 class="text-xl sm:text-2xl font-extrabold text-gray-900">Gestione Documenti R2</h1>
          <p class="text-xs text-gray-500 mt-0.5">Carica e gestisci i file ufficiali per le sezioni del sito.</p>
        </div>
        <button
          id="refreshFilesBtn"
          type="button"
          class="inline-flex items-center gap-1.5 bg-slate-800 hover:bg-slate-900 active:scale-95 text-white text-xs font-semibold px-3.5 py-2 rounded-lg shadow transition-all"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          Aggiorna Elenco
        </button>
      </div>

      <!-- Feedback Alert -->
      <div id="statusAlert" class="hidden p-3.5 rounded-xl shadow border font-medium text-xs transition-all duration-300"></div>

      <!-- GRID SEZIONI (2 Colonne su Desktop) -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 sm:gap-6 items-start">

        <!-- ================= SEZIONE 1 (Sx) ================= -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 sm:p-5">
          <div class="flex items-center justify-between border-b border-gray-100 pb-3 mb-3">
            <div class="flex items-center space-x-2.5">
              <span class="w-7 h-7 bg-red-600 text-white rounded-lg font-bold flex items-center justify-center text-xs shadow-sm flex-shrink-0">1</span>
              <h2 class="text-base font-bold text-gray-900">Programma Estivo Attuale</h2>
            </div>
            <a href="/programma" target="_blank" class="text-xs text-blue-600 hover:underline font-medium">Vedi /programma ↗</a>
          </div>

          <p class="text-xs text-amber-800 bg-amber-50 border-l-3 border-amber-500 px-3 py-1.5 rounded-r mb-3">
            <strong>Formato:</strong> Salva come <code class="font-mono font-semibold">Programma estivo corrente.png</code> (o .jpg/.webp). Sostituisce la locandina principale.
          </p>

          <form class="upload-form space-y-3" data-section="1">
            <div>
              <input type="file" name="file" accept="image/png,image/jpeg,image/jpg,image/webp,image/*" required class="w-full text-xs text-gray-600 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-red-50 file:text-red-700 hover:file:bg-red-100 border border-gray-200 rounded-lg bg-gray-50 p-1" />
            </div>

            <div class="bg-gray-50 p-2.5 rounded-lg border border-gray-100 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 text-xs">
              <span class="text-gray-600">Nome finale: <strong class="font-mono text-red-700 font-bold break-all" id="preview-sec1">Programma estivo corrente.[ext]</strong></span>
              <button type="submit" class="w-full sm:w-auto bg-red-600 hover:bg-red-700 active:scale-95 text-white font-bold px-4 py-2 rounded-lg shadow transition-all flex-shrink-0">
                Carica
              </button>
            </div>
          </form>

          <div class="mt-4 pt-3 border-t border-gray-100">
            <h4 class="text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-2">File su R2:</h4>
            <ul id="files-sec1" class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs font-mono text-gray-700">
              <li class="italic text-gray-400 col-span-2">Caricamento...</li>
            </ul>
          </div>
        </div>

        <!-- ================= SEZIONE 2 (Dx) ================= -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 sm:p-5">
          <div class="flex items-center justify-between border-b border-gray-100 pb-3 mb-3">
            <div class="flex items-center space-x-2.5">
              <span class="w-7 h-7 bg-orange-600 text-white rounded-lg font-bold flex items-center justify-center text-xs shadow-sm flex-shrink-0">2</span>
              <h2 class="text-base font-bold text-gray-900">Programmi Estivi Precedenti</h2>
            </div>
            <a href="/programma" target="_blank" class="text-xs text-blue-600 hover:underline font-medium">Vedi /programma ↗</a>
          </div>

          <p class="text-xs text-amber-800 bg-amber-50 border-l-3 border-amber-500 px-3 py-1.5 rounded-r mb-3">
            <strong>Formato:</strong> <code class="font-mono font-semibold">Programma estivo AAAA.ext</code> (Es. <code class="font-mono">Programma estivo 2025.png</code>)
          </p>

          <form class="upload-form space-y-3" data-section="2">
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
              <div>
                <label class="block text-[11px] font-bold uppercase text-gray-600 mb-0.5">Anno</label>
                <input type="number" name="anno" min="1990" max="2050" placeholder="2025" required class="w-full px-2.5 py-1.5 border border-gray-300 rounded-lg text-xs outline-none focus:ring-1 focus:ring-orange-500" />
              </div>
              <div class="sm:col-span-2">
                <label class="block text-[11px] font-bold uppercase text-gray-600 mb-0.5">Immagine</label>
                <input type="file" name="file" accept="image/png,image/jpeg,image/jpg,image/webp,image/*" required class="w-full text-xs text-gray-600 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-orange-50 file:text-orange-700 hover:file:bg-orange-100 border border-gray-200 rounded-lg bg-gray-50 p-1" />
              </div>
            </div>

            <div class="bg-gray-50 p-2.5 rounded-lg border border-gray-100 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 text-xs">
              <span class="text-gray-600">Nome finale: <strong id="preview-sec2" class="font-mono text-orange-700 font-bold break-all">Programma estivo [Anno].[ext]</strong></span>
              <button type="submit" class="w-full sm:w-auto bg-orange-600 hover:bg-orange-700 active:scale-95 text-white font-bold px-4 py-2 rounded-lg shadow transition-all flex-shrink-0">
                Carica
              </button>
            </div>
          </form>

          <div class="mt-4 pt-3 border-t border-gray-100">
            <h4 class="text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-2">File su R2:</h4>
            <ul id="files-sec2" class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs font-mono text-gray-700">
              <li class="italic text-gray-400 col-span-2">Caricamento...</li>
            </ul>
          </div>
        </div>

        <!-- ================= SEZIONE 3 (Sx) ================= -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 sm:p-5">
          <div class="flex items-center justify-between border-b border-gray-100 pb-3 mb-3">
            <div class="flex items-center space-x-2.5">
              <span class="w-7 h-7 bg-blue-600 text-white rounded-lg font-bold flex items-center justify-center text-xs shadow-sm flex-shrink-0">3</span>
              <h2 class="text-base font-bold text-gray-900">Documenti Pro Loco</h2>
            </div>
            <a href="/info/documenti-pro-loco" target="_blank" class="text-xs text-blue-600 hover:underline font-medium">Vedi /info/documenti-pro-loco ↗</a>
          </div>

          <p class="text-xs text-amber-800 bg-amber-50 border-l-3 border-amber-500 px-3 py-1.5 rounded-r mb-3">
            <strong>Formato:</strong> <code class="font-mono font-semibold">GG-MM-AAAA - Titolo.pdf</code> (Es. <code class="font-mono">15-08-2026 - Verbale.pdf</code>)
          </p>

          <form class="upload-form space-y-3" data-section="3">
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
              <div>
                <label class="block text-[11px] font-bold uppercase text-gray-600 mb-0.5">Data</label>
                <input type="date" name="data" required class="w-full px-2.5 py-1.5 border border-gray-300 rounded-lg text-xs outline-none focus:ring-1 focus:ring-blue-500" />
              </div>
              <div class="sm:col-span-2">
                <label class="block text-[11px] font-bold uppercase text-gray-600 mb-0.5">Titolo Documento</label>
                <input type="text" name="titolo" placeholder="Es. Verbale Assemblea Soci" required class="w-full px-2.5 py-1.5 border border-gray-300 rounded-lg text-xs outline-none focus:ring-1 focus:ring-blue-500" />
              </div>
            </div>

            <div>
              <label class="block text-[11px] font-bold uppercase text-gray-600 mb-0.5">File (PDF, DOC, DOCX)</label>
              <input type="file" name="file" accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" required class="w-full text-xs text-gray-600 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 border border-gray-200 rounded-lg bg-gray-50 p-1" />
            </div>

            <div class="bg-gray-50 p-2.5 rounded-lg border border-gray-100 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 text-xs">
              <span class="text-gray-600">Nome finale: <strong id="preview-sec3" class="font-mono text-blue-700 font-bold break-all">GG-MM-AAAA - Titolo.[ext]</strong></span>
              <button type="submit" class="w-full sm:w-auto bg-blue-600 hover:bg-blue-700 active:scale-95 text-white font-bold px-4 py-2 rounded-lg shadow transition-all flex-shrink-0">
                Carica
              </button>
            </div>
          </form>

          <div class="mt-4 pt-3 border-t border-gray-100">
            <h4 class="text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-2">File su R2:</h4>
            <ul id="files-sec3" class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs font-mono text-gray-700">
              <li class="italic text-gray-400 col-span-2">Caricamento...</li>
            </ul>
          </div>
        </div>

        <!-- ================= SEZIONE 4 (Dx) ================= -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 sm:p-5">
          <div class="flex items-center justify-between border-b border-gray-100 pb-3 mb-3">
            <div class="flex items-center space-x-2.5">
              <span class="w-7 h-7 bg-emerald-600 text-white rounded-lg font-bold flex items-center justify-center text-xs shadow-sm flex-shrink-0">4</span>
              <h2 class="text-base font-bold text-gray-900">Bilanci Pro Loco</h2>
            </div>
            <a href="/info/bilancio" target="_blank" class="text-xs text-blue-600 hover:underline font-medium">Vedi /info/bilancio ↗</a>
          </div>

          <p class="text-xs text-amber-800 bg-amber-50 border-l-3 border-amber-500 px-3 py-1.5 rounded-r mb-3">
            <strong>Formato:</strong> <code class="font-mono font-semibold">Bilancio - AAAA.pdf</code> (Es. <code class="font-mono">Bilancio - 2026.pdf</code>)
          </p>

          <form class="upload-form space-y-3" data-section="4">
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
              <div>
                <label class="block text-[11px] font-bold uppercase text-gray-600 mb-0.5">Anno Bilancio</label>
                <input type="number" name="anno" min="1990" max="2050" placeholder="2026" required class="w-full px-2.5 py-1.5 border border-gray-300 rounded-lg text-xs outline-none focus:ring-1 focus:ring-emerald-500" />
              </div>
              <div class="sm:col-span-2">
                <label class="block text-[11px] font-bold uppercase text-gray-600 mb-0.5">File (PDF, PNG, JPG)</label>
                <input type="file" name="file" accept=".pdf,image/png,image/jpeg,image/jpg,image/webp,application/pdf" required class="w-full text-xs text-gray-600 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-emerald-50 file:text-emerald-700 hover:file:bg-emerald-100 border border-gray-200 rounded-lg bg-gray-50 p-1" />
              </div>
            </div>

            <div class="bg-gray-50 p-2.5 rounded-lg border border-gray-100 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 text-xs">
              <span class="text-gray-600">Nome finale: <strong id="preview-sec4" class="font-mono text-emerald-700 font-bold break-all">Bilancio - [Anno].[ext]</strong></span>
              <button type="submit" class="w-full sm:w-auto bg-emerald-600 hover:bg-emerald-700 active:scale-95 text-white font-bold px-4 py-2 rounded-lg shadow transition-all flex-shrink-0">
                Carica
              </button>
            </div>
          </form>

          <div class="mt-4 pt-3 border-t border-gray-100">
            <h4 class="text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-2">File su R2:</h4>
            <ul id="files-sec4" class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs font-mono text-gray-700">
              <li class="italic text-gray-400 col-span-2">Caricamento...</li>
            </ul>
          </div>
        </div>

        <!-- ================= SEZIONE 5 (Full width / Sx su 2-cols) ================= -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 sm:p-5 lg:col-span-2">
          <div class="flex items-center justify-between border-b border-gray-100 pb-3 mb-3">
            <div class="flex items-center space-x-2.5">
              <span class="w-7 h-7 bg-purple-600 text-white rounded-lg font-bold flex items-center justify-center text-xs shadow-sm flex-shrink-0">5</span>
              <h2 class="text-base font-bold text-gray-900">Eventi nelle Frazioni</h2>
            </div>
            <a href="/programma" target="_blank" class="text-xs text-blue-600 hover:underline font-medium">Vedi /programma ↗</a>
          </div>

          <p class="text-xs text-amber-800 bg-amber-50 border-l-3 border-amber-500 px-3 py-1.5 rounded-r mb-3">
            <strong>Formato:</strong> <code class="font-mono font-semibold">Luogo - GG-MM-AAAA - Titolo.jpg</code> (Es. <code class="font-mono">Leonessa - 07-12-2025 - Festa.jpg</code>)
          </p>

          <form class="upload-form space-y-3" data-section="5">
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
              <div>
                <label class="block text-[11px] font-bold uppercase text-gray-600 mb-0.5">Luogo</label>
                <input type="text" name="luogo" placeholder="Es. Leonessa" required class="w-full px-2.5 py-1.5 border border-gray-300 rounded-lg text-xs outline-none focus:ring-1 focus:ring-purple-500" />
              </div>
              <div>
                <label class="block text-[11px] font-bold uppercase text-gray-600 mb-0.5">Data Evento</label>
                <input type="date" name="data" required class="w-full px-2.5 py-1.5 border border-gray-300 rounded-lg text-xs outline-none focus:ring-1 focus:ring-purple-500" />
              </div>
              <div>
                <label class="block text-[11px] font-bold uppercase text-gray-600 mb-0.5">Nome Evento</label>
                <input type="text" name="titolo" placeholder="Es. Programma Natalizio" required class="w-full px-2.5 py-1.5 border border-gray-300 rounded-lg text-xs outline-none focus:ring-1 focus:ring-purple-500" />
              </div>
            </div>

            <div>
              <label class="block text-[11px] font-bold uppercase text-gray-600 mb-0.5">Immagine (PNG, JPG, WEBP)</label>
              <input type="file" name="file" accept="image/png,image/jpeg,image/jpg,image/webp,image/*" required class="w-full text-xs text-gray-600 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-purple-50 file:text-purple-700 hover:file:bg-purple-100 border border-gray-200 rounded-lg bg-gray-50 p-1" />
            </div>

            <div class="bg-gray-50 p-2.5 rounded-lg border border-gray-100 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 text-xs">
              <span class="text-gray-600">Nome finale: <strong id="preview-sec5" class="font-mono text-purple-700 font-bold break-all">Luogo - GG-MM-AAAA - Titolo.[ext]</strong></span>
              <button type="submit" class="w-full sm:w-auto bg-purple-600 hover:bg-purple-700 active:scale-95 text-white font-bold px-4 py-2 rounded-lg shadow transition-all flex-shrink-0">
                Carica
              </button>
            </div>
          </form>

          <div class="mt-4 pt-3 border-t border-gray-100">
            <h4 class="text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-2">File su R2:</h4>
            <ul id="files-sec5" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-2 text-xs font-mono text-gray-700">
              <li class="italic text-gray-400 col-span-2">Caricamento...</li>
            </ul>
          </div>
        </div>

      </div>

    </div>
  </main>
</DefaultLayout>

<script>
  function formatDateDDMMYYYY(dateStr: string): string {
    if (!dateStr) return '';
    const parts = dateStr.split('-');
    if (parts.length !== 3) return dateStr;
    return `${parts[2]}-${parts[1]}-${parts[0]}`;
  }

  function getExt(file?: File | null): string {
    if (!file) return '';
    const name = file.name || '';
    const idx = name.lastIndexOf('.');
    if (idx >= 0) return name.slice(idx).toLowerCase();
    
    if (file.type?.includes('pdf')) return '.pdf';
    if (file.type?.includes('png')) return '.png';
    if (file.type?.includes('jpeg') || file.type?.includes('jpg')) return '.jpg';
    if (file.type?.includes('webp')) return '.webp';
    return '';
  }

  function showStatus(msg: string, isError = false) {
    const box = document.getElementById('statusAlert');
    if (!box) return;
    box.innerHTML = msg.replace(/\n/g, '<br/>');
    box.className = isError
      ? 'p-3.5 rounded-xl shadow border font-medium text-xs bg-red-50 border-red-300 text-red-900 block mb-5 animate-fade-in'
      : 'p-3.5 rounded-xl shadow border font-medium text-xs bg-emerald-50 border-emerald-300 text-emerald-900 block mb-5 animate-fade-in';
    box.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  function getTargetFilename(form: HTMLFormElement, section: string): { filename: string, error?: string } {
    const fileInput = form.querySelector('input[type="file"]') as HTMLInputElement;
    const file = fileInput?.files?.[0];
    const ext = getExt(file);

    if (section === '1') {
      const extension = ext || '.png';
      const valid = ['.png', '.jpg', '.jpeg', '.webp'].includes(extension);
      return {
        filename: `Programma estivo corrente${extension}`,
        error: valid ? undefined : 'Formato non valido per immagini. Usa PNG, JPG o WEBP.'
      };
    }

    if (section === '2') {
      const annoInput = form.querySelector('input[name="anno"]') as HTMLInputElement;
      const anno = annoInput?.value?.trim() || '';
      if (anno && (!/^\d{4}$/.test(anno) || parseInt(anno) < 1990 || parseInt(anno) > 2050)) {
        return { filename: '', error: 'Inserisci un anno valido a 4 cifre (es. 2025).' };
      }
      const extension = ext || '.png';
      return {
        filename: `Programma estivo ${anno || 'AAAA'}${extension}`
      };
    }

    if (section === '3') {
      const dateInput = form.querySelector('input[name="data"]') as HTMLInputElement;
      const titleInput = form.querySelector('input[name="titolo"]') as HTMLInputElement;
      const dateStr = formatDateDDMMYYYY(dateInput?.value);
      const title = titleInput?.value?.trim() || '';
      const extension = ext || '.pdf';
      const valid = ['.pdf', '.doc', '.docx'].includes(extension);
      
      return {
        filename: `${dateStr || 'GG-MM-AAAA'} - ${title || 'Titolo'}${extension}`,
        error: valid ? undefined : 'Per i Documenti Pro Loco sono ammessi solo file PDF, DOC o DOCX.'
      };
    }

    if (section === '4') {
      const annoInput = form.querySelector('input[name="anno"]') as HTMLInputElement;
      const anno = annoInput?.value?.trim() || '';
      if (anno && (!/^\d{4}$/.test(anno) || parseInt(anno) < 1990 || parseInt(anno) > 2050)) {
        return { filename: '', error: 'Inserisci un anno valido a 4 cifre per il bilancio (es. 2026).' };
      }
      const extension = ext || '.pdf';
      return {
        filename: `Bilancio - ${anno || 'AAAA'}${extension}`
      };
    }

    if (section === '5') {
      const luogoInput = form.querySelector('input[name="luogo"]') as HTMLInputElement;
      const dateInput = form.querySelector('input[name="data"]') as HTMLInputElement;
      const titleInput = form.querySelector('input[name="titolo"]') as HTMLInputElement;
      const luogo = luogoInput?.value?.trim() || '';
      const dateStr = formatDateDDMMYYYY(dateInput?.value);
      const title = titleInput?.value?.trim() || '';
      const extension = ext || '.jpg';

      return {
        filename: `${luogo || 'Luogo'} - ${dateStr || 'GG-MM-AAAA'} - ${title || 'Titolo'}${extension}`
      };
    }

    return { filename: file ? file.name : '' };
  }

  function setupPreviews() {
    document.querySelectorAll<HTMLFormElement>('.upload-form').forEach((form) => {
      const section = form.getAttribute('data-section') || '';
      const previewSpan = document.getElementById(`preview-sec${section}`);
      
      const update = () => {
        if (previewSpan) {
          const res = getTargetFilename(form, section);
          if (res.error) {
            previewSpan.textContent = `❌ ${res.error}`;
            previewSpan.className = 'font-mono text-red-600 font-bold break-all';
          } else {
            previewSpan.textContent = res.filename;
            previewSpan.className = 'font-mono text-blue-700 font-bold break-all';
          }
        }
      };

      form.querySelectorAll('input').forEach((input) => {
        input.addEventListener('input', update);
        input.addEventListener('change', update);
      });
    });
  }

  async function loadFileList() {
    try {
      const res = await fetch('/api/admin-upload');
      if (!res.ok) return;
      const data = await res.json();

      const prefixesMap: Record<string, string> = {
        '1': 'documents/Programmi estivi/',
        '2': 'documents/Programmi estivi/',
        '3': 'documents/proloco/',
        '4': 'documents/Bilanci/',
        '5': 'documents/Eventi Frazioni/'
      };

      ['sec1', 'sec2', 'sec3', 'sec4', 'sec5'].forEach((secKey, idx) => {
        const secNum = String(idx + 1);
        const ul = document.getElementById(`files-${secKey}`);
        if (!ul) return;

        const files: string[] = data[secKey] || [];
        if (files.length === 0) {
          ul.innerHTML = '<li class="text-gray-400 italic col-span-2">Nessun file su R2</li>';
          return;
        }

        const prefix = prefixesMap[secNum];
        ul.innerHTML = files
          .map((f) => `
            <li class="flex items-center justify-between p-1.5 bg-gray-50 hover:bg-gray-100 rounded border border-gray-200 gap-1.5">
              <span class="truncate font-mono text-[11px] text-gray-700" title="${f}">${f}</span>
              <button type="button" class="delete-btn text-red-600 hover:text-red-800 text-[10px] font-bold uppercase px-1.5 py-0.5 bg-red-100 hover:bg-red-200 rounded transition-colors flex-shrink-0" data-key="${prefix}${f}">
                Elimina
              </button>
            </li>
          `)
          .join('');
      });

      document.querySelectorAll<HTMLButtonElement>('.delete-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const key = btn.getAttribute('data-key');
          if (!key || !confirm(`Eliminare definitivamente da R2 il file:\n${key}?`)) return;

          try {
            showStatus('Eliminazione in corso...');
            const delRes = await fetch(`/api/admin-upload?key=${encodeURIComponent(key)}`, {
              method: 'DELETE'
            });
            const delData = await delRes.json();
            if (delRes.ok && delData.success) {
              showStatus(`✓ File eliminato da R2: "${key}"`);
              loadFileList();
            } else {
              showStatus(`❌ Errore eliminazione: ${delData.error || 'Fallito'}`, true);
            }
          } catch (err: any) {
            showStatus(`❌ Errore: ${err.message}`, true);
          }
        });
      });
    } catch {
    }
  }

  function setupForms() {
    document.querySelectorAll<HTMLFormElement>('.upload-form').forEach((form) => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const section = form.getAttribute('data-section') || '';
        const fileInput = form.querySelector('input[type="file"]') as HTMLInputElement;
        const file = fileInput?.files?.[0];

        if (!file) {
          showStatus('Seleziona prima un file da caricare.', true);
          return;
        }

        const resCheck = getTargetFilename(form, section);
        if (resCheck.error) {
          showStatus(`⚠️ ${resCheck.error}`, true);
          return;
        }

        const targetFilename = resCheck.filename;
        const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
        const originalBtnText = submitBtn.textContent || '';
        submitBtn.disabled = true;
        submitBtn.textContent = 'Caricamento...';

        try {
          showStatus('Caricamento su Cloudflare R2...');

          const fd = new FormData();
          fd.append('section', section);
          fd.append('filename', targetFilename);
          fd.append('file', file, file.name);

          const res = await fetch('/api/admin-upload', {
            method: 'POST',
            body: fd
          });

          const data = await res.json();

          if (res.ok && data.success) {
            const sizeKB = (data.size / 1024).toFixed(1);
            showStatus(`✓ CARICATO CON SUCCESSO SU R2!\nFile: ${data.filename} (${sizeKB} KB)`);
            form.reset();
            const previewSpan = document.getElementById(`preview-sec${section}`);
            if (previewSpan) previewSpan.textContent = '';
            loadFileList();
          } else {
            showStatus(`❌ Errore caricamento: ${data.error || 'Fallito'}`, true);
          }
        } catch (err: any) {
          showStatus(`❌ Errore di rete: ${err.message}`, true);
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = originalBtnText;
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    setupPreviews();
    setupForms();
    loadFileList();

    const refreshBtn = document.getElementById('refreshFilesBtn');
    if (refreshBtn) {
      refreshBtn.addEventListener('click', () => {
        loadFileList();
        showStatus('Elenco file aggiornato.');
      });
    }
  });
</script>
