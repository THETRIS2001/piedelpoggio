---
export const prerender = false;
import DefaultLayout from "../../layouts/DefaultLayout.astro";
---

<DefaultLayout
  title="Gestione Upload Documenti - Piedelpoggio"
  description="Pannello per il caricamento dei documenti e delle locandine su Cloudflare R2"
  noindex={true}
>
  <main class="bg-slate-100 min-h-screen py-5 px-3 sm:px-6 lg:px-8">
    <div class="w-full space-y-5">
      
      <!-- Header Banner (Full Width) -->
      <div class="bg-white rounded-xl p-4 sm:p-5 shadow-sm border border-gray-200 flex flex-wrap items-center justify-between gap-3">
        <div>
          <h1 class="text-xl sm:text-2xl font-extrabold text-gray-900">Gestione Documenti R2</h1>
          <p class="text-xs text-gray-500 mt-0.5">Carica e gestisci i file ufficiali per le sezioni del sito. Supporta caricamenti multipli.</p>
        </div>
        <button
          id="refreshFilesBtn"
          type="button"
          class="inline-flex items-center gap-1.5 bg-slate-800 hover:bg-slate-900 active:scale-95 text-white text-xs font-semibold px-3.5 py-2 rounded-lg shadow transition-all"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          Aggiorna Elenco
        </button>
      </div>

      <!-- Feedback Alert -->
      <div id="statusAlert" class="hidden p-3.5 rounded-xl shadow border font-medium text-xs transition-all duration-300"></div>

      <!-- GRID SEZIONI (2 Colonne su Desktop) -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 sm:gap-6 items-start">

        <!-- ================= SEZIONE 1 (Sx) ================= -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 sm:p-5">
          <div class="flex items-center justify-between border-b border-gray-100 pb-3 mb-3">
            <div class="flex items-center space-x-2.5">
              <span class="w-7 h-7 bg-red-600 text-white rounded-lg font-bold flex items-center justify-center text-xs shadow-sm flex-shrink-0">1</span>
              <h2 class="text-base font-bold text-gray-900">Programma Estivo Attuale</h2>
            </div>
            <a href="/programma" target="_blank" class="text-xs text-blue-600 hover:underline font-medium">Vedi /programma ↗</a>
          </div>

          <p class="text-xs text-amber-800 bg-amber-50 border-l-3 border-amber-500 px-3 py-1.5 rounded-r mb-3">
            <strong>Formato:</strong> <code class="font-mono font-semibold">Programma estivo corrente.png</code>. Sostituisce la locandina in primo piano in alto su <code class="font-mono">/programma</code>.
          </p>

          <form class="upload-form space-y-3" data-section="1">
            <div>
              <input type="file" name="file" accept="image/png,image/jpeg,image/jpg,image/webp,image/*" required class="w-full text-xs text-gray-600 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-red-50 file:text-red-700 hover:file:bg-red-100 border border-gray-200 rounded-lg bg-gray-50 p-1" />
            </div>

            <div class="bg-gray-50 p-2.5 rounded-lg border border-gray-100 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 text-xs">
              <span class="text-gray-600">Nome finale: <strong class="font-mono text-red-700 font-bold break-all" id="preview-sec1">Programma estivo corrente.[ext]</strong></span>
              <button type="submit" class="w-full sm:w-auto bg-red-600 hover:bg-red-700 active:scale-95 text-white font-bold px-4 py-2 rounded-lg shadow transition-all flex-shrink-0">
                Carica
              </button>
            </div>
          </form>

          <div class="mt-4 pt-3 border-t border-gray-100">
            <h4 class="text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-2">File su R2:</h4>
            <ul id="files-sec1" class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs font-mono text-gray-700">
              <li class="italic text-gray-400 col-span-2">Caricamento...</li>
            </ul>
          </div>
        </div>

        <!-- ================= SEZIONE 2 (Dx) ================= -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 sm:p-5">
          <div class="flex items-center justify-between border-b border-gray-100 pb-3 mb-3">
            <div class="flex items-center space-x-2.5">
              <span class="w-7 h-7 bg-orange-600 text-white rounded-lg font-bold flex items-center justify-center text-xs shadow-sm flex-shrink-0">2</span>
              <h2 class="text-base font-bold text-gray-900">Programmi Estivi Precedenti</h2>
            </div>
            <a href="/programma" target="_blank" class="text-xs text-blue-600 hover:underline font-medium">Vedi /programma ↗</a>
          </div>

          <p class="text-xs text-amber-800 bg-amber-50 border-l-3 border-amber-500 px-3 py-1.5 rounded-r mb-3">
            <strong>Formato:</strong> <code class="font-mono font-semibold">Programma estivo AAAA.ext</code> (Es. <code class="font-mono">Programma estivo 2025.png</code>). Finisce nell'archivio storico di <code class="font-mono">/programma</code>.
          </p>

          <form class="upload-form space-y-3" data-section="2">
            <div>
              <label class="block text-[11px] font-bold uppercase text-gray-600 mb-0.5">Seleziona Immagini (puoi selezionarne più di una)</label>
              <input type="file" name="file" accept="image/png,image/jpeg,image/jpg,image/webp,image/*" multiple required class="w-full text-xs text-gray-600 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-orange-50 file:text-orange-700 hover:file:bg-orange-100 border border-gray-200 rounded-lg bg-gray-50 p-1" />
            </div>

            <div class="flex items-center gap-2 bg-orange-50/50 p-2 rounded-lg border border-orange-100">
              <input type="checkbox" name="useOriginal" id="useOrig-sec2" class="use-orig-checkbox w-4 h-4 text-orange-600 rounded border-gray-300 focus:ring-orange-500 cursor-pointer" />
              <label for="useOrig-sec2" class="text-xs text-gray-800 font-semibold cursor-pointer select-none">
                Usa nomi file originali (se già rinominati correttamente)
              </label>
            </div>

            <div id="fields-sec2" class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
              <div>
                <label class="block text-[11px] font-bold uppercase text-gray-600 mb-0.5">Anno</label>
                <input type="number" name="anno" min="1990" max="2050" placeholder="2025" class="w-full px-2.5 py-1.5 border border-gray-300 rounded-lg text-xs outline-none focus:ring-1 focus:ring-orange-500" />
              </div>
            </div>

            <div class="bg-gray-50 p-2.5 rounded-lg border border-gray-100 flex flex-col items-stretch justify-between gap-2 text-xs">
              <span class="text-gray-600">File da caricare: <div id="preview-sec2" class="font-mono text-orange-700 font-bold mt-1 break-all">Programma estivo [Anno].[ext]</div></span>
              <button type="submit" class="w-full bg-orange-600 hover:bg-orange-700 active:scale-95 text-white font-bold px-4 py-2 rounded-lg shadow transition-all mt-1">
                Carica
              </button>
            </div>
          </form>

          <div class="mt-4 pt-3 border-t border-gray-100">
            <h4 class="text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-2">File su R2:</h4>
            <ul id="files-sec2" class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs font-mono text-gray-700">
              <li class="italic text-gray-400 col-span-2">Caricamento...</li>
            </ul>
          </div>
        </div>

        <!-- ================= SEZIONE 3 (Sx) ================= -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 sm:p-5">
          <div class="flex items-center justify-between border-b border-gray-100 pb-3 mb-3">
            <div class="flex items-center space-x-2.5">
              <span class="w-7 h-7 bg-blue-600 text-white rounded-lg font-bold flex items-center justify-center text-xs shadow-sm flex-shrink-0">3</span>
              <h2 class="text-base font-bold text-gray-900">Documenti Pro Loco</h2>
            </div>
            <a href="/info/documenti-pro-loco" target="_blank" class="text-xs text-blue-600 hover:underline font-medium">Vedi /info/documenti-pro-loco ↗</a>
          </div>

          <p class="text-xs text-amber-800 bg-amber-50 border-l-3 border-amber-500 px-3 py-1.5 rounded-r mb-3">
            <strong>Formato:</strong> <code class="font-mono font-semibold">GG-MM-AAAA - Titolo.pdf</code>. Ordinati automaticamente dal più recente al più vecchio su <code class="font-mono">/info/documenti-pro-loco</code>.
          </p>

          <form class="upload-form space-y-3" data-section="3">
            <div>
              <label class="block text-[11px] font-bold uppercase text-gray-600 mb-0.5">Seleziona File (puoi selezionarne più di uno)</label>
              <input type="file" name="file" accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" multiple required class="w-full text-xs text-gray-600 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 border border-gray-200 rounded-lg bg-gray-50 p-1" />
            </div>

            <div class="flex items-center gap-2 bg-blue-50/50 p-2 rounded-lg border border-blue-100">
              <input type="checkbox" name="useOriginal" id="useOrig-sec3" class="use-orig-checkbox w-4 h-4 text-blue-600 rounded border-gray-300 focus:ring-blue-500 cursor-pointer" />
              <label for="useOrig-sec3" class="text-xs text-gray-800 font-semibold cursor-pointer select-none">
                Usa nomi file originali (se già rinominati correttamente)
              </label>
            </div>

            <div id="fields-sec3" class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
              <div>
                <label class="block text-[11px] font-bold uppercase text-gray-600 mb-0.5">Data</label>
                <input type="date" name="data" class="w-full px-2.5 py-1.5 border border-gray-300 rounded-lg text-xs outline-none focus:ring-1 focus:ring-blue-500" />
              </div>
              <div class="sm:col-span-2">
                <label class="block text-[11px] font-bold uppercase text-gray-600 mb-0.5">Titolo Documento</label>
                <input type="text" name="titolo" placeholder="Es. Verbale Assemblea Soci" class="w-full px-2.5 py-1.5 border border-gray-300 rounded-lg text-xs outline-none focus:ring-1 focus:ring-blue-500" />
              </div>
            </div>

            <div class="bg-gray-50 p-2.5 rounded-lg border border-gray-100 flex flex-col items-stretch justify-between gap-2 text-xs">
              <span class="text-gray-600">File da caricare: <div id="preview-sec3" class="font-mono text-blue-700 font-bold mt-1 break-all">GG-MM-AAAA - Titolo.[ext]</div></span>
              <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 active:scale-95 text-white font-bold px-4 py-2 rounded-lg shadow transition-all mt-1">
                Carica
              </button>
            </div>
          </form>

          <div class="mt-4 pt-3 border-t border-gray-100">
            <h4 class="text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-2">File su R2:</h4>
            <ul id="files-sec3" class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs font-mono text-gray-700">
              <li class="italic text-gray-400 col-span-2">Caricamento...</li>
            </ul>
          </div>
        </div>

        <!-- ================= SEZIONE 4 (Dx) ================= -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 sm:p-5">
          <div class="flex items-center justify-between border-b border-gray-100 pb-3 mb-3">
            <div class="flex items-center space-x-2.5">
              <span class="w-7 h-7 bg-emerald-600 text-white rounded-lg font-bold flex items-center justify-center text-xs shadow-sm flex-shrink-0">4</span>
              <h2 class="text-base font-bold text-gray-900">Bilanci Pro Loco</h2>
            </div>
            <a href="/info/bilancio" target="_blank" class="text-xs text-blue-600 hover:underline font-medium">Vedi /info/bilancio ↗</a>
          </div>

          <p class="text-xs text-amber-800 bg-amber-50 border-l-3 border-amber-500 px-3 py-1.5 rounded-r mb-3">
            <strong>Formato:</strong> <code class="font-mono font-semibold">Bilancio - AAAA.pdf</code>. L'anno più recente diventa in automatico il <strong>"Bilancio Corrente"</strong> in alto su <code class="font-mono">/info/bilancio</code>, mentre gli anni più vecchi scivolano in basso tra i bilanci precedenti.
          </p>

          <form class="upload-form space-y-3" data-section="4">
            <div>
              <label class="block text-[11px] font-bold uppercase text-gray-600 mb-0.5">Seleziona File (puoi selezionarne più di uno)</label>
              <input type="file" name="file" accept=".pdf,image/png,image/jpeg,image/jpg,image/webp,application/pdf" multiple required class="w-full text-xs text-gray-600 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-emerald-50 file:text-emerald-700 hover:file:bg-emerald-100 border border-gray-200 rounded-lg bg-gray-50 p-1" />
            </div>

            <div class="flex items-center gap-2 bg-emerald-50/50 p-2 rounded-lg border border-emerald-100">
              <input type="checkbox" name="useOriginal" id="useOrig-sec4" class="use-orig-checkbox w-4 h-4 text-emerald-600 rounded border-gray-300 focus:ring-emerald-500 cursor-pointer" />
              <label for="useOrig-sec4" class="text-xs text-gray-800 font-semibold cursor-pointer select-none">
                Usa nomi file originali (se già rinominati correttamente)
              </label>
            </div>

            <div id="fields-sec4" class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
              <div>
                <label class="block text-[11px] font-bold uppercase text-gray-600 mb-0.5">Anno Bilancio</label>
                <input type="number" name="anno" min="1990" max="2050" placeholder="2026" class="w-full px-2.5 py-1.5 border border-gray-300 rounded-lg text-xs outline-none focus:ring-1 focus:ring-emerald-500" />
              </div>
            </div>

            <div class="bg-gray-50 p-2.5 rounded-lg border border-gray-100 flex flex-col items-stretch justify-between gap-2 text-xs">
              <span class="text-gray-600">File da caricare: <div id="preview-sec4" class="font-mono text-emerald-700 font-bold mt-1 break-all">Bilancio - [Anno].[ext]</div></span>
              <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 active:scale-95 text-white font-bold px-4 py-2 rounded-lg shadow transition-all mt-1">
                Carica
              </button>
            </div>
          </form>

          <div class="mt-4 pt-3 border-t border-gray-100">
            <h4 class="text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-2">File su R2:</h4>
            <ul id="files-sec4" class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs font-mono text-gray-700">
              <li class="italic text-gray-400 col-span-2">Caricamento...</li>
            </ul>
          </div>
        </div>

        <!-- ================= SEZIONE 5 (Full width / Sx su 2-cols) ================= -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 sm:p-5 lg:col-span-2">
          <div class="flex items-center justify-between border-b border-gray-100 pb-3 mb-3">
            <div class="flex items-center space-x-2.5">
              <span class="w-7 h-7 bg-purple-600 text-white rounded-lg font-bold flex items-center justify-center text-xs shadow-sm flex-shrink-0">5</span>
              <h2 class="text-base font-bold text-gray-900">Eventi nelle Frazioni</h2>
            </div>
            <a href="/programma" target="_blank" class="text-xs text-blue-600 hover:underline font-medium">Vedi /programma ↗</a>
          </div>

          <p class="text-xs text-amber-800 bg-amber-50 border-l-3 border-amber-500 px-3 py-1.5 rounded-r mb-3">
            <strong>Formato:</strong> <code class="font-mono font-semibold">Luogo - GG-MM-AAAA - Titolo.jpg</code>. Mostrato automaticamente in ordine di data decrescente nella griglia eventi su <code class="font-mono">/programma</code>.
          </p>

          <form class="upload-form space-y-3" data-section="5">
            <div>
              <label class="block text-[11px] font-bold uppercase text-gray-600 mb-0.5">Seleziona Immagini (puoi selezionarne più di una)</label>
              <input type="file" name="file" accept="image/png,image/jpeg,image/jpg,image/webp,image/*" multiple required class="w-full text-xs text-gray-600 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-purple-50 file:text-purple-700 hover:file:bg-purple-100 border border-gray-200 rounded-lg bg-gray-50 p-1" />
            </div>

            <div class="flex items-center gap-2 bg-purple-50/50 p-2 rounded-lg border border-purple-100">
              <input type="checkbox" name="useOriginal" id="useOrig-sec5" class="use-orig-checkbox w-4 h-4 text-purple-600 rounded border-gray-300 focus:ring-purple-500 cursor-pointer" />
              <label for="useOrig-sec5" class="text-xs text-gray-800 font-semibold cursor-pointer select-none">
                Usa nomi file originali (se già rinominati correttamente)
              </label>
            </div>

            <div id="fields-sec5" class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
              <div>
                <label class="block text-[11px] font-bold uppercase text-gray-600 mb-0.5">Luogo</label>
                <input type="text" name="luogo" placeholder="Es. Leonessa" class="w-full px-2.5 py-1.5 border border-gray-300 rounded-lg text-xs outline-none focus:ring-1 focus:ring-purple-500" />
              </div>
              <div>
                <label class="block text-[11px] font-bold uppercase text-gray-600 mb-0.5">Data Evento</label>
                <input type="date" name="data" class="w-full px-2.5 py-1.5 border border-gray-300 rounded-lg text-xs outline-none focus:ring-1 focus:ring-purple-500" />
              </div>
              <div>
                <label class="block text-[11px] font-bold uppercase text-gray-600 mb-0.5">Nome Evento</label>
                <input type="text" name="titolo" placeholder="Es. Programma Natalizio" class="w-full px-2.5 py-1.5 border border-gray-300 rounded-lg text-xs outline-none focus:ring-1 focus:ring-purple-500" />
              </div>
            </div>

            <div class="bg-gray-50 p-2.5 rounded-lg border border-gray-100 flex flex-col items-stretch justify-between gap-2 text-xs">
              <span class="text-gray-600">File da caricare: <div id="preview-sec5" class="font-mono text-purple-700 font-bold mt-1 break-all">Luogo - GG-MM-AAAA - Titolo.[ext]</div></span>
              <button type="submit" class="w-full bg-purple-600 hover:bg-purple-700 active:scale-95 text-white font-bold px-4 py-2 rounded-lg shadow transition-all mt-1">
                Carica
              </button>
            </div>
          </form>

          <div class="mt-4 pt-3 border-t border-gray-100">
            <h4 class="text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-2">File su R2:</h4>
            <ul id="files-sec5" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-2 text-xs font-mono text-gray-700">
              <li class="italic text-gray-400 col-span-2">Caricamento...</li>
            </ul>
          </div>
        </div>

      </div>

    </div>
  </main>
</DefaultLayout>

<script>
  // Patterns Regex per rilevamento e validazione automatica dei nomi file originali
  const SECTION_PATTERNS: Record<string, { regex: RegExp, expectedFormat: string }> = {
    '2': { regex: /^Programma estivo \d{4}\.(png|jpg|jpeg|webp)$/i, expectedFormat: 'Programma estivo AAAA.ext' },
    '3': { regex: /^\d{2}-\d{2}-\d{4} - .+\.(pdf|doc|docx)$/i, expectedFormat: 'GG-MM-AAAA - Titolo.pdf' },
    '4': { regex: /^Bilancio - \d{4}\.(pdf|png|jpg|jpeg|webp)$/i, expectedFormat: 'Bilancio - AAAA.pdf' },
    '5': { regex: /^.+ - \d{2}-\d{2}-\d{4} - .+\.(png|jpg|jpeg|webp)$/i, expectedFormat: 'Luogo - GG-MM-AAAA - Titolo.jpg' }
  };

  function formatDateDDMMYYYY(dateStr: string): string {
    if (!dateStr) return '';
    const parts = dateStr.split('-');
    if (parts.length !== 3) return dateStr;
    return `${parts[2]}-${parts[1]}-${parts[0]}`;
  }

  function getExt(file?: File | null): string {
    if (!file) return '';
    const name = file.name || '';
    const idx = name.lastIndexOf('.');
    if (idx >= 0) return name.slice(idx).toLowerCase();
    
    if (file.type?.includes('pdf')) return '.pdf';
    if (file.type?.includes('png')) return '.png';
    if (file.type?.includes('jpeg') || file.type?.includes('jpg')) return '.jpg';
    if (file.type?.includes('webp')) return '.webp';
    return '';
  }

  function showStatus(msg: string, isError = false) {
    const box = document.getElementById('statusAlert');
    if (!box) return;
    box.innerHTML = msg.replace(/\n/g, '<br/>');
    box.className = isError
      ? 'p-3.5 rounded-xl shadow border font-medium text-xs bg-red-50 border-red-300 text-red-900 block mb-5 animate-fade-in'
      : 'p-3.5 rounded-xl shadow border font-medium text-xs bg-emerald-50 border-emerald-300 text-emerald-900 block mb-5 animate-fade-in';
    box.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  interface FilePlanItem {
    file: File;
    targetFilename: string;
    error?: string;
  }

  function getBatchFilePlan(form: HTMLFormElement, section: string): { plan: FilePlanItem[], hasError: boolean } {
    const fileInput = form.querySelector('input[type="file"]') as HTMLInputElement;
    const files = Array.from(fileInput?.files || []);
    const useOrigCheckbox = form.querySelector('input[name="useOriginal"]') as HTMLInputElement;
    const isUseOriginal = useOrigCheckbox?.checked;

    if (files.length === 0) {
      return { plan: [], hasError: false };
    }

    const pattern = SECTION_PATTERNS[section];
    const plan: FilePlanItem[] = [];

    files.forEach((file, index) => {
      const ext = getExt(file);
      let targetFilename = file.name;
      let error: string | undefined = undefined;

      const isMatchingPattern = pattern ? pattern.regex.test(file.name) : false;

      if (section === '1') {
        const extension = ext || '.png';
        const valid = ['.png', '.jpg', '.jpeg', '.webp'].includes(extension);
        targetFilename = `Programma estivo corrente${extension}`;
        if (!valid) error = `"${file.name}": Formato non valido per immagini. Usa PNG, JPG o WEBP.`;
      } else if (isMatchingPattern || isUseOriginal) {
        targetFilename = file.name;
        if (pattern && !pattern.regex.test(targetFilename)) {
          error = `"${file.name}" non è conforme al formato richiesto (${pattern.expectedFormat}).`;
        }
      } else {
        // Calcolo dal modulo form se non spuntato il nome originale
        if (section === '2') {
          const annoInput = form.querySelector('input[name="anno"]') as HTMLInputElement;
          const anno = annoInput?.value?.trim() || '';
          if (!anno || !/^\d{4}$/.test(anno) || parseInt(anno) < 1990 || parseInt(anno) > 2050) {
            error = 'Inserisci un anno valido a 4 cifre (es. 2025).';
          }
          const extension = ext || '.png';
          const suffix = files.length > 1 ? `_${index + 1}` : '';
          targetFilename = `Programma estivo ${anno || 'AAAA'}${suffix}${extension}`;
        } else if (section === '3') {
          const dateInput = form.querySelector('input[name="data"]') as HTMLInputElement;
          const titleInput = form.querySelector('input[name="titolo"]') as HTMLInputElement;
          const dateStr = formatDateDDMMYYYY(dateInput?.value);
          const title = titleInput?.value?.trim() || '';
          const extension = ext || '.pdf';
          const valid = ['.pdf', '.doc', '.docx'].includes(extension);

          if (!dateStr || !title) {
            error = 'Compila Data e Titolo oppure spunta "Usa nomi file originali".';
          } else if (!valid) {
            error = `"${file.name}": Ammessi solo file PDF, DOC o DOCX.`;
          }

          const suffix = files.length > 1 ? ` (${index + 1})` : '';
          targetFilename = `${dateStr || 'GG-MM-AAAA'} - ${title || 'Titolo'}${suffix}${extension}`;
        } else if (section === '4') {
          const annoInput = form.querySelector('input[name="anno"]') as HTMLInputElement;
          const anno = annoInput?.value?.trim() || '';
          if (!anno || !/^\d{4}$/.test(anno) || parseInt(anno) < 1990 || parseInt(anno) > 2050) {
            error = 'Inserisci un anno valido a 4 cifre per il bilancio (es. 2026).';
          }
          const extension = ext || '.pdf';
          const suffix = files.length > 1 ? `_${index + 1}` : '';
          targetFilename = `Bilancio - ${anno || 'AAAA'}${suffix}${extension}`;
        } else if (section === '5') {
          const luogoInput = form.querySelector('input[name="luogo"]') as HTMLInputElement;
          const dateInput = form.querySelector('input[name="data"]') as HTMLInputElement;
          const titleInput = form.querySelector('input[name="titolo"]') as HTMLInputElement;
          const luogo = luogoInput?.value?.trim() || '';
          const dateStr = formatDateDDMMYYYY(dateInput?.value);
          const title = titleInput?.value?.trim() || '';
          const extension = ext || '.jpg';

          if (!luogo || !dateStr || !title) {
            error = 'Compila Luogo, Data e Titolo oppure spunta "Usa nomi file originali".';
          }

          const suffix = files.length > 1 ? ` (${index + 1})` : '';
          targetFilename = `${luogo || 'Luogo'} - ${dateStr || 'GG-MM-AAAA'} - ${title || 'Titolo'}${suffix}${extension}`;
        }
      }

      plan.push({ file, targetFilename, error });
    });

    const hasError = plan.some(p => p.error !== undefined);
    return { plan, hasError };
  }

  function setupPreviews() {
    document.querySelectorAll<HTMLFormElement>('.upload-form').forEach((form) => {
      const section = form.getAttribute('data-section') || '';
      const previewDiv = document.getElementById(`preview-sec${section}`);
      const fileInput = form.querySelector('input[type="file"]') as HTMLInputElement;
      const useOrigCheckbox = form.querySelector('input[name="useOriginal"]') as HTMLInputElement;
      const fieldsContainer = document.getElementById(`fields-sec${section}`);

      const toggleFields = () => {
        if (fieldsContainer) {
          if (useOrigCheckbox?.checked) {
            fieldsContainer.classList.add('opacity-40', 'pointer-events-none');
            fieldsContainer.querySelectorAll('input').forEach(i => i.removeAttribute('required'));
          } else {
            fieldsContainer.classList.remove('opacity-40', 'pointer-events-none');
          }
        }
      };

      const update = () => {
        toggleFields();
        if (previewDiv) {
          const { plan, hasError } = getBatchFilePlan(form, section);
          if (plan.length === 0) {
            previewDiv.innerHTML = '<span class="text-gray-400 font-normal">Nessun file selezionato</span>';
            return;
          }

          if (plan.length === 1) {
            const item = plan[0];
            if (item.error) {
              previewDiv.innerHTML = `<span class="text-red-600">❌ ${item.error}</span>`;
            } else {
              previewDiv.innerHTML = `<span class="text-emerald-700">✓ ${item.targetFilename}</span>`;
            }
          } else {
            // Anteprima Batch per più file selezionati
            const listHtml = plan.map((item) => {
              if (item.error) {
                return `<li class="text-red-600">❌ ${item.error}</li>`;
              }
              return `<li class="text-emerald-700">✓ ${item.targetFilename}</li>`;
            }).join('');
            
            previewDiv.innerHTML = `
              <div class="text-[11px] font-semibold text-gray-700 mb-1">${plan.length} file pronti:</div>
              <ul class="space-y-0.5 font-mono text-xs max-h-32 overflow-y-auto">${listHtml}</ul>
            `;
          }
        }
      };

      // Rilevamento automatico: se TUTTI i file selezionati hanno già nomi conformi, spunta automaticamente!
      if (fileInput) {
        fileInput.addEventListener('change', () => {
          const files = Array.from(fileInput.files || []);
          if (files.length > 0 && useOrigCheckbox && SECTION_PATTERNS[section]) {
            const allMatch = files.every(f => SECTION_PATTERNS[section].regex.test(f.name));
            if (allMatch) {
              useOrigCheckbox.checked = true;
            }
          }
          update();
        });
      }

      if (useOrigCheckbox) {
        useOrigCheckbox.addEventListener('change', update);
      }

      form.querySelectorAll('input').forEach((input) => {
        input.addEventListener('input', update);
        input.addEventListener('change', update);
      });
    });
  }

  async function loadFileList() {
    try {
      const res = await fetch('/api/admin-upload');
      if (!res.ok) return;
      const data = await res.json();

      const prefixesMap: Record<string, string> = {
        '1': 'documents/Programmi estivi/',
        '2': 'documents/Programmi estivi/',
        '3': 'documents/proloco/',
        '4': 'documents/Bilanci/',
        '5': 'documents/Eventi Frazioni/'
      };

      ['sec1', 'sec2', 'sec3', 'sec4', 'sec5'].forEach((secKey, idx) => {
        const secNum = String(idx + 1);
        const ul = document.getElementById(`files-${secKey}`);
        if (!ul) return;

        const files: string[] = data[secKey] || [];
        if (files.length === 0) {
          ul.innerHTML = '<li class="text-gray-400 italic col-span-2">Nessun file su R2</li>';
          return;
        }

        const prefix = prefixesMap[secNum];
        ul.innerHTML = files
          .map((f) => {
            const fullKey = `${prefix}${f}`;
            const fileUrl = `/${fullKey.split('/').map(encodeURIComponent).join('/')}`;
            return `
              <li class="flex items-center justify-between p-1.5 bg-gray-50 hover:bg-gray-100 rounded border border-gray-200 gap-1.5">
                <span class="truncate font-mono text-[11px] text-gray-700" title="${f}">${f}</span>
                <div class="flex items-center gap-1 flex-shrink-0">
                  <a href="${fileUrl}" target="_blank" class="text-blue-600 hover:text-blue-800 text-[10px] font-bold uppercase px-1.5 py-0.5 bg-blue-50 hover:bg-blue-100 rounded transition-colors flex items-center gap-0.5">
                    Apri ↗
                  </a>
                  <button type="button" class="delete-btn text-red-600 hover:text-red-800 text-[10px] font-bold uppercase px-1.5 py-0.5 bg-red-100 hover:bg-red-200 rounded transition-colors" data-key="${fullKey}">
                    Elimina
                  </button>
                </div>
              </li>
            `;
          })
          .join('');
      });

      document.querySelectorAll<HTMLButtonElement>('.delete-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const key = btn.getAttribute('data-key');
          if (!key || !confirm(`Eliminare definitivamente da R2 il file:\n${key}?`)) return;

          try {
            showStatus('Eliminazione in corso...');
            const delRes = await fetch(`/api/admin-upload?key=${encodeURIComponent(key)}`, {
              method: 'DELETE'
            });
            const delData = await delRes.json();
            if (delRes.ok && delData.success) {
              showStatus(`✓ File eliminato da R2: "${key}"`);
              loadFileList();
            } else {
              showStatus(`❌ Errore eliminazione: ${delData.error || 'Fallito'}`, true);
            }
          } catch (err: any) {
            showStatus(`❌ Errore: ${err.message}`, true);
          }
        });
      });
    } catch {
    }
  }

  function setupForms() {
    document.querySelectorAll<HTMLFormElement>('.upload-form').forEach((form) => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const section = form.getAttribute('data-section') || '';
        const { plan, hasError } = getBatchFilePlan(form, section);

        if (plan.length === 0) {
          showStatus('Seleziona almeno un file da caricare.', true);
          return;
        }

        if (hasError) {
          const firstError = plan.find(p => p.error !== undefined)?.error;
          showStatus(`⚠️ Errore prima dell'invio:\n${firstError}`, true);
          return;
        }

        const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
        const originalBtnText = submitBtn.textContent || '';
        submitBtn.disabled = true;

        let successCount = 0;
        let failCount = 0;

        try {
          for (let i = 0; i < plan.length; i++) {
            const item = plan[i];
            submitBtn.textContent = `Caricamento ${i + 1}/${plan.length}...`;
            showStatus(`Inviando file ${i + 1} di ${plan.length}: "${item.targetFilename}"...`);

            const fd = new FormData();
            fd.append('section', section);
            fd.append('filename', item.targetFilename);
            fd.append('file', item.file, item.file.name);

            const res = await fetch('/api/admin-upload', {
              method: 'POST',
              body: fd
            });

            const data = await res.json();
            if (res.ok && data.success) {
              successCount++;
            } else {
              failCount++;
              showStatus(`❌ Errore caricamento file "${item.targetFilename}": ${data.error || 'Fallito'}`, true);
            }
          }

          if (successCount > 0 && failCount === 0) {
            showStatus(`✓ COMPLETATO CON SUCCESSO!\n${successCount} file caricati e verificati su R2.`);
            form.reset();
            const previewDiv = document.getElementById(`preview-sec${section}`);
            if (previewDiv) previewDiv.innerHTML = '<span class="text-gray-400 font-normal">Nessun file selezionato</span>';
            loadFileList();
          } else if (successCount > 0 && failCount > 0) {
            showStatus(`⚠️ CARICAMENTO PARZIALE:\n${successCount} file caricati, ${failCount} falliti.`, true);
            loadFileList();
          }
        } catch (err: any) {
          showStatus(`❌ Errore di rete: ${err.message}`, true);
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = originalBtnText;
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    setupPreviews();
    setupForms();
    loadFileList();

    const refreshBtn = document.getElementById('refreshFilesBtn');
    if (refreshBtn) {
      refreshBtn.addEventListener('click', () => {
        loadFileList();
        showStatus('Elenco file aggiornato.');
      });
    }
  });
</script>
