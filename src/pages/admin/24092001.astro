---
export const prerender = false;
import DefaultLayout from "../../layouts/DefaultLayout.astro";
---

<DefaultLayout
  title="Gestione Upload Documenti - Piedelpoggio"
  description="Pannello per il caricamento dei documenti e delle locandine su Cloudflare R2"
  noindex={true}
>
  <main class="bg-slate-100 min-h-screen py-5 px-3 sm:px-6 lg:px-8">
    <div class="w-full space-y-5">
      
      <!-- Header Banner (Full Width) -->
      <div class="bg-white rounded-xl p-4 sm:p-5 shadow-sm border border-gray-200 flex flex-wrap items-center justify-between gap-3">
        <div>
          <h1 class="text-xl sm:text-2xl font-extrabold text-gray-900">Gestione Documenti R2</h1>
          <p class="text-xs text-gray-500 mt-0.5">Carica e gestisci i file ufficiali per le sezioni del sito. Supporta caricamenti multipli con personalizzazione singola file per file.</p>
        </div>
        <button
          id="refreshFilesBtn"
          type="button"
          class="inline-flex items-center gap-1.5 bg-slate-800 hover:bg-slate-900 active:scale-95 text-white text-xs font-semibold px-3.5 py-2 rounded-lg shadow transition-all"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          Aggiorna Elenco
        </button>
      </div>

      <!-- Feedback Alert -->
      <div id="statusAlert" class="hidden p-3.5 rounded-xl shadow border font-medium text-xs transition-all duration-300"></div>

      <!-- GRID SEZIONI (2 Colonne su Desktop) -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 sm:gap-6 items-start">

        <!-- ================= SEZIONE 1 (Sx) ================= -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 sm:p-5">
          <div class="flex items-center justify-between border-b border-gray-100 pb-3 mb-3">
            <div class="flex items-center space-x-2.5">
              <span class="w-7 h-7 bg-red-600 text-white rounded-lg font-bold flex items-center justify-center text-xs shadow-sm flex-shrink-0">1</span>
              <h2 class="text-base font-bold text-gray-900">Programmi Estivi</h2>
            </div>
            <a href="/programma" target="_blank" class="text-xs text-blue-600 hover:underline font-medium">Vedi /programma ↗</a>
          </div>

          <p class="text-xs text-amber-800 bg-amber-50 border-l-3 border-amber-500 px-3 py-1.5 rounded-r mb-3">
            <strong>Formato:</strong> <code class="font-mono font-semibold">Programma estivo AAAA.ext</code> (Es. <code class="font-mono">Programma estivo 2026.png</code>). L'anno più recente diventa in automatico il <strong>Programma Estivo Attuale</strong> su <code class="font-mono">/programma</code>, mentre gli anni più vecchi scivolano nell'archivio storico.
          </p>

          <form class="upload-form space-y-3" data-section="1">
            <div>
              <label class="block text-[11px] font-bold uppercase text-gray-600 mb-0.5">Seleziona Immagini (puoi selezionarne più di una)</label>
              <input type="file" name="file" accept="image/png,image/jpeg,image/jpg,image/webp,image/*" multiple required class="w-full text-xs text-gray-600 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-red-50 file:text-red-700 hover:file:bg-red-100 border border-gray-200 rounded-lg bg-gray-50 p-1" />
            </div>

            <!-- Contenitore dinamico singoli file selezionati -->
            <div id="fileListContainer-sec1" class="space-y-3"></div>

            <div class="bg-gray-50 p-2.5 rounded-lg border border-gray-100 flex flex-col items-stretch justify-between gap-2 text-xs">
              <button type="submit" disabled class="submit-btn-sec1 w-full bg-red-600 hover:bg-red-700 text-white font-bold px-4 py-2 rounded-lg shadow transition-all opacity-50 cursor-not-allowed">
                Carica File
              </button>
            </div>
          </form>

          <div class="mt-4 pt-3 border-t border-gray-100">
            <h4 class="text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-2">File su R2:</h4>
            <ul id="files-sec1" class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs font-mono text-gray-700">
              <li class="italic text-gray-400 col-span-2">Caricamento...</li>
            </ul>
          </div>
        </div>

        <!-- ================= SEZIONE 2 (Dx) ================= -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 sm:p-5">
          <div class="flex items-center justify-between border-b border-gray-100 pb-3 mb-3">
            <div class="flex items-center space-x-2.5">
              <span class="w-7 h-7 bg-blue-600 text-white rounded-lg font-bold flex items-center justify-center text-xs shadow-sm flex-shrink-0">2</span>
              <h2 class="text-base font-bold text-gray-900">Documenti Pro Loco</h2>
            </div>
            <a href="/info/documenti-pro-loco" target="_blank" class="text-xs text-blue-600 hover:underline font-medium">Vedi /info/documenti-pro-loco ↗</a>
          </div>

          <p class="text-xs text-amber-800 bg-amber-50 border-l-3 border-amber-500 px-3 py-1.5 rounded-r mb-3">
            <strong>Formato:</strong> <code class="font-mono font-semibold">GG-MM-AAAA - Titolo.pdf</code>. Ordinati automaticamente dal più recente al più vecchio su <code class="font-mono">/info/documenti-pro-loco</code>.
          </p>

          <form class="upload-form space-y-3" data-section="2">
            <div>
              <label class="block text-[11px] font-bold uppercase text-gray-600 mb-0.5">Seleziona File (puoi selezionarne più di uno)</label>
              <input type="file" name="file" accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" multiple required class="w-full text-xs text-gray-600 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 border border-gray-200 rounded-lg bg-gray-50 p-1" />
            </div>

            <!-- Contenitore dinamico singoli file selezionati -->
            <div id="fileListContainer-sec2" class="space-y-3"></div>

            <div class="bg-gray-50 p-2.5 rounded-lg border border-gray-100 flex flex-col items-stretch justify-between gap-2 text-xs">
              <button type="submit" disabled class="submit-btn-sec2 w-full bg-blue-600 hover:bg-blue-700 text-white font-bold px-4 py-2 rounded-lg shadow transition-all opacity-50 cursor-not-allowed">
                Carica File
              </button>
            </div>
          </form>

          <div class="mt-4 pt-3 border-t border-gray-100">
            <h4 class="text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-2">File su R2:</h4>
            <ul id="files-sec2" class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs font-mono text-gray-700">
              <li class="italic text-gray-400 col-span-2">Caricamento...</li>
            </ul>
          </div>
        </div>

        <!-- ================= SEZIONE 3 (Sx) ================= -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 sm:p-5">
          <div class="flex items-center justify-between border-b border-gray-100 pb-3 mb-3">
            <div class="flex items-center space-x-2.5">
              <span class="w-7 h-7 bg-emerald-600 text-white rounded-lg font-bold flex items-center justify-center text-xs shadow-sm flex-shrink-0">3</span>
              <h2 class="text-base font-bold text-gray-900">Bilanci Pro Loco</h2>
            </div>
            <a href="/info/bilancio" target="_blank" class="text-xs text-blue-600 hover:underline font-medium">Vedi /info/bilancio ↗</a>
          </div>

          <p class="text-xs text-amber-800 bg-amber-50 border-l-3 border-amber-500 px-3 py-1.5 rounded-r mb-3">
            <strong>Formato:</strong> <code class="font-mono font-semibold">Bilancio - AAAA.pdf</code>. L'anno più recente diventa in automatico il <strong>"Bilancio Corrente"</strong> in alto su <code class="font-mono">/info/bilancio</code>, mentre gli anni più vecchi scivolano in basso tra i bilanci precedenti.
          </p>

          <form class="upload-form space-y-3" data-section="3">
            <div>
              <label class="block text-[11px] font-bold uppercase text-gray-600 mb-0.5">Seleziona File (puoi selezionarne più di uno)</label>
              <input type="file" name="file" accept=".pdf,image/png,image/jpeg,image/jpg,image/webp,application/pdf" multiple required class="w-full text-xs text-gray-600 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-emerald-50 file:text-emerald-700 hover:file:bg-emerald-100 border border-gray-200 rounded-lg bg-gray-50 p-1" />
            </div>

            <!-- Contenitore dinamico singoli file selezionati -->
            <div id="fileListContainer-sec3" class="space-y-3"></div>

            <div class="bg-gray-50 p-2.5 rounded-lg border border-gray-100 flex flex-col items-stretch justify-between gap-2 text-xs">
              <button type="submit" disabled class="submit-btn-sec3 w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-4 py-2 rounded-lg shadow transition-all opacity-50 cursor-not-allowed">
                Carica File
              </button>
            </div>
          </form>

          <div class="mt-4 pt-3 border-t border-gray-100">
            <h4 class="text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-2">File su R2:</h4>
            <ul id="files-sec3" class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs font-mono text-gray-700">
              <li class="italic text-gray-400 col-span-2">Caricamento...</li>
            </ul>
          </div>
        </div>

        <!-- ================= SEZIONE 4 (Dx) ================= -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 sm:p-5">
          <div class="flex items-center justify-between border-b border-gray-100 pb-3 mb-3">
            <div class="flex items-center space-x-2.5">
              <span class="w-7 h-7 bg-purple-600 text-white rounded-lg font-bold flex items-center justify-center text-xs shadow-sm flex-shrink-0">4</span>
              <h2 class="text-base font-bold text-gray-900">Eventi nelle Frazioni</h2>
            </div>
            <a href="/programma" target="_blank" class="text-xs text-blue-600 hover:underline font-medium">Vedi /programma ↗</a>
          </div>

          <p class="text-xs text-amber-800 bg-amber-50 border-l-3 border-amber-500 px-3 py-1.5 rounded-r mb-3">
            <strong>Formato:</strong> <code class="font-mono font-semibold">Luogo - GG-MM-AAAA - Titolo.jpg</code>. Mostrato automaticamente in ordine di data decrescente nella griglia eventi su <code class="font-mono">/programma</code>.
          </p>

          <form class="upload-form space-y-3" data-section="4">
            <div>
              <label class="block text-[11px] font-bold uppercase text-gray-600 mb-0.5">Seleziona Immagini (puoi selezionarne più di una)</label>
              <input type="file" name="file" accept="image/png,image/jpeg,image/jpg,image/webp,image/*" multiple required class="w-full text-xs text-gray-600 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-purple-50 file:text-purple-700 hover:file:bg-purple-100 border border-gray-200 rounded-lg bg-gray-50 p-1" />
            </div>

            <!-- Contenitore dinamico singoli file selezionati -->
            <div id="fileListContainer-sec4" class="space-y-3"></div>

            <div class="bg-gray-50 p-2.5 rounded-lg border border-gray-100 flex flex-col items-stretch justify-between gap-2 text-xs">
              <button type="submit" disabled class="submit-btn-sec4 w-full bg-purple-600 hover:bg-purple-700 text-white font-bold px-4 py-2 rounded-lg shadow transition-all opacity-50 cursor-not-allowed">
                Carica File
              </button>
            </div>
          </form>

          <div class="mt-4 pt-3 border-t border-gray-100">
            <h4 class="text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-2">File su R2:</h4>
            <ul id="files-sec4" class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs font-mono text-gray-700">
              <li class="italic text-gray-400 col-span-2">Caricamento...</li>
            </ul>
          </div>
        </div>

      </div>

    </div>
  </main>
</DefaultLayout>

<script>
  // Patterns Regex per le 4 sezioni dinamiche del sito
  const SECTION_PATTERNS: Record<string, { regex: RegExp, expectedFormat: string }> = {
    '1': { regex: /^Programma estivo \d{4}\.(png|jpg|jpeg|webp)$/i, expectedFormat: 'Programma estivo AAAA.ext' },
    '2': { regex: /^\d{2}-\d{2}-\d{4} - .+\.(pdf|doc|docx)$/i, expectedFormat: 'GG-MM-AAAA - Titolo.pdf' },
    '3': { regex: /^Bilancio - \d{4}\.(pdf|png|jpg|jpeg|webp)$/i, expectedFormat: 'Bilancio - AAAA.pdf' },
    '4': { regex: /^.+ - \d{2}-\d{2}-\d{4} - .+\.(png|jpg|jpeg|webp)$/i, expectedFormat: 'Luogo - GG-MM-AAAA - Titolo.jpg' }
  };

  function formatDateDDMMYYYY(dateStr: string): string {
    if (!dateStr) return '';
    const parts = dateStr.split('-');
    if (parts.length !== 3) return dateStr;
    return `${parts[2]}-${parts[1]}-${parts[0]}`;
  }

  function getExt(file?: File | null): string {
    if (!file) return '';
    const name = file.name || '';
    const idx = name.lastIndexOf('.');
    if (idx >= 0) return name.slice(idx).toLowerCase();
    
    if (file.type?.includes('pdf')) return '.pdf';
    if (file.type?.includes('png')) return '.png';
    if (file.type?.includes('jpeg') || file.type?.includes('jpg')) return '.jpg';
    if (file.type?.includes('webp')) return '.webp';
    return '';
  }

  function showStatus(msg: string, isError = false) {
    const box = document.getElementById('statusAlert');
    if (!box) return;
    box.innerHTML = msg.replace(/\n/g, '<br/>');
    box.className = isError
      ? 'p-3.5 rounded-xl shadow border font-medium text-xs bg-red-50 border-red-300 text-red-900 block mb-5 animate-fade-in'
      : 'p-3.5 rounded-xl shadow border font-medium text-xs bg-emerald-50 border-emerald-300 text-emerald-900 block mb-5 animate-fade-in';
    box.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  // Struttura dati in memoria per i file attualmente selezionati e i loro parametri individuali
  const selectedFilesMap: Record<string, { file: File, useOriginal: boolean, anno?: string, data?: string, titolo?: string, luogo?: string }[]> = {
    '1': [], '2': [], '3': [], '4': []
  };

  function renderFileListUI(section: string) {
    const container = document.getElementById(`fileListContainer-sec${section}`);
    const form = document.querySelector(`.upload-form[data-section="${section}"]`) as HTMLFormElement;
    const submitBtn = form?.querySelector('button[type="submit"]') as HTMLButtonElement;
    
    const list = selectedFilesMap[section] || [];

    if (submitBtn) {
      if (list.length === 0) {
        submitBtn.disabled = true;
        submitBtn.classList.add('opacity-50', 'cursor-not-allowed');
        submitBtn.classList.remove('active:scale-95');
      } else {
        submitBtn.disabled = false;
        submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
        submitBtn.classList.add('active:scale-95');
      }
    }

    if (!container) return;

    if (list.length === 0) {
      container.innerHTML = '';
      return;
    }

    const pattern = SECTION_PATTERNS[section];

    container.innerHTML = list.map((item, idx) => {
      const f = item.file;
      const isAutoMatching = pattern ? pattern.regex.test(f.name) : false;

      let fieldsHtml = '';
      if (!item.useOriginal) {
        if (section === '1') {
          fieldsHtml = `
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 mt-2">
              <div>
                <label class="block text-[10px] font-bold uppercase text-gray-500">Anno Programma</label>
                <input type="number" data-idx="${idx}" name="item-anno" value="${item.anno || ''}" min="1990" max="2050" placeholder="Es. 2026" class="w-full px-2 py-1 border border-gray-300 rounded text-xs outline-none" />
              </div>
            </div>
          `;
        } else if (section === '2') {
          fieldsHtml = `
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 mt-2">
              <div>
                <label class="block text-[10px] font-bold uppercase text-gray-500">Data</label>
                <input type="date" data-idx="${idx}" name="item-data" value="${item.data || ''}" class="w-full px-2 py-1 border border-gray-300 rounded text-xs outline-none" />
              </div>
              <div class="sm:col-span-2">
                <label class="block text-[10px] font-bold uppercase text-gray-500">Titolo Documento</label>
                <input type="text" data-idx="${idx}" name="item-titolo" value="${item.titolo || ''}" placeholder="Es. Verbale Assemblea" class="w-full px-2 py-1 border border-gray-300 rounded text-xs outline-none" />
              </div>
            </div>
          `;
        } else if (section === '3') {
          fieldsHtml = `
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 mt-2">
              <div>
                <label class="block text-[10px] font-bold uppercase text-gray-500">Anno Bilancio</label>
                <input type="number" data-idx="${idx}" name="item-anno" value="${item.anno || ''}" min="1990" max="2050" placeholder="Es. 2026" class="w-full px-2 py-1 border border-gray-300 rounded text-xs outline-none" />
              </div>
            </div>
          `;
        } else if (section === '4') {
          fieldsHtml = `
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 mt-2">
              <div>
                <label class="block text-[10px] font-bold uppercase text-gray-500">Luogo</label>
                <input type="text" data-idx="${idx}" name="item-luogo" value="${item.luogo || ''}" placeholder="Es. Leonessa" class="w-full px-2 py-1 border border-gray-300 rounded text-xs outline-none" />
              </div>
              <div>
                <label class="block text-[10px] font-bold uppercase text-gray-500">Data Evento</label>
                <input type="date" data-idx="${idx}" name="item-data" value="${item.data || ''}" class="w-full px-2 py-1 border border-gray-300 rounded text-xs outline-none" />
              </div>
              <div>
                <label class="block text-[10px] font-bold uppercase text-gray-500">Nome Evento</label>
                <input type="text" data-idx="${idx}" name="item-titolo" value="${item.titolo || ''}" placeholder="Es. Festa Patronale" class="w-full px-2 py-1 border border-gray-300 rounded text-xs outline-none" />
              </div>
            </div>
          `;
        }
      }

      const targetRes = calculateSingleFileTarget(section, item, idx);

      return `
        <div class="p-3 bg-slate-50 border border-slate-200 rounded-lg text-xs space-y-2">
          <div class="flex items-center justify-between border-b border-slate-200 pb-1.5">
            <span class="font-bold text-gray-800 truncate" title="${f.name}">📄 ${f.name}</span>
            <span class="text-[10px] text-gray-500 font-mono flex-shrink-0 ml-2">${(f.size / 1024).toFixed(1)} KB</span>
          </div>

          <div class="flex items-center gap-2">
            <input type="checkbox" id="item-useOrig-${section}-${idx}" data-idx="${idx}" class="item-orig-checkbox w-3.5 h-3.5 text-blue-600 rounded border-gray-300 cursor-pointer" ${item.useOriginal ? 'checked' : ''} />
            <label for="item-useOrig-${section}-${idx}" class="text-[11px] text-gray-700 font-medium cursor-pointer select-none">
              Usa nome originale ${isAutoMatching ? '<span class="text-emerald-600 font-bold">(Rilevato corretto ✓)</span>' : ''}
            </label>
          </div>

          ${fieldsHtml}

          <div class="pt-1 text-[11px]">
            Nome finale: ${targetRes.error 
              ? `<strong class="font-mono text-red-600 font-bold break-all">❌ ${targetRes.error}</strong>` 
              : `<strong class="font-mono text-blue-700 font-bold break-all">✓ ${targetRes.filename}</strong>`}
          </div>
        </div>
      `;
    }).join('');

    container.querySelectorAll<HTMLInputElement>('.item-orig-checkbox').forEach(chk => {
      chk.addEventListener('change', (e) => {
        const idx = parseInt((e.target as HTMLElement).getAttribute('data-idx') || '0');
        if (selectedFilesMap[section][idx]) {
          selectedFilesMap[section][idx].useOriginal = chk.checked;
          renderFileListUI(section);
        }
      });
    });

    container.querySelectorAll<HTMLInputElement>('input[name^="item-"]').forEach(inp => {
      const handler = () => {
        const idx = parseInt(inp.getAttribute('data-idx') || '0');
        const item = selectedFilesMap[section][idx];
        if (item) {
          const name = inp.getAttribute('name');
          if (name === 'item-anno') item.anno = inp.value;
          if (name === 'item-data') item.data = inp.value;
          if (name === 'item-titolo') item.titolo = inp.value;
          if (name === 'item-luogo') item.luogo = inp.value;

          const parentCard = inp.closest('.p-3');
          if (parentCard) {
            const targetRes = calculateSingleFileTarget(section, item, idx);
            const previewEl = parentCard.querySelector('.pt-1');
            if (previewEl) {
              previewEl.innerHTML = `Nome finale: ${targetRes.error 
                ? `<strong class="font-mono text-red-600 font-bold break-all">❌ ${targetRes.error}</strong>` 
                : `<strong class="font-mono text-blue-700 font-bold break-all">✓ ${targetRes.filename}</strong>`}`;
            }
          }
        }
      };
      inp.addEventListener('input', handler);
      inp.addEventListener('change', handler);
    });
  }

  function calculateSingleFileTarget(section: string, item: { file: File, useOriginal: boolean, anno?: string, data?: string, titolo?: string, luogo?: string }, idx: number): { filename: string, error?: string } {
    const f = item.file;
    const ext = getExt(f);
    const pattern = SECTION_PATTERNS[section];

    if (item.useOriginal) {
      if (pattern && !pattern.regex.test(f.name)) {
        return {
          filename: f.name,
          error: `Non conforme al formato richiesto (${pattern.expectedFormat})`
        };
      }
      return { filename: f.name };
    }

    if (section === '1') {
      const anno = item.anno?.trim() || '';
      if (!anno || !/^\d{4}$/.test(anno) || parseInt(anno) < 1990 || parseInt(anno) > 2050) {
        return { filename: '', error: 'Inserisci un anno valido a 4 cifre per il programma (es. 2026).' };
      }
      const extension = ext || '.png';
      return { filename: `Programma estivo ${anno}${extension}` };
    }

    if (section === '2') {
      const dateStr = formatDateDDMMYYYY(item.data?.trim() || '');
      const title = item.titolo?.trim() || '';
      const extension = ext || '.pdf';
      const valid = ['.pdf', '.doc', '.docx'].includes(extension);

      if (!dateStr || !title) {
        return { filename: '', error: 'Compila Data e Titolo del documento.' };
      }
      if (!valid) {
        return { filename: '', error: 'Formato non valido. Ammessi solo PDF, DOC o DOCX.' };
      }
      return { filename: `${dateStr} - ${title}${extension}` };
    }

    if (section === '3') {
      const anno = item.anno?.trim() || '';
      if (!anno || !/^\d{4}$/.test(anno) || parseInt(anno) < 1990 || parseInt(anno) > 2050) {
        return { filename: '', error: 'Inserisci un anno valido a 4 cifre (es. 2026).' };
      }
      const extension = ext || '.pdf';
      return { filename: `Bilancio - ${anno}${extension}` };
    }

    if (section === '4') {
      const luogo = item.luogo?.trim() || '';
      const dateStr = formatDateDDMMYYYY(item.data?.trim() || '');
      const title = item.titolo?.trim() || '';
      const extension = ext || '.jpg';

      if (!luogo || !dateStr || !title) {
        return { filename: '', error: 'Compila Luogo, Data e Titolo dell\'evento.' };
      }
      return { filename: `${luogo} - ${dateStr} - ${title}${extension}` };
    }

    return { filename: f.name };
  }

  function setupFileSelection() {
    ['1', '2', '3', '4'].forEach((section) => {
      const form = document.querySelector(`.upload-form[data-section="${section}"]`) as HTMLFormElement;
      if (!form) return;

      const fileInput = form.querySelector('input[type="file"]') as HTMLInputElement;
      if (!fileInput) return;

      fileInput.addEventListener('change', () => {
        const files = Array.from(fileInput.files || []);
        const pattern = SECTION_PATTERNS[section];

        selectedFilesMap[section] = files.map((f) => {
          const isMatchingPattern = pattern ? pattern.regex.test(f.name) : false;
          return {
            file: f,
            useOriginal: isMatchingPattern,
            anno: '',
            data: '',
            titolo: '',
            luogo: ''
          };
        });

        renderFileListUI(section);
      });
    });
  }

  async function loadFileList() {
    try {
      const res = await fetch('/api/admin-upload');
      if (!res.ok) return;
      const data = await res.json();

      const prefixesMap: Record<string, string> = {
        '1': 'documents/Programmi estivi/',
        '2': 'documents/proloco/',
        '3': 'documents/Bilanci/',
        '4': 'documents/Eventi Frazioni/'
      };

      ['sec1', 'sec2', 'sec3', 'sec4'].forEach((secKey, idx) => {
        const secNum = String(idx + 1);
        const ul = document.getElementById(`files-${secKey}`);
        if (!ul) return;

        const files: string[] = data[secKey] || [];
        if (files.length === 0) {
          ul.innerHTML = '<li class="text-gray-400 italic col-span-2">Nessun file su R2</li>';
          return;
        }

        const prefix = prefixesMap[secNum];
        ul.innerHTML = files
          .map((f) => {
            const fullKey = `${prefix}${f}`;
            const fileUrl = `/${fullKey.split('/').map(encodeURIComponent).join('/')}`;
            return `
              <li class="flex items-center justify-between p-1.5 bg-gray-50 hover:bg-gray-100 rounded border border-gray-200 gap-1.5">
                <span class="truncate font-mono text-[11px] text-gray-700" title="${f}">${f}</span>
                <div class="flex items-center gap-1 flex-shrink-0">
                  <a href="${fileUrl}" target="_blank" class="text-blue-600 hover:text-blue-800 text-[10px] font-bold uppercase px-1.5 py-0.5 bg-blue-50 hover:bg-blue-100 rounded transition-colors flex items-center gap-0.5">
                    Apri ↗
                  </a>
                  <button type="button" class="delete-btn text-red-600 hover:text-red-800 text-[10px] font-bold uppercase px-1.5 py-0.5 bg-red-100 hover:bg-red-200 rounded transition-colors" data-key="${fullKey}">
                    Elimina
                  </button>
                </div>
              </li>
            `;
          })
          .join('');
      });

      document.querySelectorAll<HTMLButtonElement>('.delete-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const key = btn.getAttribute('data-key');
          if (!key || !confirm(`Eliminare definitivamente da R2 il file:\n${key}?`)) return;

          try {
            showStatus('Eliminazione in corso...');
            const delRes = await fetch(`/api/admin-upload?key=${encodeURIComponent(key)}`, {
              method: 'DELETE'
            });
            const delData = await delRes.json();
            if (delRes.ok && delData.success) {
              showStatus(`✓ File eliminato da R2: "${key}"`);
              loadFileList();
            } else {
              showStatus(`❌ Errore eliminazione: ${delData.error || 'Fallito'}`, true);
            }
          } catch (err: any) {
            showStatus(`❌ Errore: ${err.message}`, true);
          }
        });
      });
    } catch {
    }
  }

  function setupForms() {
    document.querySelectorAll<HTMLFormElement>('.upload-form').forEach((form) => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const section = form.getAttribute('data-section') || '';
        const items = selectedFilesMap[section] || [];

        if (items.length === 0) {
          showStatus('Seleziona prima uno o più file da caricare.', true);
          return;
        }

        const plan: { file: File, targetFilename: string, error?: string }[] = [];
        for (let i = 0; i < items.length; i++) {
          const res = calculateSingleFileTarget(section, items[i], i);
          plan.push({ file: items[i].file, targetFilename: res.filename, error: res.error });
        }

        const firstErrorItem = plan.find(p => p.error);
        if (firstErrorItem) {
          showStatus(`⚠️ Impossibile procedere:\nFile "${firstErrorItem.file.name}": ${firstErrorItem.error}`, true);
          return;
        }

        const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
        const originalBtnText = submitBtn.textContent || '';
        submitBtn.disabled = true;

        let successCount = 0;
        let failCount = 0;

        try {
          for (let i = 0; i < plan.length; i++) {
            const item = plan[i];
            submitBtn.textContent = `Caricamento ${i + 1}/${plan.length}...`;
            showStatus(`Inviando file ${i + 1} di ${plan.length}: "${item.targetFilename}"...`);

            const fd = new FormData();
            fd.append('section', section);
            fd.append('filename', item.targetFilename);
            fd.append('file', item.file, item.file.name);

            const res = await fetch('/api/admin-upload', {
              method: 'POST',
              body: fd
            });

            const data = await res.json();
            if (res.ok && data.success) {
              successCount++;
            } else {
              failCount++;
              showStatus(`❌ Errore caricamento file "${item.targetFilename}": ${data.error || 'Fallito'}`, true);
            }
          }

          if (successCount > 0 && failCount === 0) {
            showStatus(`✓ CARICAMENTO COMPLETATO CON SUCCESSO!\n${successCount} file inviati e verificati su R2.`);
            form.reset();
            selectedFilesMap[section] = [];
            renderFileListUI(section);
            loadFileList();
          } else if (successCount > 0 && failCount > 0) {
            showStatus(`⚠️ CARICAMENTO PARZIALE:\n${successCount} file caricati, ${failCount} falliti.`, true);
            loadFileList();
          }
        } catch (err: any) {
          showStatus(`❌ Errore di rete: ${err.message}`, true);
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = originalBtnText;
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    setupFileSelection();
    setupForms();
    loadFileList();

    ['1', '2', '3', '4'].forEach(renderFileListUI);

    const refreshBtn = document.getElementById('refreshFilesBtn');
    if (refreshBtn) {
      refreshBtn.addEventListener('click', () => {
        loadFileList();
        showStatus('Elenco file aggiornato.');
      });
    }
  });
</script>
