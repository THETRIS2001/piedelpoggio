<script is:inline>
	function toggleContent(header) {
	  const contentWrapper = header.parentElement;
	  const body = contentWrapper.querySelector('.collapsible-body');
	  const icon = header.querySelector('.expand-icon svg');
	  
	  const isClosed = body.style.display === 'none' || body.style.display === '';
	  
	  if (isClosed) {
	    // Apertura
	    body.style.display = 'block';
	    // Reset iniziale per animazione
	    body.style.opacity = '0';
	    body.style.transform = 'translateY(-10px)';
	    
	    // Force reflow
	    void body.offsetWidth;
	    
	    // Applica transizione
	    body.style.transition = 'all 0.4s cubic-bezier(0.4, 0, 0.2, 1)';
	    icon.style.transition = 'transform 0.4s ease';
	    
	    body.style.opacity = '1';
	    body.style.transform = 'translateY(0)';
	    icon.style.transform = 'rotate(180deg)';
	  } else {
	    // Chiusura
	    body.style.opacity = '0';
	    body.style.transform = 'translateY(-10px)';
	    icon.style.transform = 'rotate(0deg)';
	    
	    setTimeout(() => {
	      body.style.display = 'none';
	    }, 400); // Attende la fine della transizione
	  }
	}
	
	// Inizializzazione allo stato chiuso
	document.addEventListener('DOMContentLoaded', function() {
	  const allBodies = document.querySelectorAll('.collapsible-body');
	  const allIcons = document.querySelectorAll('.expand-icon svg');
	  
	  allBodies.forEach(body => {
	    body.style.display = 'none';
	  });
	  
	  allIcons.forEach(icon => {
	    icon.style.transform = 'rotate(0deg)';
	  });
	});
</script>