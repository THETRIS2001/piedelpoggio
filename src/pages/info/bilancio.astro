---
export const prerender = true;

import DefaultLayout from "../../layouts/DefaultLayout.astro";
import {
  parseBilancio,
  sortBilanciByYear,
  type Bilancio,
} from "../../utils/eventiParser";

// Load all Bilancio files
const bilanciFiles = import.meta.glob(
  "/public/documents/Bilanci/*.(jpg|jpeg|png|pdf)",
  { eager: true },
);
const bilanciArray: Bilancio[] = [];

for (const path in bilanciFiles) {
  const filename = path.split("/").pop();
  if (filename) {
    const bilancio = parseBilancio(filename, "/documents/Bilanci");
    if (bilancio) {
      bilanciArray.push(bilancio);
    }
  }
}

const bilanciSorted = sortBilanciByYear(bilanciArray);
const currentBudget = bilanciSorted.length > 0 ? bilanciSorted[0] : null;
const previousBudgets = bilanciSorted.length > 1 ? bilanciSorted.slice(1) : [];

// Fallback if no files found (though user has 2014 and 2024)
const safeCurrentYear = currentBudget ? currentBudget.anno : 2024;
const safeCurrentPath = currentBudget ? currentBudget.path : "";
