---
export const prerender = false;

import DefaultLayout from "../../layouts/DefaultLayout.astro";
import {
  parseBilancio,
  sortBilanciByYear,
  type Bilancio,
} from "../../utils/eventiParser";

// Legge i file Bilanci dal bucket R2 a runtime
function getBucket(locals: any): any | null {
  try {
    const runtimeEnv = (locals as any)?.runtime?.env as any;
    if (runtimeEnv?.MEDIA_BUCKET) return runtimeEnv.MEDIA_BUCKET;
    const directEnv = ((locals as any)?.env ||
      (locals as any)?.cloudflare?.env) as any;
    if (directEnv?.MEDIA_BUCKET) return directEnv.MEDIA_BUCKET;
    return null;
  } catch {
    return null;
  }
}

async function listAll(bucket: any, options: any) {
  let cursor: string | undefined;
  const objects: any[] = [];
  do {
    const res = await bucket.list({ ...options, cursor });
    if (res.objects) objects.push(...res.objects);
    cursor = res.truncated ? res.cursor : undefined;
  } while (cursor);
  return { objects };
}

const bucket = getBucket(Astro.locals);
const bilanciArray: Bilancio[] = [];

if (bucket) {
  let cursor: string | undefined;
  const allObjects: any[] = [];
  do {
    const res = await bucket.list({ prefix: "documents/", cursor });
    if (res.objects) allObjects.push(...res.objects);
    cursor = res.truncated ? res.cursor : undefined;
  } while (cursor);

  for (const obj of allObjects) {
    const key = obj.key as string;
    if (key.toLowerCase().includes("documents/bilanci/")) {
      const idx = key.toLowerCase().indexOf("documents/bilanci/");
      const filename = key.slice(idx + "documents/bilanci/".length);
      if (filename && !filename.includes("/")) {
        const bilancio = parseBilancio(filename, "/documents/Bilanci");
        if (bilancio) bilanciArray.push(bilancio);
      }
    }
  }
}

const bilanciSorted = sortBilanciByYear(bilanciArray);
const currentBudget = bilanciSorted.length > 0 ? bilanciSorted[0] : null;
const previousBudgets = bilanciSorted.length > 1 ? bilanciSorted.slice(1) : [];

// Fallback if no files found
const safeCurrentYear = currentBudget ? currentBudget.anno : 2024;
const safeCurrentPath = currentBudget ? currentBudget.path : "";
