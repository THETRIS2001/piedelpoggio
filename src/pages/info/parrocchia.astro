          <!-- Documenti Principali -->
          <div class="mb-12">
            <h3 class="text-xl sm:text-2xl font-bold text-gray-900 mb-6">
              Documenti Principali
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              <a
                href="/documents/parrocchia/21-06-2012 - Programmazione campane.doc"
                class="block bg-gradient-to-br from-teal-50 to-teal-100 rounded-xl p-6 shadow-md hover:shadow-lg transition-all duration-300 group border border-gray-200"
