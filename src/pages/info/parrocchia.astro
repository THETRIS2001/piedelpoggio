---
import DefaultLayout from "../../layouts/DefaultLayout.astro";
---

<DefaultLayout
  title="Parrocchia S.M. Cerreto - Piedelpoggio"
  description="Scopri la storia e le attività della Parrocchia di Santa Maria del Cerreto di Piedelpoggio, custode della fede e delle tradizioni religiose del territorio"
>
  <main class="bg-white">
    <!-- Hero Section -->
    <section class="hero-section">
      <!-- Background with gradient -->
      <div
        class="absolute inset-0 bg-gradient-to-b from-blue-100/70 via-blue-50/50 to-transparent"
      >
      </div>

      <!-- Decorative elements -->

      <div class="relative z-10 container mx-auto px-4 text-center">
        <div class="animate-fade-in">
          <div class="flex items-center justify-center mb-8">
            <div
              class="hidden md:flex w-20 h-20 bg-gradient-to-br from-blue-600 to-indigo-600 rounded-xl sm:rounded-2xl items-center justify-center shadow-xl mr-6"
            >
              <svg
                class="w-10 h-10 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                ></path>
              </svg>
            </div>
            <h1
              class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight"
            >
              <span
                class="bg-gradient-to-r from-blue-900 via-blue-700 to-indigo-600 bg-clip-text text-transparent"
              >
                PARROCCHIA S.M. CERRETO
              </span>
            </h1>
          </div>
          <div
            class="w-32 h-1.5 bg-gradient-to-r from-blue-500 via-blue-600 to-indigo-500 rounded-full mx-auto mb-8"
          >
          </div>
          <p
            class="text-lg md:text-xl lg:text-2xl text-gray-600 max-w-6xl mx-auto leading-relaxed font-medium mb-6 md:mb-16"
          >
            Centro spirituale e sociale della nostra comunità
          </p>
        </div>
      </div>
    </section>

    <!-- Informazioni Generali -->
    <section class="pt-4 pb-16 px-4 sm:px-6 lg:px-8">
      <div class="max-w-6xl mx-auto">
        <div
          class="bg-white/90 backdrop-blur-sm rounded-xl sm:rounded-2xl shadow-xl border border-gray-200 p-6 md:p-12 mb-16"
        >
          <div class="flex items-center space-x-4 mb-8">
            <div
              class="w-12 h-12 sm:w-16 sm:h-16 bg-gradient-to-r from-blue-600 to-blue-700 rounded-xl flex items-center justify-center"
            >
              <svg
                class="w-6 h-6 sm:w-8 sm:h-8 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                ></path>
              </svg>
            </div>
            <h2 class="text-1xl sm:text-3xl font-bold text-gray-900">
              Informazioni Generali
            </h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            <!-- Costituzione Canonica -->
            <div
              class="bg-gradient-to-br from-blue-50 to-blue-100 rounded-xl p-6 text-center shadow-md border border-gray-200"
            >
              <div
                class="w-12 h-12 bg-blue-600 rounded-full flex items-center justify-center mx-auto mb-4"
              >
                <svg
                  class="w-6 h-6 sm:w-8 sm:h-8 text-white"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <h3 class="text-lg font-bold text-gray-900 mb-2">
                Costituzione Canonica
              </h3>
              <p class="text-1xl sm:text-3xl font-bold text-blue-600 mb-1">
                1° settembre
              </p>
              <p class="text-lg md:text-xl font-semibold text-gray-600">1986</p>
            </div>

            <!-- Riconoscimento Civile -->
            <div
              class="bg-gradient-to-br from-green-50 to-green-100 rounded-xl p-6 text-center shadow-md border border-gray-200"
            >
              <div
                class="w-12 h-12 bg-green-600 rounded-full flex items-center justify-center mx-auto mb-4"
              >
                <svg
                  class="w-6 h-6 sm:w-8 sm:h-8 text-white"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                  ></path>
                </svg>
              </div>
              <h3 class="text-lg font-bold text-gray-900 mb-2">
                Riconoscimento Civile
              </h3>
              <p class="text-1xl sm:text-3xl font-bold text-green-600 mb-1">
                7 ottobre
              </p>
              <p class="text-lg md:text-xl font-semibold text-gray-600">1986</p>
            </div>

            <!-- Registrazione -->
            <div
              class="bg-gradient-to-br from-purple-50 to-purple-100 rounded-xl p-6 text-center shadow-md border border-gray-200"
            >
              <div
                class="w-12 h-12 bg-purple-600 rounded-full flex items-center justify-center mx-auto mb-4"
              >
                <svg
                  class="w-6 h-6 sm:w-8 sm:h-8 text-white"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                  ></path>
                </svg>
              </div>
              <h3 class="text-lg font-bold text-gray-900 mb-2">
                Registrazione
              </h3>
              <p class="text-1xl sm:text-3xl font-bold text-purple-600 mb-1">
                15 ottobre
              </p>
              <p class="text-lg md:text-xl font-semibold text-gray-600">1987</p>
              <p class="text-sm text-gray-600 mt-2">Prefettura Rieti n. 224</p>
            </div>

            <!-- Santo Patrono -->
            <div
              class="bg-gradient-to-br from-yellow-50 to-orange-100 rounded-xl p-6 text-center shadow-md border border-gray-200"
            >
              <div
                class="w-12 h-12 bg-orange-600 rounded-full flex items-center justify-center mx-auto mb-4"
              >
                <svg
                  class="w-6 h-6 sm:w-8 sm:h-8 text-white"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"
                  ></path>
                </svg>
              </div>
              <h3 class="text-lg font-bold text-gray-900 mb-2">
                Santo Patrono
              </h3>
              <p class="text-xl font-bold text-orange-600">Santa Maria</p>
              <p class="text-lg font-semibold text-gray-600">del Cerreto</p>
            </div>
          </div>
        </div>

        <!-- Documenti -->
        <div
          class="bg-white/90 backdrop-blur-sm rounded-xl sm:rounded-2xl shadow-xl border border-gray-200 p-6 md:p-12"
        >
          <div class="flex items-center space-x-4 mb-8">
            <div
