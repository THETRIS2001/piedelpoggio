  </main>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const placeholders = document.querySelectorAll(".js-youtube-placeholder");
      placeholders.forEach((placeholder) => {
        placeholder.addEventListener("click", () => {
          // Type casting for HTMLElement to access dataset
          const element = placeholder as HTMLElement;
          const videoId = element.dataset.videoId;
          const videoParams = element.dataset.videoParams || "";

          if (!videoId) return;

          const iframe = document.createElement("iframe");
          iframe.className = "w-full h-full";

          let src = `https://www.youtube.com/embed/${videoId}?autoplay=1`;
          if (videoParams) {
            src += `&${videoParams}`;
          }

          iframe.src = src;
          iframe.title = "YouTube video player";
          iframe.frameBorder = "0";
          iframe.allow =
            "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
          iframe.allowFullscreen = true;

          element.innerHTML = "";
          element.appendChild(iframe);
          element.classList.remove(
            "cursor-pointer",
            "group",
            "js-youtube-placeholder",
          );
        });
      });
    });
  </script>
</DefaultLayout>
