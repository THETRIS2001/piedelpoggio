// Funzione per ordinare i video per data decrescente
const sortVideos = (a: VideoItem, b: VideoItem) => {
  const dateA = a.date ? new Date(a.date).getTime() : 0;
  const dateB = b.date ? new Date(b.date).getTime() : 0;
  return dateB - dateA;
};

// Applica l'ordinamento
piedelpoggioVideos.sort(sortVideos);
zoneLimitrofeVideos.sort(sortVideos);
