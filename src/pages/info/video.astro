---
import DefaultLayout from '../../layouts/DefaultLayout.astro';
---

<DefaultLayout 
  title="Video - Piedelpoggio" 
  description="Guarda i video e scopri le bellezze del territorio di Piedelpoggio"
>
  <main class=" bg-gradient-to-br from-primary-50/30 via-white to-secondary-50/20">
    <!-- Hero Section -->
    <section class="hero-section">
      <!-- Background with gradient -->
      <div class="absolute inset-0 bg-gradient-to-b from-purple-200/80 via-purple-100/60 to-transparent"></div>
      
      <!-- Decorative elements -->
      
      
      <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-96 h-96 rounded-full blur-3xl opacity-40" style="background: radial-gradient(circle, rgba(219, 39, 119, 0.12) 0%, rgba(219, 39, 119, 0.04) 60%, transparent 100%);"></div>
      
      <div class="relative z-10 container mx-auto px-4 text-center">
        <div class="animate-fade-in">
          <div class="flex items-center justify-center mb-8">
            <div class="hidden md:flex w-20 h-20 bg-gradient-to-br from-purple-600 to-pink-600 rounded-xl sm:rounded-2xl items-center justify-center shadow-xl mr-6">
              <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
              </svg>
            </div>
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight">
              <span class="bg-gradient-to-r from-purple-900 via-purple-700 to-pink-600 bg-clip-text text-transparent">
                VIDEO
              </span>
            </h1>
          </div>
          <div class="w-32 h-1.5 bg-gradient-to-r from-purple-500 via-purple-600 to-pink-500 rounded-full mx-auto mb-8"></div>
          <p class="text-lg md:text-xl lg:text-2xl text-gray-600 max-w-4xl mx-auto leading-relaxed font-medium mb-6 md:mb-16">
            Scopri le bellezze del nostro territorio
          </p>
        </div>
      </div>
    </section>

    <!-- Video Section -->
    <section class="pt-4 pb-6 sm:pb-16 px-4 sm:px-6 lg:px-8">
      <div class="max-w-6xl mx-auto space-y-12">
        
        <!-- Riprese Aeree - Box con ombra -->
        <div class="bg-white/90 backdrop-blur-sm rounded-3xl shadow-xl border border-gray-200/50 overflow-hidden hover:shadow-2xl transition-all duration-300">
          <div class="p-6 md:p-12">
            <div class="flex items-center space-x-4 mb-8">
              <div class="w-12 h-12 sm:w-16 sm:h-16 bg-gradient-to-r from-purple-600 to-pink-600 rounded-xl flex items-center justify-center">
                <svg class="w-6 h-6 sm:w-8 sm:h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                </svg>
              </div>
              <h2 class="text-1xl sm:text-3xl font-bold text-gray-900">Riprese di Piedelpoggio</h2>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:p-12">
              <!-- Video 1 -->
              <div class="bg-white/80 backdrop-blur-sm rounded-xl sm:rounded-2xl shadow-xl overflow-hidden hover:shadow-2xl transition-all duration-300">
                <div class="aspect-video bg-black rounded-t-2xl overflow-hidden">
                  <video 
                    controls 
                    class="w-full h-full object-cover"
                    preload="metadata"
                  >
                    <source src="https://pub-a12c5c3cdccf45e5b98c647ffc712dfe.r2.dev/videos-for-r2/ripresa-aerea-2.mp4#t=0.5" type="video/mp4">
                    Il tuo browser non supporta il tag video.
                  </video>
                </div>
                <div class="p-4 md:p-6">
                  <h3 class="text-lg md:text-xl font-bold text-gray-900 mb-0">Ripresa Aerea</h3>
                  <p class="text-gray-600 leading-relaxed text-sm md:text-lg">
                    Prospettiva aerea che cattura ulteriori dettagli del borgo 
                    e delle montagne che lo circondano.
                  </p>
                </div>
              </div>

              <!-- Video 2 -->
              <div class="bg-white/80 backdrop-blur-sm rounded-xl sm:rounded-2xl shadow-xl overflow-hidden hover:shadow-2xl transition-all duration-300">
                <div class="aspect-video bg-black rounded-t-2xl overflow-hidden">
                  <video 
                    controls 
                    class="w-full h-full object-cover"
                    preload="metadata"
                  >
                    <source src="https://pub-a12c5c3cdccf45e5b98c647ffc712dfe.r2.dev/videos-for-r2/ripresa-aerea-1.mp4#t=0.5" type="video/mp4">
                    Il tuo browser non supporta il tag video.
                  </video>
                </div>
                <div class="p-4 md:p-6">
                  <h3 class="text-lg md:text-xl font-bold text-gray-900 mb-0">Ripresa Aerea dintorni innevati</h3>
                  <p class="text-gray-600 leading-relaxed text-sm md:text-lg">
                    Vista panoramica dall'alto di Piedelpoggio e del territorio circostante, 
                    mostrando la bellezza del paesaggio appenninico innevato.
                  </p>
                </div>
              </div>

              <!-- Video 3 - Presepe -->
              <div class="bg-white/80 backdrop-blur-sm rounded-xl sm:rounded-2xl shadow-xl overflow-hidden hover:shadow-2xl transition-all duration-300">
                <div class="aspect-video bg-black rounded-t-2xl overflow-hidden">
                  <video 
                    controls 
                    class="w-full h-full object-cover"
                    preload="metadata"
                  >
                    <source src="https://pub-a12c5c3cdccf45e5b98c647ffc712dfe.r2.dev/videos-for-r2/presepe-piedelpoggio.mp4#t=0.5" type="video/mp4">
                    Il tuo browser non supporta il tag video.
                  </video>
                </div>
                <div class="p-4 md:p-6">
                  <h3 class="text-lg md:text-xl font-bold text-gray-900 mb-0">Presepe di Piedelpoggio</h3>
                  <p class="text-gray-600 leading-relaxed text-sm md:text-lg">
                    Il tradizionale presepe di Piedelpoggio, una delle manifestazioni più sentite 
                    della comunità durante il periodo natalizio.
                  </p>
                </div>
              </div>

              <!-- Video 4 - Deposizione Corona -->
              <div class="bg-white/80 backdrop-blur-sm rounded-xl sm:rounded-2xl shadow-xl overflow-hidden hover:shadow-2xl transition-all duration-300">
                <div class="aspect-video bg-black rounded-t-2xl overflow-hidden">
                  <video 
                    controls 
                    class="w-full h-full object-cover"
                    preload="metadata"
                  >
                    <source src="https://pub-a12c5c3cdccf45e5b98c647ffc712dfe.r2.dev/videos-for-r2/deposizione-corona-piedelpoggio.mp4#t=0.5" type="video/mp4">
                    Il tuo browser non supporta il tag video.
                  </video>
                </div>
                <div class="p-4 md:p-6">
                  <h3 class="text-lg md:text-xl font-bold text-gray-900 mb-0">Deposizione Corona</h3>
                  <p class="text-gray-600 leading-relaxed text-sm md:text-lg">
                    Cerimonia di deposizione della corona, momento solenne che testimonia 
                    le tradizioni e la memoria storica della comunità di Piedelpoggio.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Riprese Zone Limitrofe - Box con ombra -->
        <div class="bg-white/90 backdrop-blur-sm rounded-3xl shadow-xl border border-gray-200/50 overflow-hidden hover:shadow-2xl transition-all duration-300">
          <div class="p-6 md:p-12">
            <div class="flex items-center space-x-4 mb-8">
              <div class="w-12 h-12 sm:w-16 sm:h-16 bg-gradient-to-r from-purple-600 to-pink-600 rounded-xl flex items-center justify-center">
                <svg class="w-6 h-6 sm:w-8 sm:h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                </svg>
              </div>
              <h2 class="text-1xl sm:text-3xl font-bold text-gray-900">Riprese Zone Limitrofe</h2>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:p-12">
             <!-- Video 1: In volo sopra la Crocetta -->
             <div class="bg-white/80 backdrop-blur-sm rounded-xl sm:rounded-2xl shadow-xl overflow-hidden hover:shadow-2xl transition-all duration-300">
               <div class="aspect-video bg-black rounded-t-2xl overflow-hidden">
                 <video 
                   controls 
                   class="w-full h-full object-cover"
                   preload="metadata"
                 >
                   <source src="https://pub-a12c5c3cdccf45e5b98c647ffc712dfe.r2.dev/videos-for-r2/In volo sopra la Crocetta.mp4#t=0.5" type="video/mp4">
                   Il tuo browser non supporta il tag video.
                 </video>
               </div>
               <div class="p-4 md:p-6">
                 <h3 class="text-lg md:text-xl font-bold text-gray-900 mb-0">In volo sopra la Crocetta</h3>
               </div>
             </div>

             <!-- Video 2: Monte Tilia -->
             <div class="bg-white/80 backdrop-blur-sm rounded-xl sm:rounded-2xl shadow-xl overflow-hidden hover:shadow-2xl transition-all duration-300">
               <div class="aspect-video bg-black rounded-t-2xl overflow-hidden">
                 <video 
                   controls 
                   class="w-full h-full object-cover"
                   preload="metadata"
                 >
                   <source src="https://pub-a12c5c3cdccf45e5b98c647ffc712dfe.r2.dev/videos-for-r2/Monte Tilia.mp4#t=0.5" type="video/mp4">
                   Il tuo browser non supporta il tag video.
                 </video>
               </div>
               <div class="p-4 md:p-6"md:p-6">
                 <h3 class="text-lg md:text-xl font-bold text-gray-900 mb-0">Monte Tilia</h3>
               </div>
             </div>

             <!-- Video 3: Leonessa e la torre Angioina -->
             <div class="bg-white/80 backdrop-blur-sm rounded-xl sm:rounded-2xl shadow-xl overflow-hidden hover:shadow-2xl transition-all duration-300">
               <div class="aspect-video bg-black rounded-t-2xl overflow-hidden">
                 <video 
                   controls 
                   class="w-full h-full object-cover"
                   preload="metadata"
                 >
                   <source src="https://pub-a12c5c3cdccf45e5b98c647ffc712dfe.r2.dev/videos-for-r2/Leonessa e la torre Angioina.mp4#t=0.5" type="video/mp4">
                   Il tuo browser non supporta il tag video.
                 </video>
               </div>
               <div class="p-4 md:p-6">
                 <h3 class="text-lg md:text-xl font-bold text-gray-900 mb-0">Leonessa e la torre Angioina</h3>
               </div>
             </div>

             <!-- Video 4: Leonessa -->
             <div class="bg-white/80 backdrop-blur-sm rounded-xl sm:rounded-2xl shadow-xl overflow-hidden hover:shadow-2xl transition-all duration-300">
               <div class="aspect-video bg-black rounded-t-2xl overflow-hidden">
                 <video 
                   controls 
                   class="w-full h-full object-cover"
                   preload="metadata"
                 >
                   <source src="https://pub-a12c5c3cdccf45e5b98c647ffc712dfe.r2.dev/videos-for-r2/Leonessa.mp4#t=0.5" type="video/mp4">
                   Il tuo browser non supporta il tag video.
                 </video>
               </div>
               <div class="p-4 md:p-6">
                 <h3 class="text-lg md:text-xl font-bold text-gray-900 mb-0">Leonessa</h3>
               </div>
             </div>

             <!-- Video 5: Leonessa 1 -->
             <div class="bg-white/80 backdrop-blur-sm rounded-xl sm:rounded-2xl shadow-xl overflow-hidden hover:shadow-2xl transition-all duration-300">
               <div class="aspect-video bg-black rounded-t-2xl overflow-hidden">
                 <video 
                   controls 
                   class="w-full h-full object-cover"
                   preload="metadata"
                 >
                   <source src="https://pub-a12c5c3cdccf45e5b98c647ffc712dfe.r2.dev/videos-for-r2/Leonessa 1.mp4#t=0.5" type="video/mp4">
                   Il tuo browser non supporta il tag video.
                 </video>
               </div>
               <div class="p-4 md:p-6">
                 <h3 class="text-lg md:text-xl font-bold text-gray-900 mb-0">Leonessa 1</h3>
               </div>
             </div>

             <!-- Video 6: Leonessa 2 -->
             <div class="bg-white/80 backdrop-blur-sm rounded-xl sm:rounded-2xl shadow-xl overflow-hidden hover:shadow-2xl transition-all duration-300">
               <div class="aspect-video bg-black rounded-t-2xl overflow-hidden">
                 <video 
                   controls 
                   class="w-full h-full object-cover"
                   preload="metadata"
                 >
                   <source src="https://pub-a12c5c3cdccf45e5b98c647ffc712dfe.r2.dev/videos-for-r2/Leonessa 2.mp4#t=0.5" type="video/mp4">
                   Il tuo browser non supporta il tag video.
                 </video>
               </div>
               <div class="p-4 md:p-6">
                 <h3 class="text-lg md:text-xl font-bold text-gray-900 mb-0">Leonessa 2</h3>
               </div>
             </div>

             <!-- Video 7: Leonessa 3 -->
             <div class="bg-white/80 backdrop-blur-sm rounded-xl sm:rounded-2xl shadow-xl overflow-hidden hover:shadow-2xl transition-all duration-300">
               <div class="aspect-video bg-black rounded-t-2xl overflow-hidden">
                 <video 
                   controls 
                   class="w-full h-full object-cover"
                   preload="metadata"
                 >
                   <source src="https://pub-a12c5c3cdccf45e5b98c647ffc712dfe.r2.dev/videos-for-r2/Leonessa 3.mp4#t=0.5" type="video/mp4">
                   Il tuo browser non supporta il tag video.
                 </video>
               </div>
               <div class="p-4 md:p-6">
                 <h3 class="text-lg md:text-xl font-bold text-gray-900 mb-0">Leonessa 3</h3>
               </div>
             </div>

             <!-- Video 8: Leonessa e Dintorni innevati-->
             <div class="bg-white/80 backdrop-blur-sm rounded-xl sm:rounded-2xl shadow-xl overflow-hidden hover:shadow-2xl transition-all duration-300">
               <div class="aspect-video bg-black rounded-t-2xl overflow-hidden">
                 <video 
                   controls 
                   class="w-full h-full object-cover"
                   preload="metadata"
                 >
                   <source src="https://pub-a12c5c3cdccf45e5b98c647ffc712dfe.r2.dev/videos-for-r2/Leonessa e Dintorni.mp4#t=0.5" type="video/mp4">
                   Il tuo browser non supporta il tag video.
                 </video>
               </div>
               <div class="p-4 md:p-6">
                 <h3 class="text-lg md:text-xl font-bold text-gray-900 mb-0">Leonessa e Dintorni innevati</h3>
               </div>
             </div>

             <!-- Video 9: Paesaggio Leonessa -->
             <div class="bg-white/80 backdrop-blur-sm rounded-xl sm:rounded-2xl shadow-xl overflow-hidden hover:shadow-2xl transition-all duration-300">
               <div class="aspect-video bg-black rounded-t-2xl overflow-hidden">
                 <video 
                   controls 
                   class="w-full h-full object-cover"
                   preload="metadata"
                 >
                   <source src="https://pub-a12c5c3cdccf45e5b98c647ffc712dfe.r2.dev/videos-for-r2/Paesaggio Leonessa.mp4#t=0.5" type="video/mp4">
                   Il tuo browser non supporta il tag video.
                 </video>
               </div>
               <div class="p-4 md:p-6">
                 <h3 class="text-lg md:text-xl font-bold text-gray-900 mb-0">Paesaggio Leonessa</h3>
               </div>
             </div>
             <!-- Video 10: Presepe Piedelpoggio (YouTube) -->
             <div class="bg-white/80 backdrop-blur-sm rounded-xl sm:rounded-2xl shadow-xl overflow-hidden hover:shadow-2xl transition-all duration-300">
               <div class="aspect-video bg-black rounded-t-2xl overflow-hidden">
                 <iframe 
                   class="w-full h-full"
                   src="https://www.youtube.com/embed/WhGKGI3w444" 
                   title="Presepe Piedelpoggio"
                   frameborder="0" 
                   allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
                   allowfullscreen
                 ></iframe>
               </div>
               <div class="p-4 md:p-6">
                 <h3 class="text-lg md:text-xl font-bold text-gray-900 mb-0">Presepe Piedelpoggio (YouTube)</h3>
               </div>
             </div>
           </div>
        </div>
        </div>

        <!-- Canale YouTube Ezio Paciucci -->
        <div class="bg-white/90 backdrop-blur-sm rounded-3xl shadow-xl border border-gray-200/50 overflow-hidden hover:shadow-2xl transition-all duration-300">
          <div class="p-6 md:p-12 text-center">
            <div class="flex flex-col items-center justify-center space-y-6">
              <div class="w-16 h-16 sm:w-20 sm:h-20 bg-red-600 rounded-full flex items-center justify-center shadow-lg transform hover:scale-110 transition-transform duration-300">
                <svg class="w-8 h-8 sm:w-10 sm:h-10 text-white" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                </svg>
              </div>
              
              <div class="space-y-4 max-w-2xl">
                <h2 class="text-2xl sm:text-3xl font-bold text-gray-900">Altri Video del Territorio</h2>
                <p class="text-gray-600 text-lg sm:text-xl leading-relaxed">
                  Puoi trovare altri video relativi al territorio ed eventi sul canale YouTube di Ezio Paciucci.
                </p>
                <a 
                  href="https://www.youtube.com/@eziopaciucci6765/videos" 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="inline-flex items-center px-8 py-3 bg-red-600 hover:bg-red-700 text-white font-semibold rounded-full transition-colors duration-300 shadow-md hover:shadow-lg mt-4 group"
                >
                  <span>Visita il Canale</span>
                  <svg class="w-5 h-5 ml-2 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</DefaultLayout>
