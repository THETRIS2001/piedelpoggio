              <!-- SEZIONE 6: Rendiconto -->
              <div class="statuto-section mb-12">
                <div
                  class="flex items-center gap-4 mb-6 pb-4 border-b border-gray-200"
                >
                  <div
                    class="w-10 h-10 rounded-lg bg-blue-100 flex items-center justify-center text-blue-700 font-bold text-lg flex-shrink-0"
                  >
                    6
                  </div>
                  <h2 class="text-2xl font-bold text-gray-900">
                    Rendiconto economico-finanziario
                  </h2>
                </div>

                <div class="grid grid-cols-1 gap-6">
                  <!-- Art 25 -->
                  <div
                    class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-all duration-300"
                  >
                    <h3 class="text-lg font-bold text-blue-700 mb-3">
                      Art. 25
                    </h3>
                    <p
                      class="text-gray-600 text-sm leading-relaxed text-justify"
                    >
                      Il rendiconto economico-finanziario comprende l'esercizio
                      sociale dal primo gennaio al trentuno dicembre di ogni
                      anno e deve essere presentato dal Consiglio Direttivo
                      all'assemblea dei soci per la sua approvazione, di norma
                      entro il trentuno marzo dell'anno successivo e da questa
                      approvato in sede di riunione ordinaria.
                    </p>
                  </div>
                </div>
              </div>

              <!-- SEZIONE 7: Scioglimento -->
              <div class="statuto-section mb-12">
                <div
                  class="flex items-center gap-4 mb-6 pb-4 border-b border-gray-200"
                >
                  <div
                    class="w-10 h-10 rounded-lg bg-blue-100 flex items-center justify-center text-blue-700 font-bold text-lg flex-shrink-0"
                  >
                    7
                  </div>
                  <h2 class="text-2xl font-bold text-gray-900">
                    Scioglimento dell'Associazione
                  </h2>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                  <!-- Art 26 -->
                  <div
                    class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-all duration-300"
                  >
                    <h3 class="text-lg font-bold text-blue-700 mb-3">
                      Art. 26
                    </h3>
                    <p
                      class="text-gray-600 text-sm leading-relaxed text-justify"
                    >
                      Lo scioglimento dell'Associazione deve essere deliberato
                      dall'assemblea dei soci con le modalità previste
                      all'articolo 14 del presente statuto.
                    </p>
                  </div>

                  <!-- Art 27 -->
                  <div
                    class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-all duration-300"
                  >
                    <h3 class="text-lg font-bold text-blue-700 mb-3">
                      Art. 27
                    </h3>
                    <p
                      class="text-gray-600 text-sm leading-relaxed text-justify mb-4"
                    >
                      In caso di scioglimento deliberato dall'assemblea, il
                      patrimonio sociale, soddisfatto ogni creditore
                      dell'Associazione, verrà devoluto ad altra associazione
                      con finalità analoghe e conformi alle finalità
                      dell'Associazione o a fini di pubblica utilità, sentito
                      l'organismo di controllo di cui all'articolo 3 comma 190
                      della legge 23 dicembre 1996 n. 662 o altra destinazione
                      imposta dalla legge.
                    </p>
                    <p
                      class="text-gray-600 text-sm leading-relaxed text-justify"
                    >
                      Il presente statuto viene redatto tenendo conto delle
                      norme previste dal D.L. 4/12/97 n. 460 per le Associazioni
                      no-profit.
                    </p>
                  </div>
                </div>
              </div>

              <!-- SEZIONE 8: Controversie -->
              <div class="statuto-section mb-12">
                <div
                  class="flex items-center gap-4 mb-6 pb-4 border-b border-gray-200"
                >
                  <div
                    class="w-10 h-10 rounded-lg bg-blue-100 flex items-center justify-center text-blue-700 font-bold text-lg flex-shrink-0"
                  >
                    8
                  </div>
                  <h2 class="text-2xl font-bold text-gray-900">Controversie</h2>
                </div>

                <div class="grid grid-cols-1 gap-6">
                  <!-- Art 28 -->
                  <div
                    class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-all duration-300"
                  >
                    <h3 class="text-lg font-bold text-blue-700 mb-3">
                      Art. 28 - Arbitrato
                    </h3>
                    <p
                      class="text-gray-600 text-sm leading-relaxed text-justify"
                    >
                      In caso di controversie fra i soci o fra i soci e
                      l'Associazione, relativamente al presente statuto, sarà
                      competente un Collegio di tre Arbitri, nominati uno per
                      ciascuno delle parti ed il terzo di comune accordo, il
                      quale giudicherà secondo equità e senza formalità di
                      procedure, salvo che tali controversie non siano per legge
                      demandate al giudizio dell'autorità giudiziaria. La
                      decisione presa a maggioranza, viene dal Consiglio
                      Direttivo, comunicata per iscritto all'interessato.
                    </p>
                  </div>
                </div>
              </div>

              <!-- SEZIONE 9: Disposizioni Finali -->
              <div class="statuto-section">
                <div
                  class="flex items-center gap-4 mb-6 pb-4 border-b border-gray-200"
                >
                  <div
                    class="w-10 h-10 rounded-lg bg-blue-100 flex items-center justify-center text-blue-700 font-bold text-lg flex-shrink-0"
                  >
                    9
                  </div>
                  <h2 class="text-2xl font-bold text-gray-900">
                    Disposizioni finali
                  </h2>
                </div>

                <div class="grid grid-cols-1 gap-6">
                  <!-- Art 29 -->
                  <div
                    class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-all duration-300"
                  >
                    <h3 class="text-lg font-bold text-blue-700 mb-3">
                      Art. 29
                    </h3>
                    <p
                      class="text-gray-600 text-sm leading-relaxed text-justify"
                    >
                      Per tutto quanto non previsto espressamente dal presente
                      statuto, si rimanda alla normativa vigente in materia.
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <!-- end collapsible-body -->
      </div>
      <!-- end collapsible-content -->

      <!-- Sezione Documenti spostata sopra: qui non duplico -->

      <script>
        // Funzione toggle per lo Statuto collassabile
        function toggleStatuto(header: HTMLElement) {
          const content = header.closest(
            ".collapsible-content",
          ) as HTMLElement | null;
          const body = content?.querySelector(
            ".collapsible-body",
          ) as HTMLElement | null;
          const icon = header.querySelector(
            ".expand-icon",
          ) as HTMLElement | null;

          if (body && icon) {
            if (body.style.display === "none") {
              body.style.display = "block";
              icon.style.transform = "rotate(180deg)";
            } else {
              body.style.display = "none";
              icon.style.transform = "rotate(0deg)";
            }
          }
        }

        // Rendiamo la funzione globale per l'onclick nel template
        (window as any).toggleStatuto = toggleStatuto;

        document.addEventListener("DOMContentLoaded", () => {
          const searchInput = document.getElementById(
            "searchInput",
          ) as HTMLInputElement | null;
          const dateFrom = document.getElementById(
            "dateFrom",
          ) as HTMLInputElement | null;
          const dateTo = document.getElementById(
            "dateTo",
          ) as HTMLInputElement | null;
          const resetBtn = document.getElementById(
            "clearFilter",
          ) as HTMLButtonElement | null;
          const grid = document.querySelector(
            ".grid.grid-cols-1.md\\:grid-cols-2.lg\\:grid-cols-3",
          ) as HTMLElement | null;
          const items = Array.from(
            document.querySelectorAll(".doc-item") as NodeListOf<HTMLElement>,
          );
          const filterEmptyMessage = document.getElementById(
            "filterEmptyMessage",
          ) as HTMLElement | null;

          // --- Sort UI (identical to gallery) ---
          function updateSortUI() {
            const field =
              (document.getElementById("sortField") as HTMLInputElement | null)
                ?.value || "date";
            const order =
              (document.getElementById("sortOrder") as HTMLInputElement | null)
                ?.value || "desc";
            const nameBtn = document.getElementById(
              "sortNameBtn",
            ) as HTMLButtonElement | null;
            const dateBtn = document.getElementById(
              "sortDateBtn",
            ) as HTMLButtonElement | null;
            const dirIcon = document.getElementById(
              "sortDirIcon",
            ) as SVGElement | null;
            const knob = document.getElementById(
              "sortKnob",
            ) as HTMLDivElement | null;
            if (nameBtn) nameBtn.textContent = order === "asc" ? "Z–A" : "A–Z";
            if (nameBtn && dateBtn) {
              nameBtn.setAttribute("aria-pressed", String(field === "name"));
              dateBtn.setAttribute("aria-pressed", String(field === "date"));
              if (field === "name") {
                nameBtn.className =
                  "absolute inset-y-0 left-0 w-12 text-xs font-semibold text-white focus:outline-none no-min-h";
                dateBtn.className =
                  "absolute inset-y-0 right-0 w-12 text-blue-700 focus:outline-none no-min-h";
                if (knob) knob.style.left = "0";
              } else {
                dateBtn.className =
                  "absolute inset-y-0 right-0 w-12 text-xs font-semibold text-white focus:outline-none no-min-h";
                nameBtn.className =
                  "absolute inset-y-0 left-0 w-12 text-blue-700 focus:outline-none no-min-h";
                if (knob) knob.style.left = "50%";
              }
            }
            if (dirIcon) {
              dirIcon.innerHTML =
                order === "asc"
                  ? '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"/>'
                  : '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>';
            }
          }
          updateSortUI();

          // Sort switch click handler (toggles field like in gallery)
          document
            .getElementById("sortSwitch")
            ?.addEventListener("click", () => {
              const sf = document.getElementById(
                "sortField",
              ) as HTMLInputElement | null;
              if (sf) {
                sf.value = sf.value === "date" ? "name" : "date";
                sf.dispatchEvent(new Event("change"));
              }
            });
          document
            .getElementById("sortDirBtn")
            ?.addEventListener("click", () => {
              const so = document.getElementById(
                "sortOrder",
              ) as HTMLInputElement | null;
              if (so) {
                so.value = so.value === "desc" ? "asc" : "desc";
                so.dispatchEvent(new Event("change"));
              }
            });
          document
            .getElementById("sortField")
            ?.addEventListener("change", () => {
              updateSortUI();
              sortAndFilter();
            });
          document
            .getElementById("sortOrder")
            ?.addEventListener("change", () => {
              updateSortUI();
              sortAndFilter();
            });

          function sortAndFilter() {
            if (!grid) return;
            const field =
              (document.getElementById("sortField") as HTMLInputElement | null)
                ?.value || "date";
            const order =
              (document.getElementById("sortOrder") as HTMLInputElement | null)
                ?.value || "desc";

            // Sort the items array
            items.sort((a, b) => {
              let va = "";
              let vb = "";
              if (field === "name") {
                va = (a.dataset?.name || "").toLowerCase();
                vb = (b.dataset?.name || "").toLowerCase();
              } else {
                va = a.dataset?.date || "";
                vb = b.dataset?.date || "";
                if (!va && vb) return 1;
                if (va && !vb) return -1;
              }
              const cmp = va.localeCompare(vb);
              const effOrder =
                field === "name" ? (order === "desc" ? "asc" : "desc") : order;
              return effOrder === "desc" ? -cmp : cmp;
            });

            // Reorder DOM
            items.forEach((item) => grid.appendChild(item));

            // Apply filters on the reordered list
            filterDocs();
          }

          function filterDocs() {
            const q = (
              searchInput && searchInput.value ? searchInput.value : ""
            )
              .toLowerCase()
              .trim();
            const fromDate =
              dateFrom && dateFrom.value ? new Date(dateFrom.value) : null;
            const toDate =
              dateTo && dateTo.value ? new Date(dateTo.value) : null;
            let visibleCount = 0;

            items.forEach((item) => {
              const name = (
                item.dataset && item.dataset.name ? item.dataset.name : ""
              ).toLowerCase();
              const itemDateStr =
                item.dataset && item.dataset.date ? item.dataset.date : "";
              const itemDate = itemDateStr ? new Date(itemDateStr) : null;
              let show = true;
              if (q && !name.includes(q)) show = false;
              if (fromDate && itemDate && itemDate < fromDate) show = false;
              if (toDate && itemDate && itemDate > toDate) show = false;

              item.style.display = show ? "block" : "none";
              if (show) visibleCount++;
            });

            if (filterEmptyMessage) {
              filterEmptyMessage.classList.toggle("hidden", visibleCount !== 0);
            }
          }

          if (searchInput) searchInput.addEventListener("input", filterDocs);
          if (dateFrom) dateFrom.addEventListener("input", filterDocs);
          if (dateTo) dateTo.addEventListener("input", filterDocs);
          if (resetBtn)
            resetBtn.addEventListener("click", () => {
              if (searchInput) searchInput.value = "";
              if (dateFrom) dateFrom.value = "";
              if (dateTo) dateTo.value = "";
              // Reset sort to default (date desc)
              const sf = document.getElementById(
                "sortField",
              ) as HTMLInputElement | null;
              const so = document.getElementById(
                "sortOrder",
              ) as HTMLInputElement | null;
              if (sf) sf.value = "date";
              if (so) so.value = "desc";
              updateSortUI();
              sortAndFilter();
            });

          // Prima esecuzione per allineare stato
          sortAndFilter();

          // Toggle Statuto rimosso su richiesta
        });
      </script>
    </section>
  </main></DefaultLayout
>
