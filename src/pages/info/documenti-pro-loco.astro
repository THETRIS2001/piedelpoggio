---
export const prerender = true;
import DefaultLayout from "../../layouts/DefaultLayout.astro";
import {
  parseDocumentoProloco,
  sortDocumentiByDate,
  type DocumentoProloco,
} from "../../utils/eventiParser";

// Palette ciclica per colorare le card come in Parrocchia
const colorPalette = [
  {
    card: "from-yellow-50 to-orange-100",
    border: "border-orange-200",
    hoverText: "group-hover:text-orange-600",
    icon: "bg-orange-600",
  },
  {
    card: "from-rose-50 to-pink-100",
    border: "border-pink-200",
    hoverText: "group-hover:text-pink-600",
    icon: "bg-pink-600",
  },
  {
    card: "from-green-50 to-emerald-100",
    border: "border-emerald-200",
    hoverText: "group-hover:text-emerald-600",
    icon: "bg-emerald-600",
  },
  {
    card: "from-blue-50 to-indigo-100",
    border: "border-indigo-200",
    hoverText: "group-hover:text-indigo-600",
    icon: "bg-indigo-600",
  },
  {
    card: "from-purple-50 to-violet-100",
    border: "border-violet-200",
    hoverText: "group-hover:text-violet-600",
    icon: "bg-violet-600",
  },
  {
    card: "from-cyan-50 to-sky-100",
    border: "border-sky-200",
    hoverText: "group-hover:text-sky-600",
    icon: "bg-sky-600",
  },
  {
    card: "from-lime-50 to-green-100",
    border: "border-lime-200",
    hoverText: "group-hover:text-lime-600",
    icon: "bg-lime-600",
  },
  {
    card: "from-amber-50 to-yellow-100",
    border: "border-yellow-200",
    hoverText: "group-hover:text-yellow-600",
    icon: "bg-amber-600",
  },
];

// Load all PDF files from proloco folder dynamically
const docFiles = import.meta.glob("/public/documents/proloco/*.pdf", {
  eager: true,
});
const docArray: DocumentoProloco[] = [];

for (const path in docFiles) {
  const filename = path.split("/").pop();
  if (filename) {
    const documento = parseDocumentoProloco(filename, "/documents/proloco");
    if (documento) {
      docArray.push(documento);
    }
  }
}

const docsSorted = sortDocumentiByDate(docArray);

// Map to display format with color palette
const docs = docsSorted.map((doc, idx) => {
  const palette = colorPalette[idx % colorPalette.length];
  const classes = {
    card: palette.card,
    border: palette.border,
    hoverText: palette.hoverText,
    icon: palette.icon,
  };
  return {
    name: doc.nome,
    href: doc.path,
    ext: doc.ext,
    dateISO: doc.data.toISOString(),
    dateDisplay: doc.data.toLocaleDateString("it-IT", {
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
    }),
    classes,
  };
});
---

<DefaultLayout
  title="Documenti Pro Loco - Piedelpoggio"
  description="Documenti ufficiali della Pro Loco: Statuto, riunioni e atti"
>
  <main class="bg-gradient-to-br from-blue-50/30 via-white to-indigo-50/20">
    <!-- Hero Section -->
    <section class="hero-section">
      <!-- Background with gradient -->
      <div
        class="absolute inset-0 bg-gradient-to-b from-blue-100/70 via-blue-50/50 to-transparent"
      >
      </div>

      <!-- Decorative elements -->

      <div class="relative z-10 container mx-auto px-4 text-center">
        <div class="animate-fade-in">
          <div class="flex items-center justify-center mb-8">
            <div
              class="hidden md:flex w-20 h-20 bg-gradient-to-br from-blue-600 to-indigo-600 rounded-xl sm:rounded-2xl items-center justify-center shadow-xl mr-6"
            >
              <svg
                class="w-10 h-10 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                ></path>
              </svg>
            </div>
            <h1
              class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight"
            >
              <span
                class="bg-gradient-to-r from-blue-900 via-blue-700 to-indigo-600 bg-clip-text text-transparent"
              >
                DOCUMENTI PRO LOCO
              </span>
            </h1>
          </div>
          <div
            class="w-32 h-1.5 bg-gradient-to-r from-blue-500 via-blue-600 to-indigo-500 rounded-full mx-auto mb-8"
          >
          </div>
          <p
            class="text-lg md:text-xl lg:text-2xl text-gray-600 max-w-6xl mx-auto leading-relaxed font-medium mb-6 md:mb-16"
          >
            Statuto e documenti ufficiali della Pro Loco di Piedelpoggio
          </p>
        </div>
      </div>
    </section>

    <!-- Elenco Documenti Pro Loco (automatico) - spostato sopra lo Statuto -->
    <section class="pt-4 pb-16 px-4 sm:px-6 lg:px-8">
      <div class="max-w-6xl mx-auto">
        <div
          class="bg-white/90 backdrop-blur-sm rounded-xl sm:rounded-2xl shadow-xl border border-gray-200 p-6 md:p-12"
        >
          <div class="flex items-center space-x-4 mb-8">
            <div
              class="w-12 h-12 sm:w-16 sm:h-16 bg-gradient-to-r from-blue-600 to-indigo-600 rounded-xl flex items-center justify-center"
            >
              <svg
                class="w-6 h-6 sm:w-8 sm:h-8 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                ></path>
              </svg>
            </div>
            <h2 class="text-1xl sm:text-3xl font-bold text-gray-900">
              Documenti Pro Loco
            </h2>
          </div>

          <!-- Barra di ricerca e filtri data -->
          <div
            class="bg-blue-600 rounded-xl border border-blue-200 shadow-md p-3 md:p-4 mb-8"
          >
            <div
              class="grid grid-cols-1 sm:grid-cols-5 gap-3 items-end max-w-full"
            >
              <div class="min-w-0 overflow-hidden">
                <div class="text-xs font-semibold text-white mb-1">Cerca</div>
                <input
                  id="searchInput"
                  type="text"
                  placeholder="Cerca per nome documento"
                  class="w-full px-3 py-2 border border-gray-200 !rounded-xl focus:outline-none focus:ring-0 focus:border-blue-400 transition-colors duration-300 appearance-none bg-white"
                />
              </div>
              <div class="min-w-0 overflow-hidden">
                <div class="text-xs font-semibold text-white mb-1">
                  Data Inizio
                </div>
                <input
                  id="dateFrom"
                  type="date"
                  class="w-full max-w-full px-3 py-2 border border-gray-200 !rounded-xl focus:outline-none focus:ring-0 focus:border-blue-400 transition-colors duration-300 appearance-none bg-white"
                />
              </div>
              <div class="min-w-0 overflow-hidden">
                <div class="text-xs font-semibold text-white mb-1">
                  Data Fine
                </div>
                <input
                  id="dateTo"
                  type="date"
                  class="w-full max-w-full px-3 py-2 border border-gray-200 !rounded-xl focus:outline-none focus:ring-0 focus:border-blue-400 transition-colors duration-300 appearance-none bg-white"
                />
              </div>
              <div
                class="flex items-center justify-between min-w-0 overflow-hidden self-end sm:col-span-2 w-full no-min-h"
              >
                <div class="flex items-center justify-start no-min-h">
                  <input id="sortField" type="hidden" value="date" />
                  <input id="sortOrder" type="hidden" value="desc" />
                  <div
                    id="sortSwitch"
                    class="relative w-24 h-8 rounded-full border border-white shadow-sm overflow-hidden no-min-h"
                    style="background: linear-gradient(180deg, #fafafa 0%, #e9e9e9 100%); box-shadow: inset 0 2px 6px rgba(0,0,0,0.08), 0 1px 0 rgba(255,255,255,0.6);"
                  >
                    <div
                      id="sortKnob"
                      class="absolute top-0 left-0 w-12 h-8 text-white flex items-center justify-center rounded-full transition-all duration-200 no-min-h"
                      style="background: linear-gradient(180deg, #3b82f6 0%, #1d4ed8 100%); box-shadow: 0 2px 6px rgba(0,0,0,0.25), inset 0 1px 0 rgba(255,255,255,0.6); left: 50%;"
                    >
                    </div>
                    <button
                      id="sortNameBtn"
                      type="button"
                      class="absolute inset-y-0 left-0 w-12 text-xs font-semibold leading-none text-blue-700 focus:outline-none no-min-h"
                      >A–Z</button
                    >
                    <button
                      id="sortDateBtn"
                      type="button"
                      class="absolute inset-y-0 right-0 w-12 text-xs font-semibold text-white leading-none focus:outline-none no-min-h"
                    >
                      <svg
                        class="w-4 h-4 mx-auto"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                        ></path></svg
                      >
                    </button>
                  </div>
                  <button
                    id="sortDirBtn"
                    type="button"
                    class="ml-2 h-8 w-8 flex items-center justify-center rounded-full text-xs font-semibold bg-white text-blue-700 border border-white focus:outline-none no-min-h"
                    title="Direzione"
                  >
                    <svg
                      id="sortDirIcon"
                      class="w-4 h-4"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 9l-7 7-7-7"></path></svg
                    >
                  </button>
                </div>
                <div
                  class="flex items-center justify-end min-w-0 overflow-hidden"
                >
                  <button
                    id="clearFilter"
                    type="button"
                    class="px-4 py-2 !rounded-xl bg-white text-blue-700 border border-white hover:bg-white/90 focus:outline-none focus:ring-0"
                    >Reset</button
                  >
                </div>
              </div>
            </div>
          </div>

          {
            docs.length === 0 ? (
              <p class="text-gray-600 text-sm md:text-base">
                Nessun documento trovato nella cartella{" "}
                <code>/public/documents/proloco</code>.
              </p>
            ) : (
              <>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                  {docs.map((doc) => (
                    <a
                      href={doc.href}
                      class={`doc-item block bg-gradient-to-br ${doc.classes.card} rounded-xl p-6 shadow-md hover:shadow-lg transition-all duration-300 group border border-gray-200`}
                      target="_blank"
                      data-name={doc.name}
                      data-date={doc.dateISO}
                    >
                      <div class="flex items-start space-x-4">
                        <div
                          class={`w-12 h-12 ${doc.classes.icon} rounded-lg flex items-center justify-center flex-shrink-0`}
                        >
                          <svg
                            class="w-6 h-6 sm:w-8 sm:h-8 text-white"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                          >
                            <path d="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z" />
                          </svg>
                        </div>
                        <div class="flex-1">
                          <h4
                            class={`font-semibold text-gray-900 ${doc.classes.hoverText} transition-colors mb-1`}
                          >
                            {doc.name}
                          </h4>
                          <p class="text-sm text-gray-700">
                            {doc.ext} • {doc.dateDisplay}
                          </p>
                        </div>
                      </div>
                    </a>
                  ))}
                </div>
                <p
                  id="filterEmptyMessage"
                  class="text-gray-600 text-sm md:text-base mt-4 hidden"
                >
                  Nessun documento corrisponde ai filtri impostati.
                </p>
              </>
            )
          }
        </div>
      </div>
    </section>

    <!-- Content Section - Statuto Collassabile -->
    <section class="pt-4 pb-6 sm:pb-16 px-4 sm:px-6 lg:px-8">
      <div class="max-w-6xl mx-auto">
        <div
          class="bg-white rounded-2xl shadow-xl border border-gray-200 overflow-hidden collapsible-content"
        >
          <!-- Header cliccabile per Statuto -->
          <div
            class="bg-white p-6 md:p-8 cursor-pointer hover:bg-gray-50 transition-all duration-300 collapsible-header"
            onclick="toggleStatuto(this)"
          >
            <div class="flex items-center justify-between">
              <div class="flex items-center">
                <div
                  class="w-12 h-12 sm:w-16 sm:h-16 bg-gradient-to-r from-indigo-600 to-blue-600 rounded-xl sm:rounded-2xl flex items-center justify-center mr-6 shadow-lg flex-shrink-0"
                >
                  <svg
                    class="w-6 h-6 sm:w-8 sm:h-8 text-white"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M7 7h10M7 11h10M7 15h10"></path>
                  </svg>
                </div>
                <div>
                  <h2 class="text-1xl sm:text-3xl font-bold text-gray-900">
                    Statuto della Pro Loco
                  </h2>
                  <p class="text-gray-600 text-sm md:text-base mt-1">
                    Testo integrale dello Statuto dell'associazione
                  </p>
                </div>
              </div>
              <div
                class="expand-icon transform transition-transform duration-300"
              >
                <svg
                  class="w-6 h-6 text-gray-400"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"></path>
                </svg>
              </div>
            </div>
          </div>

          <!-- Contenuto collassabile per Statuto -->
          <div
            class="collapsible-body border-t border-gray-100 p-6 md:p-10 bg-gray-50/50"
            style="display: none;"
          >
            <div id="statutoContent" class="space-y-8">
              <!-- SEZIONE 1: Sede, costituzione... -->
              <div class="statuto-section mb-12">
                <div
                  class="flex items-center gap-4 mb-6 pb-4 border-b border-gray-200"
                >
                  <div
                    class="w-10 h-10 rounded-lg bg-blue-100 flex items-center justify-center text-blue-700 font-bold text-lg flex-shrink-0"
                  >
                    1
                  </div>
                  <h2 class="text-2xl font-bold text-gray-900">
                    Sede, costituzione, durata, oggetto sociale
                  </h2>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                  <!-- Art 1 -->
                  <div
                    class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-all duration-300"
                  >
                    <h3 class="text-lg font-bold text-blue-700 mb-3">Art. 1</h3>
                    <p
                      class="text-gray-600 text-sm leading-relaxed text-justify"
                    >
                      È costituita l'Associazione Culturale e del Tempo Libero
                      Associazione Pro Pie del Poggio ed è costituito ai sensi e
                      per gli effetti degli art. 36 e seguenti del Codice
                      Civile, dell'art. 19 della costituzione repubblicana. Il
                      presente statuto viene redatto tenendo conto della legge
                      460 del 18/11/1997 e la legge 383 del 07/12/2000.
                    </p>
                  </div>

                  <!-- Art 2 -->
                  <div
                    class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-all duration-300"
                  >
                    <h3 class="text-lg font-bold text-blue-700 mb-3">Art. 2</h3>
                    <p
                      class="text-gray-600 text-sm leading-relaxed text-justify"
                    >
                      L'Associazione ha sede in Piedelpoggio (RI), attualmente
                      in Via A.F. Maccheroni snc e può essere trasferita dal
                      Consiglio Direttivo, mediante semplice delibera, purché in
                      Italia ed ha durata a tempo indeterminato.
                    </p>
                  </div>

                  <!-- Art 3 -->
                  <div
                    class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-all duration-300"
                  >
                    <h3 class="text-lg font-bold text-blue-700 mb-3">Art. 3</h3>
                    <p
                      class="text-gray-600 text-sm leading-relaxed text-justify"
                    >
                      L'Associazione non ha fini di lucro. È vietato
                      distribuire, anche in modo indiretto, utili o avanzi di
                      gestione, nonché fondi, riserve o capitale, durante la
                      vita dell'Associazione, salvo che la destinazione o la
                      distribuzione non siano imposti dalla Legge.
                    </p>
                  </div>

                  <!-- Art 4 -->
                  <div
                    class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-all duration-300 md:col-span-2"
                  >
                    <h3 class="text-lg font-bold text-blue-700 mb-3">Art. 4</h3>
                    <p
                      class="text-gray-600 text-sm leading-relaxed text-justify mb-4"
                    >
                      L'Associazione è un'associazione non riconosciuta senza
                      fini di lucro. L'associazione si propone di promuovere e
                      favorire l'aggregazione e la socializzazione degli
                      associati attraverso la valorizzazione, in ogni sua forma,
                      del tempo libero, sviluppando ed arricchendo la loro
                      personalità.
                    </p>
                    <p
                      class="text-gray-600 text-sm leading-relaxed text-justify mb-4"
                    >
                      L'associazione favorisce anche lo scambio di idee e di
                      solidarietà fra i propri iscritti promuovendo iniziative
                      di carattere culturale, sportivo e ricreativo, organizza
                      tutte quelle altre attività che si dimostrino idonee a
                      perseguire in via diretta o indiretta l'oggetto sociale,
                      coordina le attività degli associati.
                    </p>
                    <p
                      class="text-gray-600 text-sm leading-relaxed text-justify mb-3 font-semibold"
                    >
                      A tal fine, l'associazione potrà:
                    </p>
                    <ul
                      class="list-disc pl-5 space-y-2 text-gray-600 text-sm text-justify mb-4 marker:text-blue-500"
                    >
                      <li>
                        promuovere e realizzare iniziative di carattere
                        ricreativo, culturale, artistico, sportivo e turistico
                        atte a dare un contenuto sociale al tempo libero degli
                        associati;
                      </li>
                      <li>
                        favorire e sollecitare iniziative atte ad armonizzare la
                        vita associativa, allo scopo di accrescere le capacità
                        morali, intellettuali, fisiche ed artistiche dei Soci,
                        quelle innovative e quelle di alto contenuto culturale e
                        sociale;
                      </li>
                      <li>
                        organizzare e farsi promotrice di corsi, seminari,
                        studi, convegni, pubblicazioni anche periodiche, nonché
                        esercitare ogni attività ritenuta utile al fine del
                        conseguimento dello scopo associativo, con i soli limiti
                        imposti dalle leggi vigenti;
                      </li>
                      <li>
                        svolgere tutte le attività che riguardano cessioni di
                        beni e prestazioni di servizio, complementari agli scopi
                        sociali e per il raggiungimento degli stessi, attraverso
                        anche stipule contrattuali e quanto altro occorre.
                        Promuovere l'assistenza e la solidarietà fra i soci;
                      </li>
                      <li>
                        promuovere, anche in concorso con Enti pubblici e
                        privati, convegni, manifestazioni e attività di
                        formazione che favoriscano l'Associazionismo;
                      </li>
                      <li>
                        attivare strumenti di sostegno e di servizio per
                        l'Associazionismo e per gli operatori del settore, con
                        particolare riferimento all'assistenza legislativa,
                        legale e fiscale;
                      </li>
                      <li>
                        richiedere e utilizzare, tutti i benefici pubblici
                        previsti per il settore associativo, sia esso sportivo,
                        culturale, turistico e del tempo libero in generale;
                      </li>
                      <li>
                        organizzare e farsi promotrice di corsi, seminari,
                        studi, convegni, pubblicazioni anche periodiche,
                        attività sportive, manifestazioni culturali, di moda,
                        della gastronomia, della cultura, della musica, dello
                        spettacolo, dell'arte, dei mestieri, nonché esercitare
                        ogni attività ritenuta utile al fine del conseguimento
                        dello scopo associativo, nell'interesse generale degli
                        associati e dei cittadini tutti.
                      </li>
                    </ul>
                    <div
                      class="bg-blue-50 p-4 rounded-lg border border-blue-100"
                    >
                      <p
                        class="text-blue-800 text-sm leading-relaxed text-justify"
                      >
                        L'Associazione è affiliata alla FITeL Regionale del
                        Lazio e tramite questa alla FITeL Nazionale. Per
                        raggiungere gli scopi sociali, l'Associazione può
                        aderire ad iniziative promosse da altre Associazioni,
                        Enti, Fondazioni, Federazioni, Circoli Aziendali,
                        sportivi e culturali, che hanno come finalità
                        istituzionale gli stessi scopi sociali della FITeL.
                      </p>
                    </div>
                  </div>
                </div>
              </div>

              <!-- SEZIONE 2: Soci -->
              <div class="statuto-section mb-12">
                <div
                  class="flex items-center gap-4 mb-6 pb-4 border-b border-gray-200"
                >
                  <div
                    class="w-10 h-10 rounded-lg bg-blue-100 flex items-center justify-center text-blue-700 font-bold text-lg flex-shrink-0"
                  >
                    2
                  </div>
                  <h2 class="text-2xl font-bold text-gray-900">Soci</h2>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                  <!-- Art 5 -->
                  <div
                    class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-all duration-300 md:col-span-2"
                  >
                    <h3 class="text-lg font-bold text-blue-700 mb-3">Art. 5</h3>
                    <p
                      class="text-gray-600 text-sm leading-relaxed text-justify mb-3"
                    >
                      Possono essere soci dell'Associazione, tutti i cittadini
                      che condividano le motivazioni e gli scopi
                      dell'Associazione stessa.
                    </p>
                    <p
                      class="text-gray-600 text-sm leading-relaxed text-justify mb-3"
                    >
                      I Soci acquisiscono il diritto ad ottenere il rilascio
                      della tessera ed usufruire dei servizi dell'Associazione
                      con il pagamento della relativa quota sociale. Resta
                      facoltà del Consiglio Direttivo di confermare la loro
                      qualità di soci.
                    </p>
                    <p
                      class="text-gray-600 text-sm leading-relaxed text-justify"
                    >
                      Tutti i soci hanno diritto di voto e possono partecipare
                      alle iniziative dell'Associazione, ricoprire incarichi
                      negli organi deliberanti e di controllo previsti dal
                      presente Statuto, partecipare alle assemblee. Le quote
                      associative sono stabilite di anno in anno dal Consiglio
                      Direttivo nel rispetto delle finalità dell'Associazione.
                    </p>
                  </div>
                </div>
              </div>

              <!-- SEZIONE 3: Diritti e doveri dei Soci -->
              <div class="statuto-section mb-12">
                <div
                  class="flex items-center gap-4 mb-6 pb-4 border-b border-gray-200"
                >
                  <div
                    class="w-10 h-10 rounded-lg bg-blue-100 flex items-center justify-center text-blue-700 font-bold text-lg flex-shrink-0"
                  >
                    3
                  </div>
                  <h2 class="text-2xl font-bold text-gray-900">
                    Diritti e doveri dei Soci
                  </h2>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                  <!-- Art 6 -->
                  <div
                    class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-all duration-300 md:col-span-2"
                  >
                    <h3 class="text-lg font-bold text-blue-700 mb-3">Art. 6</h3>
                    <p
                      class="text-gray-600 text-sm leading-relaxed text-justify mb-3"
                    >
                      L'appartenenza all'Associazione implica per i Soci
                      l'accettazione incondizionata del presente Statuto e delle
                      disposizioni regolamentari emanate dagli organi competenti
                      in attuazione dello stesso. Tutti i Soci, nel rispetto
                      delle norme che disciplinano le singole attività,
                      iniziative o manifestazioni hanno diritto di:
                    </p>
                    <ul class="list-none space-y-3 mb-4 text-justify">
                      <li class="flex items-start gap-3">
                        <span
                          class="font-bold text-blue-600 bg-blue-50 px-2 py-0.5 rounded text-xs mt-0.5"
                          >A</span
                        >
                        <span class="text-gray-600 text-sm"
                          >frequentare i locali e usare le attrezzature messe a
                          disposizione dall'Associazione;</span
                        >
                      </li>
                      <li class="flex items-start gap-3">
                        <span
                          class="font-bold text-blue-600 bg-blue-50 px-2 py-0.5 rounded text-xs mt-0.5"
                          >B</span
                        >
                        <span class="text-gray-600 text-sm"
                          >partecipare a tutte le attività promosse
                          dall'Associazione e beneficiare dei servizi,
                          provvidenze ed agevolazioni da essa assicurati, nel
                          rispetto delle norme e dei regolamenti interni;</span
                        >
                      </li>
                      <li class="flex items-start gap-3">
                        <span
                          class="font-bold text-blue-600 bg-blue-50 px-2 py-0.5 rounded text-xs mt-0.5"
                          >C</span
                        >
                        <span class="text-gray-600 text-sm"
                          >partecipare alle attività di altre Associazioni,
                          Enti, Fondazioni, Federazioni e Circoli Aziendali,
                          sportivi e culturali aderenti alla FITeL, con le quali
                          si sia stabilito un rapporto di reciprocità, alle
                          condizioni stabilite dai singoli Organismi.</span
                        >
                      </li>
                    </ul>
                    <p
                      class="text-gray-600 text-sm leading-relaxed text-justify border-t border-gray-50 pt-3"
                    >
                      Tutti i Soci sono tenuti a comunicare all'Associazione
                      ogni modificazione dei requisiti previsti dal presente
                      Statuto.
                    </p>
                  </div>

                  <!-- Art 7 -->
                  <div
                    class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-all duration-300"
                  >
                    <h3 class="text-lg font-bold text-blue-700 mb-3">Art. 7</h3>
                    <p
                      class="text-gray-600 text-sm leading-relaxed text-justify mb-2"
                    >
                      È esclusa la partecipazione temporanea alla vita
                      associativa. Il socio rimane tale fino a quando lo stesso
                      non recede dall'Associazione o non si verifichi una delle
                      cause che ne prevedono l'esclusione, come stabilito dal
                      successivo art. 9.
                    </p>
                    <p
                      class="text-gray-600 text-sm leading-relaxed text-justify"
                    >
                      Tutti gli associati che abbiano compiuto la maggiore età e
                      sono in regola con i pagamenti hanno diritto di voto in
                      assemblea, per l'approvazione e le modificazioni del
                      presente statuto e dei regolamenti e per la nomina degli
                      Organi direttivi e di controllo dell'Associazione.
                    </p>
                  </div>

                  <!-- Art 8 -->
                  <div
                    class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-all duration-300"
                  >
                    <h3 class="text-lg font-bold text-blue-700 mb-3">Art. 8</h3>
                    <p
                      class="text-gray-600 text-sm leading-relaxed text-justify"
                    >
                      I soci hanno diritto di ricevere all'atto dell'ammissione,
                      la tessera sociale della validità di un anno e sono tenuti
                      al pagamento della quota annuale di associazione,
                      stabilita dal Consiglio Direttivo ed all'osservanza dello
                      statuto e delle deliberazioni prese dagli organi sociali.
                    </p>
                  </div>

                  <!-- Art 9 -->
                  <div
                    class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-all duration-300 md:col-span-2"
                  >
                    <h3 class="text-lg font-bold text-blue-700 mb-3">
                      Art. 9 - Perdita qualifica Socio
                    </h3>
                    <p
                      class="text-gray-600 text-sm leading-relaxed text-justify mb-3 font-semibold"
                    >
                      La qualifica di socio si perde per i seguenti motivi:
                    </p>
                    <ul class="grid grid-cols-1 gap-2 pl-0 mb-4 text-justify">
                      <li class="flex items-start gap-2 text-gray-600 text-sm">
                        <span
                          class="w-1.5 h-1.5 rounded-full bg-red-400 mt-1.5 flex-shrink-0"
                        ></span>per dimissioni;
                      </li>
                      <li class="flex items-start gap-2 text-gray-600 text-sm">
                        <span
                          class="w-1.5 h-1.5 rounded-full bg-red-400 mt-1.5 flex-shrink-0"
                        ></span>quando non ottemperino alle disposizioni del
                        presente statuto, ai regolamenti interni o alle
                        deliberazioni prese dagli organi sociali;
                      </li>
                      <li class="flex items-start gap-2 text-gray-600 text-sm">
                        <span
                          class="w-1.5 h-1.5 rounded-full bg-red-400 mt-1.5 flex-shrink-0"
                        ></span>quando si rendano morosi del pagamento della
                        tessera e delle quote sociali senza giustificato motivo;
                      </li>
                      <li class="flex items-start gap-2 text-gray-600 text-sm">
                        <span
                          class="w-1.5 h-1.5 rounded-full bg-red-400 mt-1.5 flex-shrink-0"
                        ></span>quando, in qualunque modo, arrechino danni
                        morali o materiali all'Associazione.
                      </li>
                    </ul>
                    <div class="bg-red-50 p-4 rounded-lg border border-red-100">
                      <p
                        class="text-red-800 text-sm leading-relaxed text-justify"
                      >
                        Le espulsioni e le radiazioni sono decise dal consiglio
                        direttivo a maggioranza dei suoi membri. I soci radiati
                        per morosità potranno, dietro domanda, essere riammessi,
                        pagando una nuova quota di iscrizione. I soci espulsi o
                        radiati potranno ricorrere contro il provvedimento
                        secondo le modalità di cui all'art. 21 del presente
                        Statuto e del Regolamento interno.
                      </p>
                    </div>
                  </div>
                </div>
              </div>

              <!-- SEZIONE 4: Organi dell'Associazione -->
              <div class="statuto-section mb-12">
                <div
                  class="flex items-center gap-4 mb-6 pb-4 border-b border-gray-200"
                >
                  <div
                    class="w-10 h-10 rounded-lg bg-blue-100 flex items-center justify-center text-blue-700 font-bold text-lg flex-shrink-0"
                  >
                    4
                  </div>
                  <h2 class="text-2xl font-bold text-gray-900">
                    Organi dell'Associazione
                  </h2>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                  <!-- Art 10 -->
                  <div
                    class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-all duration-300"
                  >
                    <h3 class="text-lg font-bold text-blue-700 mb-3">
                      Art. 10 - Organi
                    </h3>
                    <p
                      class="text-gray-600 text-sm leading-relaxed text-justify mb-2 font-semibold"
                    >
                      Gli organi dell'Associazione sono:
                    </p>
                    <ul
                      class="list-disc pl-5 space-y-1 text-gray-600 text-sm marker:text-blue-500"
                    >
                      <li>l'Assemblea dei Soci;</li>
                      <li>il Consiglio Direttivo;</li>
                      <li>Presidente;</li>
                      <li>il Collegio dei Revisori dei Conti;</li>
                      <li>Probiviri</li>
                    </ul>
                  </div>

                  <!-- Art 11 -->
                  <div
                    class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-all duration-300"
                  >
                    <h3 class="text-lg font-bold text-blue-700 mb-3">
                      Art. 11 - Assemblea
                    </h3>
                    <p
                      class="text-gray-600 text-sm leading-relaxed text-justify mb-2"
                    >
                      L'Assemblea dei soci può essere ordinaria o straordinaria.
                    </p>
                    <p
                      class="text-gray-600 text-sm leading-relaxed text-justify"
                    >
                      La comunicazione della convocazione deve essere effettuata
                      con avviso affisso nei locali dell'Associazione almeno
                      quindici giorni prima della riunione e contenere i punti
                      all'ordine del giorno, la data, l'ora ed il luogo
                      dell'assemblea, nonché la data, l'ora ed il luogo
                      dell'eventuale assemblea di seconda convocazione.
                    </p>
                  </div>

                  <!-- Art 12 -->
                  <div
                    class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-all duration-300 md:col-span-2"
                  >
                    <h3 class="text-lg font-bold text-blue-700 mb-3">
                      Art. 12 - Assemblea Ordinaria
                    </h3>
                    <p
                      class="text-gray-600 text-sm leading-relaxed text-justify mb-3"
                    >
                      L'assemblea ordinaria è convocata dal Presidente del
                      Consiglio direttivo almeno una volta l'anno. Essa è
                      presieduta dal Presidente del Consiglio Direttivo, il
                      quale nomina a sua volta fra i soci un segretario
                      verbalizzante.
                    </p>
                    <p
                      class="text-gray-600 text-sm leading-relaxed text-justify mb-4"
                    >
                      Le delibere assembleari, oltre ad essere debitamente
                      trascritte nel libro verbale delle assemblee dei soci,
                      rimangono affisse nei locali dell'associazione durante i
                      quindici giorni che seguono l'assemblea.
                    </p>
                    <p class="text-gray-700 text-sm font-semibold mb-2">
                      Essa approva:
                    </p>
                    <ul
                      class="list-disc pl-5 space-y-1 text-gray-600 text-sm marker:text-blue-500 text-justify"
                    >
                      <li>
                        le linee generali del programma di attività per l'anno
                        sociale;
                      </li>
                      <li>
                        elegge e revoca il Consiglio Direttivo, il Collegio dei
                        Revisori dei Conti;
                      </li>
                      <li>
                        approva il bilancio, il quale, viene esposto nella sede
                        sociale, a disposizione dei soci, almeno quindici giorni
                        prima e dopo la sua approvazione;
                      </li>
                      <li>
                        approva e modifica il Regolamento interno
                        dell'Associazione;
                      </li>
                      <li>
                        delibera su ogni argomento attinente alla gestione ad
                        essa sottoposta dal Consiglio Direttivo e su quant'altro
                        ad essa demandato per legge o per statuto.
                      </li>
                    </ul>
                  </div>

                  <!-- Art 13 -->
                  <div
                    class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-all duration-300 md:col-span-2"
                  >
                    <h3 class="text-lg font-bold text-blue-700 mb-3">
                      Art. 13 - Assemblea Straordinaria
                    </h3>
                    <div class="flex flex-col md:flex-row gap-6 items-start">
                      <div class="flex-1">
                        <p
                          class="text-gray-600 text-sm leading-relaxed text-justify mb-2 font-semibold"
                        >
                          L'Assemblea straordinaria è convocata per deliberare:
                        </p>
                        <ul
                          class="list-disc pl-5 space-y-1 text-gray-600 text-sm marker:text-red-500 mb-4"
                        >
                          <li>sulle modifiche dello statuto;</li>
                          <li>sullo scioglimento dell'Associazione;</li>
                          <li>
                            su ogni altro argomento di carattere straordinario
                            sottoposto alla sua approvazione dal Consiglio
                            Direttivo.
                          </li>
                        </ul>
                      </div>
                      <div
                        class="flex-1 bg-yellow-50 p-4 rounded-lg border border-yellow-100"
                      >
                        <p
                          class="text-gray-700 text-sm leading-relaxed text-justify italic"
                        >
                          "Le delibere assembleari, sia in sede ordinaria che
                          straordinaria, prese in conformità al presente statuto
                          obbligano tutti i soci anche se assenti, dissenzienti
                          o astenuti dal voto."
                        </p>
                      </div>
                    </div>
                  </div>

                  <!-- Art 14 -->
                  <div
                    class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-all duration-300 md:col-span-2"
                  >
                    <h3 class="text-lg font-bold text-blue-700 mb-3">
                      Art. 14 - Validità Assemblee
                    </h3>
                    <div
                      class="space-y-4 text-sm text-gray-600 leading-relaxed text-justify"
                    >
                      <p>
                        In prima convocazione l'Assemblea ordinaria è
                        regolarmente costituita con la presenza di almeno la
                        metà più uno dei soci e delibera validamente a
                        maggioranza assoluta dei presenti, su tutte le questioni
                        poste all'ordine del giorno.
                      </p>
                      <p>
                        In seconda convocazione, l'assemblea ordinaria è
                        regolarmente costituita qualunque sia il numero dei soci
                        intervenuti e delibera validamente a maggioranza dei
                        soci presenti su tutte le questioni poste all'ordine del
                        giorno.
                      </p>
                      <p>
                        La seconda convocazione, sia essa per l'assemblea
                        ordinaria, sia per quella straordinaria non può avere
                        luogo se non sono trascorse almeno tre ore dopo l'orario
                        previsto dalla prima convocazione.
                      </p>
                      <p>
                        L'assemblea straordinaria si costituisce validamente
                        quando intervengono in prima convocazione 2/3 dei soci,
                        in seconda convocazione la metà più uno e in terza
                        convocazione qualunque sia il numero dei soci
                        intervenuti; essa delibera a maggioranza dei soci
                        presenti.
                      </p>
                    </div>
                  </div>

                  <!-- Art 15 -->
                  <div
                    class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-all duration-300"
                  >
                    <h3 class="text-lg font-bold text-blue-700 mb-3">
                      Art. 15 - Votazioni
                    </h3>
                    <p
                      class="text-gray-600 text-sm leading-relaxed text-justify"
                    >
                      Le votazioni possono avvenire per alzata di mano o a
                      scrutinio segreto, quando ne faccia richiesta almeno un
                      decimo dei presenti. Per l'elezione del consiglio
                      dell'associazione, la votazione avviene a scrutinio
                      segreto. Ai fini della elezione del consiglio
                      dell'associazione il voto viene attribuito alla lista
                      ovvero i soci possono esprimere la loro preferenza in
                      favore di una delle liste presentate. In assenza di liste,
                      è possibile esprimere la preferenza di voto
                      nominativamente dando la preferenza ad uno dei soci.
                    </p>
                  </div>

                  <!-- Art 16 -->
                  <div
                    class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-all duration-300"
                  >
                    <h3 class="text-lg font-bold text-blue-700 mb-3">
                      Art. 16 - Consiglio Direttivo
                    </h3>
                    <p
                      class="text-gray-600 text-sm leading-relaxed text-justify"
                    >
                      Il Consiglio Direttivo è composto da un minimo di tre ad
                      un massimo di quattordici Consiglieri, eletti
                      dall'assemblea ordinaria fra i soci e resta in carica per
                      tre anni. I membri del consiglio sono rieleggibili. Nella
                      sua prima seduta il Consiglio Direttivo elegge, fra i suoi
                      membri, il Presidente, il Vice Presidente.
                    </p>
                  </div>

                  <!-- Art 17 -->
                  <div
                    class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-all duration-300"
                  >
                    <h3 class="text-lg font-bold text-blue-700 mb-3">
                      Art. 17 - Riunioni CD
                    </h3>
                    <p
                      class="text-gray-600 text-sm leading-relaxed text-justify"
                    >
                      Il Consiglio Direttivo si riunisce ogni qual volta il
                      Presidente o la maggioranza dei propri componenti lo
                      ritengano necessario ed è presieduto dal Presidente o, in
                      sua assenza, dal Vice Presidente. Le riunioni sono valide
                      con la presenza di almeno la metà dei componenti. Le
                      deliberazioni si adottano a maggioranza semplice.
                    </p>
                  </div>

                  <!-- Art 18 (Compiti CD) -->
                  <div
                    class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-all duration-300 md:col-span-2"
                  >
                    <h3 class="text-lg font-bold text-blue-700 mb-3">
                      Art. 18 - Compiti Consiglio Direttivo
                    </h3>
                    <ul
                      class="list-disc pl-5 space-y-2 text-gray-600 text-sm marker:text-blue-500 text-justify"
                    >
                      <li>
                        redige i programmi di attività sociale previsti dallo
                        statuto sulla base delle linee approvate dall'assemblea
                        dei soci;
                      </li>
                      <li>
                        cura l'esecuzione delle deliberazioni dell'assemblea;
                      </li>
                      <li>
                        redige i bilanci da sottoporre al Collegio dei Revisori
                        dei Conti e quindi all'approvazione all'assemblea dei
                        soci;
                      </li>
                      <li>
                        stipula tutti gli atti e i contratti di ogni genere
                        inerenti l'attività sociale;
                      </li>
                      <li>
                        delibera circa l'ammissione, la sospensione, la
                        radiazione e l'espulsione dei soci;
                      </li>
                      <li>
                        determina l'ammontare delle quote annue associative e le
                        modalità di versamento;
                      </li>
                      <li>
                        delibera su ogni altra questione riguardante l'attività
                        dell'Associazione per l'attuazione delle sue finalità
                        secondo le direttive dell'assemblea, assumendo tutte le
                        iniziative necessarie;
                      </li>
                      <li>
                        delibera sugli assetti organizzativi interni al
                        Consiglio Direttivo in rapporto alle esigenze di
                        funzionalità della Associazione.
                      </li>
                    </ul>
                  </div>

                  <!-- Art 19 -->
                  <div
                    class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-all duration-300"
                  >
                    <h3 class="text-lg font-bold text-blue-700 mb-3">
                      Art. 19 - Presidente
                    </h3>
                    <p
                      class="text-gray-600 text-sm leading-relaxed text-justify"
                    >
                      Al Presidente del Consiglio Direttivo compete la legale
                      rappresentanza dell'Associazione. Egli presiede e convoca
                      l'assemblea ordinaria, straordinaria e il Consiglio
                      Direttivo. In caso di sua assenza o di impedimento, tutte
                      le mansioni spettano al Vice Presidente.
                    </p>
                  </div>

                  <!-- Art 20 -->
                  <div
                    class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-all duration-300"
                  >
                    <h3 class="text-lg font-bold text-blue-700 mb-3">
                      Art. 20 - Revisori dei Conti
                    </h3>
                    <p
                      class="text-gray-600 text-sm leading-relaxed text-justify mb-2"
                    >
                      La gestione dell'Associazione è controllata da un Collegio
                      di Revisori dei Conti, composto da due membri effettivi e
                      un supplente eletti dall'assemblea, fra i soci
                      maggiorenni.
                    </p>
                    <p
                      class="text-gray-600 text-sm leading-relaxed text-justify font-semibold mb-2"
                    >
                      I Revisori devono:
                    </p>
                    <ul
                      class="list-disc pl-5 text-gray-600 text-sm marker:text-blue-500 mb-2"
                    >
                      <li>vigilare sull'amministrazione dell'Associazione;</li>
                      <li>
                        redigere ed approvare una relazione al bilancio annuale.
                      </li>
                    </ul>
                    <p
                      class="text-gray-600 text-sm leading-relaxed text-justify"
                    >
                      Il Collegio dei Revisori dei Conti dura in carica tre anni
                      ed i suoi membri sono rieleggibili.
                    </p>
                  </div>

                  <!-- Art 21 -->
                  <div
                    class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-all duration-300"
                  >
                    <h3 class="text-lg font-bold text-blue-700 mb-3">
                      Art. 21 - Probiviri
                    </h3>
                    <p
                      class="text-gray-600 text-sm leading-relaxed text-justify mb-2"
                    >
                      Il Collegio dei probiviri decide in via definitiva sui
                      ricorsi in materia di sanzioni a carico dei soci nei casi
                      e con le modalità di cui all'articolo 22.
                    </p>
                    <p
                      class="text-gray-600 text-sm leading-relaxed text-justify mb-2"
                    >
                      Esso è composto da tre membri eletti dall'assemblea.
                      Qualora nella composizione del Collegio si verificassero
                      vacanze, le sostituzioni avverranno con il subentro
                      automatico di coloro che alle elezioni hanno riportato il
                      maggior numero dei voti.
                    </p>
                    <p
                      class="text-gray-600 text-sm leading-relaxed text-justify"
                    >
                      Il Collegio dei Probiviri elegge nel proprio seno il
                      Presidente.
                    </p>
                  </div>

                  <!-- Art 22 -->
                  <div
                    class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-all duration-300"
                  >
                    <h3 class="text-lg font-bold text-blue-700 mb-3">
                      Art. 22 - Sanzioni
                    </h3>
                    <p
                      class="text-gray-600 text-sm leading-relaxed text-justify mb-2"
                    >
                      In caso di violazione da parte dei soci delle norme
                      sancite dal presente Statuto e dai regolamenti interni,
                      nonché di inosservanza delle comuni regole di educazione,
                      il Consiglio direttivo potrà applicare le seguenti
                      sanzioni:
                    </p>
                    <ul
                      class="list-disc pl-5 space-y-1 text-gray-600 mb-4 text-justify text-sm"
                    >
                      <li><strong>a)</strong> richiamo;</li>
                      <li>
                        <strong>b)</strong> sospensione dalle attività per un periodo
                        non superiore a sei mesi;
                      </li>
                      <li>
                        <strong>c)</strong> esclusione definitiva da socio dell'Associazione.
                      </li>
                    </ul>
                    <div class="bg-red-50 p-3 rounded-lg border border-red-100">
                      <p class="text-red-800 text-xs text-justify">
                        Contro le sanzioni di cui al comma 1 l'interessato può,
                        entro quindici giorni dalla data di notificazione del
                        provvedimento, fare ricorso al Collegio dei probiviri
                        che è tenuto a pronunciarsi entro trenta giorni dalla
                        ricezione del ricorso.
                      </p>
                    </div>
                  </div>
                </div>
              </div>

              <!-- SEZIONE 5: Patrimonio -->
              <div class="statuto-section mb-12">
                <div
                  class="flex items-center gap-4 mb-6 pb-4 border-b border-gray-200"
                >
                  <div
                    class="w-10 h-10 rounded-lg bg-blue-100 flex items-center justify-center text-blue-700 font-bold text-lg flex-shrink-0"
                  >
                    5
                  </div>
                  <h2 class="text-2xl font-bold text-gray-900">
                    Patrimonio dell'Associazione
                  </h2>
